---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="en" pageId="404" title="Page Not Found | 404" description="The page you are looking for does not exist." noindex={true}>
  <script is:inline>
    const path = window.location.pathname;
    const match = path.match(/^\/([^\/]+)/);
    if (match) {
      const lang = match[1];
      if (lang !== 'en' && lang !== 'ar' && lang !== 'admin') {
        window.location.replace('/ar/');
      }
    }
  </script>
  <div class="min-h-screen flex flex-col justify-center bg-primary-bg relative overflow-hidden">
    <!-- Atmospheric glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_40%,rgba(37,99,235,0.04),transparent_70%)] pointer-events-none z-0"></div>
    
    <div class="flex items-center justify-center relative z-10 py-20 px-6">
      <div class="max-w-md w-full text-center space-y-6 bg-white/65 backdrop-blur-md p-10 rounded-3xl border border-slate-100 shadow-xl">
        <div class="w-20 h-20 bg-blue-600/10 text-blue-600 rounded-full flex items-center justify-center mx-auto border border-blue-600/20">
          <i class="fa-solid fa-compass-drafting text-3xl"></i>
        </div>
        <div class="space-y-2">
          <h1 class="text-6xl font-extrabold text-text-main font-serif">404</h1>
          <h2 class="text-xl font-bold text-text-main">Page Not Found / الصفحة غير موجودة</h2>
          <p class="text-text-main/60 text-xs sm:text-sm leading-relaxed font-sans">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
          <a href="/en/" class="h-11 px-6 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs tracking-wider flex items-center justify-center transition-all duration-200 active:scale-95 shadow-md">
            Go to English Home
          </a>
          <a href="/ar/" class="h-11 px-6 rounded-full bg-transparent border border-blue-600 text-blue-600 font-semibold text-xs tracking-wider flex items-center justify-center transition-all duration-200 hover:bg-blue-600/5 active:scale-95">
            الذهاب للرئيسية بالعربية
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
