---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
---

<Layout lang="en" pageId="404" title="Page Not Found | 404" description="The page you are looking for does not exist." noindex={true}>
  <script is:inline>
    const path = window.location.pathname;
    const match = path.match(/^\/([^\/]+)/);
    if (match) {
      const lang = match[1];
      if (lang !== 'en' && lang !== 'admin') {
        window.location.replace('/');
      }
    }
  </script>
  <div class="min-h-[85vh] flex flex-col justify-center items-center bg-primary-bg relative overflow-hidden px-4 py-16">
    <!-- Atmospheric glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_40%,rgba(37,99,235,0.06),transparent_70%)] pointer-events-none z-0"></div>
    
    <div class="w-full max-w-lg relative z-10 mx-auto">
      <div class="text-center space-y-6 bg-bg-card/90 backdrop-blur-md p-8 sm:p-10 rounded-3xl border border-border-subtle shadow-xl">
        <div class="w-20 h-20 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto border border-primary/20">
          <Icon name="gears" class="w-8 h-8 text-accent-primary" />
        </div>
        <div class="space-y-3">
          <h1 class="text-6xl font-extrabold text-text-main tracking-tight">404</h1>
          <h2 class="text-lg sm:text-xl font-bold text-text-main">Page Not Found / الصفحة غير موجودة</h2>
          <p class="text-text-main/70 text-xs sm:text-sm leading-relaxed font-sans max-w-sm mx-auto">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
          <a href="/en/" class="h-11 px-6 rounded-full bg-primary hover:bg-accent-highlight text-white font-semibold text-xs tracking-wider flex items-center justify-center transition-all duration-200 active:scale-95 shadow-md">
            Go to English Home
          </a>
          <a href="/" class="h-11 px-6 rounded-full bg-transparent border border-primary text-primary font-semibold text-xs tracking-wider flex items-center justify-center transition-all duration-200 hover:bg-primary/5 active:scale-95">
            الذهاب للرئيسية بالعربية
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
