---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation.astro';
import Footer from '../../components/ui/Footer.astro';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (!lang || !['en', 'ar'].includes(lang)) {
  return Astro.redirect('/en/');
}

const isAr = lang === 'ar';
---

<Layout lang={lang} pageId="methodology">
  <Navigation lang={lang} activePage="methodology" />
  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow flex flex-col justify-center">
    <div class="space-y-6">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-text-main font-serif">
        {isAr ? "منهجية العمل" : "Work Methodology"}
      </h1>
      <p class="text-lg text-text-main/70 max-w-xl font-sans">
        {isAr ? "استراتيجيات التسويق والتحليلات التي تسفر عن نتائج حقيقية." : "Marketing and analytical workflows designed to deliver clear commercial outcomes."}
      </p>
      
      <!-- Methodology Columns -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
        <div class="glass-card rounded-2xl p-6 shadow-md shadow-text-main/2 font-sans">
          <h2 class="text-xl font-bold text-text-main mb-3 font-serif">
            {isAr ? "1. قياس وتتبع البيانات" : "1. Data Measurement"}
          </h2>
          <p class="text-text-main/70 text-sm leading-relaxed">
            {isAr ? "تنفيذ تتبع متقدم للتحويلات وسلوك المستهلك باستخدام GA4 ومحلل الأحداث المخصص لقياس الأداء بدقة." : "Deploy custom event tags and funnel instrumentation using Google Analytics (GA4) to map raw behaviors to commercial actions."}
          </p>
        </div>
        
        <div class="glass-card rounded-2xl p-6 shadow-md shadow-text-main/2 font-sans">
          <h2 class="text-xl font-bold text-text-main mb-3 font-serif">
            {isAr ? "2. استراتيجية الإعلانات المحسنة" : "2. Optimized Acquisition"}
          </h2>
          <p class="text-text-main/70 text-sm leading-relaxed">
            {isAr ? "صياغة وتعديل الحملات الإعلانية المدفوعة على منصات Meta و Google بناءً على البيانات الفعلية لضمان أفضل عائد مالي." : "Refining ad budget allocation across platforms using concrete statistical feedback loops to capture high-intent users."}
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>

