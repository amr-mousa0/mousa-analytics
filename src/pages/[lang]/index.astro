---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (!['en', 'ar'].includes(lang || '')) {
  return Astro.redirect('/en/');
}

// Defensive Content Rendering: Fetch services and socials safely
let services: any[] = [];
let socials: any[] = [];

try {
  const allServices = await getCollection('services');
  services = allServices
    .filter(item => item.slug.startsWith(`${lang}/`))
    .sort((a, b) => (a.data.priority || 0) - (b.data.priority || 0));
} catch (error) {
  console.warn(`[Defensive Rendering] Services fetching failed for ${lang}. Using empty list.`, error);
}

try {
  const allSocials = await getCollection('socials');
  socials = allSocials
    .filter(item => item.slug.startsWith(`${lang}/`))
    .sort((a, b) => (a.data.priority || 0) - (b.data.priority || 0));
} catch (error) {
  console.warn(`[Defensive Rendering] Socials fetching failed for ${lang}. Using empty list.`, error);
}

const isAr = lang === 'ar';
---

<Layout lang={lang} pageId="homepage">
  <main class="max-w-4xl mx-auto px-6 py-12 flex-grow flex flex-col justify-center">
    <div class="space-y-6">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
        {isAr ? "أهلاً بك" : "Welcome"}
      </h1>
      <p class="text-lg text-neutral-400 max-w-xl">
        {isAr ? "جاري بناء موقع معرض الأعمال الجديد استناداً إلى المعايير الحديثة." : "Scaffolding the new Astro-native portfolio system with strict performance limits."}
      </p>
      
      <!-- Services Scaffolding -->
      {services.length > 0 && (
        <div class="pt-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">
            {isAr ? "الخدمات" : "Services"}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {services.map(service => (
              <div class="p-6 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-neutral-700 transition-colors">
                <h3 class="text-xl font-bold text-white mb-2">{service.data.title}</h3>
                <p class="text-neutral-400 text-sm mb-4">{service.data.description}</p>
                <ul class="space-y-1 text-xs text-neutral-500">
                  {service.data.features.map((feature: string) => (
                    <li>• {feature}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Socials Footer Scaffolding -->
      {socials.length > 0 && (
        <div class="pt-12 border-t border-neutral-900 flex gap-4">
          {socials.map(social => (
            <a href={social.data.url} target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-white transition-colors">
              <i class={social.data.icon}></i> {social.data.name}
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>
