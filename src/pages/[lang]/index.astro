---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation.astro';
import Hero from '../../components/sections/Hero.astro';
import Services from '../../components/sections/Services.astro';
import Projects from '../../components/sections/Projects.astro';
import Footer from '../../components/ui/Footer.astro';

import { getImage } from 'astro:assets';
import analyticsBgImgDesktop from '../../assets/images/analyst-side-bg-desktop.png';
import analyticsBgImgMobile from '../../assets/images/analyst-side-bg-mobile.png';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (!lang || !['en', 'ar'].includes(lang)) {
  return Astro.redirect('/ar/');
}

const isAr = lang === 'ar';

// Pre-optimize hero images at build time for preloading
const desktopImg = await getImage({ src: analyticsBgImgDesktop, quality: 85, format: 'webp' });
const mobileImg = await getImage({ src: analyticsBgImgMobile, quality: 80, format: 'webp' });
---

<Layout lang={lang} pageId="homepage" preloadImageMobile={mobileImg.src} preloadImageDesktop={desktopImg.src}>
  <!-- Inject Schema.org JSON-LD Metadata -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": `${Astro.site}${lang}/#organization`,
        "name": isAr ? "موسى للتحليلات" : "Mousa Analytics",
        "url": `${Astro.site}${lang}/`,
        "logo": `${Astro.site}favicon.svg`,
        "image": `${Astro.site}images/og-image.png`,
        "description": isAr 
          ? "موسى للتحليلات: خيارك الأفضل لخدمات تحليل البيانات والميديا باينج لتضاعف أرباح مشروعك."
          : "Mousa Analytics: Your premier choice for data analytics and media buying services to scale your business.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cairo",
          "addressCountry": "EG"
        },
        "telephone": "+201099661462",
        "priceRange": "$$$"
      },
      {
        "@type": "WebSite",
        "@id": `${Astro.site}${lang}/#website`,
        "url": `${Astro.site}${lang}/`,
        "name": isAr ? "موسى للتحليلات" : "Mousa Analytics",
        "publisher": {
          "@id": `${Astro.site}${lang}/#organization`
        }
      }
    ]
  })} />

  <Navigation lang={lang} activePage="home" />
  <main class="flex-grow">
    <Hero lang={lang} desktopImg={desktopImg} mobileImg={mobileImg} />
    <Services lang={lang} />
    <Projects lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
