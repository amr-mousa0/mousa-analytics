---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation.astro';
import Footer from '../../components/ui/Footer.astro';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (!lang || !['en', 'ar'].includes(lang)) {
  return Astro.redirect('/en/');
}

const isAr = lang === 'ar';
---

<Layout lang={lang} pageId="about">
  <Navigation lang={lang} activePage="about" />

  <!-- Inject Schema.org JSON-LD Metadata -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `https://amrmousa.com/${lang}/#person`,
        "name": isAr ? "عمرو موسى" : "Amr Mousa",
        "jobTitle": isAr ? "محلل بيانات وتسويق" : "Data & Marketing Analyst",
        "knowsAbout": ["SQL", "Python", "Power BI", "Excel", "Performance Marketing", "Conversion Rate Optimization"],
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "National Telecommunication Institute (NTI)"
          },
          {
            "@type": "EducationalOrganization",
            "name": "Digital Egypt Pioneers Initiative (DEPI)"
          }
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "So Care"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cairo",
          "addressCountry": "EG"
        }
      },
      {
        "@type": "ProfilePage",
        "@id": `https://amrmousa.com/${lang}/about/`,
        "mainEntity": {
          "@id": `https://amrmousa.com/${lang}/#person`
        }
      }
    ]
  })} />

  <main class="flex-grow pt-24 md:pt-32 pb-20 relative overflow-hidden bg-transparent">
    <!-- Atmospheric Ambient Glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_80%_20%,oklch(75%_0.12_255_/_0.06),transparent_70%)] pointer-events-none z-0" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_50%_at_20%_80%,oklch(75%_0.12_255_/_0.04),transparent_60%)] pointer-events-none z-0" aria-hidden="true"></div>

    <article class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 space-y-24">
      
      <!-- Section 1: The Pitch (Q&A Interview) -->
      <section class="grid grid-cols-1 lg:grid-cols-[35%_65%] gap-12 lg:gap-20 items-start">
        <aside class="space-y-4">
          <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
            {isAr ? "من أنا" : "THE PITCH"}
          </span>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-serif text-text-main leading-tight">
            {isAr ? (
              <>
                التعريف بالخبرة <span class="text-hero-ice-blue italic font-medium">المهنية</span>
              </>
            ) : (
              <>
                The Professional <span class="text-hero-ice-blue italic font-medium">Interview</span>
              </>
            )}
          </h1>
          <p class="text-sm text-text-main/60 font-sans leading-relaxed max-w-sm">
            {isAr 
              ? "حوار موجز يستكشف فلسفتي في العمل والربط بين الأرقام والسلوك الإنساني." 
              : "A candid conversation exploring the mindset behind analytical models and human behavior."}
          </p>
        </aside>

        <!-- Q&A Stack -->
        <div class="space-y-6">
          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-start leading-snug">
              <span class="text-hero-ice-blue italic">{isAr ? "س:" : "Q:"}</span>
              <span>{isAr ? "كيف تقود إلى اتخاذ قرارات أكثر ذكاءً؟" : "How do you drive smarter decisions?"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-7">
              {isAr 
                ? "أقوم بتحويل البيانات المعقدة إلى رؤى واضحة وقابلة للتنفيذ، مما يساعد العلامات التجارية على التركيز على ما ينجح واستبعاد الفوضى إعلانية كانت أو تقنية." 
                : "I translate complex data into clear, actionable insights, helping brands focus on what actually works and cut out unnecessary ad-budget noise."}
            </p>
          </div>

          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-start leading-snug">
              <span class="text-hero-ice-blue italic">{isAr ? "س:" : "Q:"}</span>
              <span>{isAr ? "لماذا تربط بين البيانات والتسويق؟" : "Why bridge data and marketing?"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-7">
              {isAr 
                ? "بدأت رحلتي في التحليلات وتطورت بشكل طبيعي إلى اهتمام عميق بالسلوك البشري - لفهم ليس فقط 'ماذا' تعني البيانات، ولكن 'لماذا' وراء كل نقرة وتفاعل." 
                : "My journey began in analytics and naturally evolved into a deep interest in human behavior—understanding not just the 'what' of numbers, but the 'why' behind every interaction."}
            </p>
          </div>

          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-start leading-snug">
              <span class="text-hero-ice-blue italic">{isAr ? "س:" : "Q:"}</span>
              <span>{isAr ? "ما هي ميزتك الاستراتيجية؟" : "What is your strategic edge?"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-7">
              {isAr 
                ? "أقوم بسد الفجوة بين الأداء التقني ورحلة العميل، وتحويل الأنماط والتحويلات إلى استراتيجية متماسكة. أعتقد أن الحلول الأكثر فعالية تظهر عند تقاطع البيانات، الاستراتيجية، والفهم الإنساني." 
                : "I bridge the gap between technical performance and the human journey, turning raw patterns into a cohesive conversion strategy. The most powerful solutions emerge at the intersection of data, strategy, and human understanding."}
            </p>
          </div>

          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-start leading-snug">
              <span class="text-hero-ice-blue italic">{isAr ? "س:" : "Q:"}</span>
              <span>{isAr ? "كيف تتعامل مع التعقيد؟" : "How do you handle complexity?"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-7">
              {isAr 
                ? "عندما أواجه التعقيد، أركز على إيجاد الاتجاه من خلال الهيكل، والأنماط، والرؤى الهادفة." 
                : "When faced with complexity, I focus on finding clear direction through structure, patterns, and purposeful analytics."}
            </p>
          </div>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 2: Core Capabilities (Horizontal Scroll on Mobile) -->
      <section class="space-y-8">
        <div class="flex items-center justify-between">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "القدرات الفنية" : "CORE CAPABILITIES"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "التحليل الفني والنمذجة" : "Analytical & Technical Stack"}
            </h2>
          </div>
          <!-- Swipe Indicator (Mobile Only) -->
          <div class="md:hidden flex items-center gap-1.5 text-[10px] font-bold text-text-main/40 uppercase font-sans tracking-widest">
            <span>{isAr ? "اسحب لليمين" : "Swipe"}</span>
            <i class={`fa-solid ${isAr ? 'fa-arrow-left' : 'fa-arrow-right'} text-[8px] animate-pulse`}></i>
          </div>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 no-scrollbar pb-4 md:pb-0 md:grid md:grid-cols-2 lg:grid-cols-4 md:overflow-x-visible">
          <!-- Card 1: SQL -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-hero-ice-blue/5 flex items-center justify-center text-hero-ice-blue font-bold text-sm">
                SQL
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "قواعد البيانات العلاقاتية" : "Relational Database Design"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "تصميم الاستعلامات المعقدة وتنظيف البيانات وضمان سلامة تدفق الهياكل البرمجية." 
                  : "Writing highly optimized queries, analytical aggregates, and structuring schema models for reporting."}
              </p>
            </div>
          </div>

          <!-- Card 2: Python -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-hero-ice-blue/5 flex items-center justify-center text-hero-ice-blue font-bold text-sm">
                PY
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "معالجة البيانات وأتمتتها" : "Wrangling & Script Automation"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "استخدام Pandas/Numpy لتنظيف البيانات وهيكلتها وأتمتة المهام المكررة بكفاءة." 
                  : "Applying Pandas, NumPy, and scripting methods to ingest, clean, and automate business data tasks."}
              </p>
            </div>
          </div>

          <!-- Card 3: Excel -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-hero-ice-blue/5 flex items-center justify-center text-hero-ice-blue font-bold text-sm">
                XLS
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "النمذجة الرياضية المعقدة" : "Advanced Business Modeling"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "بناء معادلات متقدمة، النماذج المالية والتحليلية وأتمتة الجداول البرمجية عبر VBA." 
                  : "Constructing advanced formulas, analytics, and business logic using VBA and structured spreadsheets."}
              </p>
            </div>
          </div>

          <!-- Card 4: Power BI -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-hero-ice-blue/5 flex items-center justify-center text-hero-ice-blue font-bold text-sm">
                PBI
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "لوحات البيانات التفاعلية" : "Interactive Dashboard Design"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "بناء نمذجة Star Schema المتقدمة وكتابة مقاييس DAX التفاعلية لوضوح اتخاذ القرار." 
                  : "Engineering Star Schema database models and writing custom DAX measures for executive reporting."}
              </p>
            </div>
          </div>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 3: Experience Timeline (Horizontal Scroll on Mobile) -->
      <section class="space-y-8">
        <div class="flex items-center justify-between">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "الخبرة العملية" : "PROFESSIONAL HISTORY"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "رحلة البناء والتعلم" : "Experience & Internships"}
            </h2>
          </div>
          <!-- Swipe Indicator (Mobile Only) -->
          <div class="md:hidden flex items-center gap-1.5 text-[10px] font-bold text-text-main/40 uppercase font-sans tracking-widest">
            <span>{isAr ? "اسحب لليمين" : "Swipe"}</span>
            <i class={`fa-solid ${isAr ? 'fa-arrow-left' : 'fa-arrow-right'} text-[8px] animate-pulse`}></i>
          </div>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 no-scrollbar pb-4 md:pb-0 md:grid md:grid-cols-1 lg:grid-cols-3 md:overflow-x-visible">
          <!-- Experience Card 1: NTI -->
          <div class="premium-card-global w-[85%] sm:w-[70%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[300px]">
            <div class="space-y-4 font-sans">
              <div class="flex items-start justify-between gap-3 border-b border-text-main/5 pb-3">
                <div class="space-y-1">
                  <h3 class="text-base font-bold text-text-main font-serif">
                    {isAr ? "محلل بيانات متدرب" : "Intern Data Analyst"}
                  </h3>
                  <p class="text-xs text-hero-ice-blue font-medium">
                    {isAr ? "المعهد القومي للاتصالات (NTI)" : "National Telecommunication Institute (NTI)"}
                  </p>
                </div>
                <span class="text-[9px] font-extrabold uppercase tracking-widest text-text-main/40 whitespace-nowrap bg-text-main/3 px-2.5 py-1.5 rounded-lg">
                  {isAr ? "2026 - الحاضر" : "Feb 2026 - Present"}
                </span>
              </div>
              <ul class="space-y-2.5 text-xs text-text-main/75 list-disc ps-4 font-light leading-relaxed">
                {isAr ? (
                  <>
                    <li>تدريب تقني مكثف وعملي بمجموع 120 ساعة في تحليل البيانات.</li>
                    <li>بناء أكثر من 3 مشاريع تحليلية تحاكي متطلبات ومنطق الأعمال الحقيقية.</li>
                    <li>تطبيق أدوات SQL لتصميم القواعد، وPython للمعالجة، ولوحات تفاعلية بـ Power BI.</li>
                    <li>عرض ومناقشة تقارير البيانات الفنية أمام لجنة تقييم من الخبراء والصناعيين.</li>
                  </>
                ) : (
                  <>
                    <li>Participated in a 120-hour intensive hands-on data analytics program.</li>
                    <li>Engineered 3+ standalone analytical projects solving concrete business logic.</li>
                    <li>Applied SQL database models, Python wrangling, and Power BI interactive dashboards.</li>
                    <li>Presented final analytical findings and methodologies to a panel of senior industry experts.</li>
                  </>
                )}
              </ul>
            </div>
          </div>

          <!-- Experience Card 2: So Care -->
          <div class="premium-card-global w-[85%] sm:w-[70%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[300px]">
            <div class="space-y-4 font-sans">
              <div class="flex items-start justify-between gap-3 border-b border-text-main/5 pb-3">
                <div class="space-y-1">
                  <h3 class="text-base font-bold text-text-main font-serif">
                    {isAr ? "مشتري إعلانات ومطور محتوى" : "Media Buyer & Content Developer"}
                  </h3>
                  <p class="text-xs text-hero-ice-blue font-medium">
                    {isAr ? "So Care" : "So Care"}
                  </p>
                </div>
                <span class="text-[9px] font-extrabold uppercase tracking-widest text-text-main/40 whitespace-nowrap bg-text-main/3 px-2.5 py-1.5 rounded-lg">
                  {isAr ? "2026 - الحاضر" : "Jan 2026 - Present"}
                </span>
              </div>
              <ul class="space-y-2.5 text-xs text-text-main/75 list-disc ps-4 font-light leading-relaxed">
                {isAr ? (
                  <>
                    <li>تحقيق زيادة 250% في العوائد والمبيعات عبر إعلانات الأداء المدفوعة والموجهة.</li>
                    <li>تصميم أكثر من 30 قالباً وصياغة استراتيجيات محتوى مخصصة للتحويل الإعلاني.</li>
                    <li>الربط المستمر بين عمليات شراء الإعلانات والتنفيذ الإبداعي للمحتوى لسد ثغرات الشراء.</li>
                    <li>المشاركة في إطلاق حملة تسويقية واسعة النطاق لموقع المتجر وتكلفة اكتساب العملاء.</li>
                  </>
                ) : (
                  <>
                    <li>Drove +250% store revenue growth through targeted performance marketing campaigns.</li>
                    <li>Designed 30+ custom conversion ad templates and creative media assets.</li>
                    <li>Bridged digital media buying parameters directly with creative execution to plug funnel leaks.</li>
                    <li>Collaborated on launching a major marketing and product campaign, optimizing customer acquisition costs.</li>
                  </>
                )}
              </ul>
            </div>
          </div>

          <!-- Experience Card 3: DEPI -->
          <div class="premium-card-global w-[85%] sm:w-[70%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[300px]">
            <div class="space-y-4 font-sans">
              <div class="flex items-start justify-between gap-3 border-b border-text-main/5 pb-3">
                <div class="space-y-1">
                  <h3 class="text-base font-bold text-text-main font-serif">
                    {isAr ? "متدرب تسويق رقمي" : "Digital Marketing Intern"}
                  </h3>
                  <p class="text-xs text-hero-ice-blue font-medium">
                    {isAr ? "مبادرة رواد مصر الرقمية (DEPI)" : "Digital Egypt Pioneers Initiative (DEPI)"}
                  </p>
                </div>
                <span class="text-[9px] font-extrabold uppercase tracking-widest text-text-main/40 whitespace-nowrap bg-text-main/3 px-2.5 py-1.5 rounded-lg">
                  {isAr ? "2025" : "Jul 2025 - Dec 2025"}
                </span>
              </div>
              <ul class="space-y-2.5 text-xs text-text-main/75 list-disc ps-4 font-light leading-relaxed">
                {isAr ? (
                  <>
                    <li>إتمام برنامج تدريبي شامل ومكثف بمجموع 400 ساعة دراسية وتطبيقية.</li>
                    <li>إعداد وتصميم خطط تسويق استراتيجية متكاملة للعملاء بناءً على نموذج SOSTAC®.</li>
                    <li>إطلاق وتعديل حملات شراء إعلانية مدفوعة عبر منصات Meta و TikTok و LinkedIn.</li>
                    <li>تطبيق ممارسات تهيئة محركات البحث (SEO) لقطاع التكنولوجيا والأجهزة لضمان الترتيب.</li>
                  </>
                ) : (
                  <>
                    <li>Completed a 400-hour intensive professional digital marketing curriculum.</li>
                    <li>Developed comprehensive SOSTAC® marketing strategic frameworks.</li>
                    <li>Managed paid advertising buys on Meta, TikTok, and LinkedIn systems.</li>
                    <li>Applied search engine optimization (SEO) audit workflows for technology and hardware brands.</li>
                  </>
                )}
              </ul>
            </div>
          </div>
        </div>
      </section>

    </article>
  </main>

  <Footer lang={lang} />
</Layout>
