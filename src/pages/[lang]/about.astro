---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation.astro';
import Footer from '../../components/ui/Footer.astro';
import { Image } from 'astro:assets';
import profileImg from '../../assets/images/amr-mousa.webp';




// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (!lang || !['en', 'ar'].includes(lang)) {
  return Astro.redirect('/ar/');
}

const isAr = lang === 'ar';
---

<Layout lang={lang} pageId="about">
  <Navigation lang={lang} activePage="about" />

  <!-- Inject Schema.org JSON-LD Metadata -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `https://mousa-analytics.vercel.app/${lang}/#person`,
        "name": isAr ? "عمرو موسى" : "Amr Mousa",
        "jobTitle": isAr ? "محلل بيانات وتسويق" : "Data & Marketing Analyst",
        "knowsAbout": ["SQL", "Python", "Power BI", "Excel", "Performance Marketing", "Conversion Rate Optimization"],
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "National Telecommunication Institute (NTI)"
          },
          {
            "@type": "EducationalOrganization",
            "name": "Digital Egypt Pioneers Initiative (DEPI)"
          }
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "So Care"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cairo",
          "addressCountry": "EG"
        }
      },
      {
        "@type": "ProfilePage",
        "@id": `https://mousa-analytics.vercel.app/${lang}/about/`,
        "mainEntity": {
          "@id": `https://mousa-analytics.vercel.app/${lang}/#person`
        }
      }
    ]
  })} />

  <main class="flex-grow pt-24 md:pt-32 pb-20 relative overflow-hidden bg-transparent">
    <!-- Atmospheric Ambient Glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_80%_20%,oklch(75%_0.12_255_/_0.06),transparent_70%)] pointer-events-none z-0" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_50%_at_20%_80%,oklch(75%_0.12_255_/_0.04),transparent_60%)] pointer-events-none z-0" aria-hidden="true"></div>

    <article class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 space-y-24">
      
      <!-- Restructured Section 1: Hero Block (Mousa Analytics B2B Agency) -->
      <!-- Restructured Section 1: Hero Block (Mousa Analytics B2B Agency) -->
      <section class="max-w-3xl mx-auto text-center space-y-6 pt-4 pb-8">
        <div class="space-y-3">
          <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
            {isAr ? "ترتيب وفهم الأرقام" : "ORGANIZING & UNDERSTANDING DATA"}
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight font-serif text-text-main leading-[1.15]">
            {isAr ? (
              <>
                موسى <span class="text-hero-ice-blue italic font-medium">للتحليلات</span>
              </>
            ) : (
              <>
                Mousa <span class="text-hero-ice-blue italic font-medium">Analytics</span>
              </>
            )}
          </h1>
          <h2 class="text-base md:text-lg font-bold font-sans text-text-main/80 mt-2">
            {isAr ? "تبسيط البيانات لمساعدتك على اتخاذ القرارات الصحيحة" : "Simplifying Data to Help You Make the Right Decisions"}
          </h2>
        </div>
        
        <p class="text-sm md:text-base text-text-main/70 font-sans leading-relaxed max-w-2xl mx-auto">
          {isAr ? (
            "بدأت موسى للتحليلات بهدف واحد: تبسيط البيانات المعقدة لأصحاب المتاجر والمشاريع. نحن نؤمن أن الأرقام لا يجب أن تكون صعبة، ولا تحتاج لشعارات تسويقية ضخمة لتقنعك بجدواها. دورنا ببساطة هو مساعدتك على رؤية أرقامك بوضوح لتتخذ قراراتك بثقة، وتقلل الهدر الإعلاني بناءً على حقائق فعلية."
          ) : (
            "Mousa Analytics started with a single goal: simplifying complex data for business and e-commerce owners. We believe that numbers shouldn't be difficult, and you don't need massive marketing slogans to prove their worth. Our role is simple—helping you see your numbers clearly so you can make decisions with confidence, and reduce ad spend waste based on real facts."
          )}
        </p>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 2: Values & Philosophy Block (Clarity, Tracking, Practical Simplicity) -->
      <section class="grid grid-cols-1 lg:grid-cols-[35%_65%] gap-12 lg:gap-20 items-start">
        <aside class="space-y-4">
          <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
            {isAr ? "رؤيتنا في العمل" : "OUR APPROACH"}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main leading-tight">
            {isAr ? (
              <>
                كيف نرى <span class="text-hero-ice-blue italic font-medium">البيانات</span>؟
              </>
            ) : (
              <>
                How We View <span class="text-hero-ice-blue italic font-medium">Data</span>
              </>
            )}
          </h2>
          <p class="text-sm text-text-main/60 font-sans leading-relaxed max-w-sm">
            {isAr 
              ? "البيانات تكون أكثر فائدة حينما تتحول لخطوات عملية واضحة. نساعدك على فهم أرقام متجرك لتتخذ قراراتك بثقة ووضوح." 
              : "Data is most useful when it turns into clear, actionable steps. We help you understand your store's numbers so you can make decisions with clarity."}
          </p>
        </aside>

        <!-- Pillars List -->
        <div class="divide-y divide-text-main/5 space-y-6 lg:space-y-8">
          <div class="pt-0 pb-6 first:pt-0 last:pb-0 space-y-2">
            <h3 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-1.5 h-1.5 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "الوضوح والتركيز" : "Clarity & Focus"}</span>
            </h3>
            <p class="text-sm text-text-main/70 font-sans leading-relaxed ps-5">
              {isAr 
                ? "تصفية الفوضى التقنية والمقاييس الوهمية للتركيز فقط على الأرقام التي تهم عملك وتصنع فارقاً حقيقياً." 
                : "Filtering out technical noise and vanity metrics to focus strictly on numbers that actually impact your business."}
            </p>
          </div>

          <div class="pt-6 pb-6 first:pt-0 last:pb-0 space-y-2">
            <h3 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-1.5 h-1.5 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "منطق التتبع الصحيح" : "Accurate Tracking"}</span>
            </h3>
            <p class="text-sm text-text-main/70 font-sans leading-relaxed ps-5">
              {isAr 
                ? "ربط التتبع الفني والتحليلي بسلوك العميل الفعلي لفهم القصة الكاملة وراء الأرقام." 
                : "Connecting analytics and tracking setup to actual buyer behavior, telling you the real story behind every click."}
            </p>
          </div>

          <div class="pt-6 pb-0 first:pt-0 last:pb-0 space-y-2">
            <h3 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-1.5 h-1.5 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "البساطة العملية" : "Practical Simplicity"}</span>
            </h3>
            <p class="text-sm text-text-main/70 font-sans leading-relaxed ps-5">
              {isAr 
                ? "بناء لوحات بيانات واضحة وسهلة الفهم تساعدك على اتخاذ قراراتك اليومية بيسر وثقة." 
                : "Building clean, straightforward dashboards that help you make daily decisions with confidence and ease."}
            </p>
          </div>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 3: Amr Mousa CEO & Lead Analyst Profile Monogram -->
      <section class="grid grid-cols-1 lg:grid-cols-[40%_60%] gap-12 lg:gap-16 items-center">
        <!-- Visual Column: Square Premium Portrait Frame -->
        <div class="flex flex-col items-center justify-center space-y-6">
          <!-- The main card frame -->
          <div class="group relative w-56 h-56 md:w-64 md:h-64 rounded-2xl p-1 bg-white border border-hero-ice-blue/20 shadow-[0_4px_20px_rgba(10,25,47,0.05)] overflow-hidden transition-all duration-300 hover:border-hero-ice-blue/50">
            <div class="w-full h-full rounded-xl overflow-hidden relative bg-white bg-[linear-gradient(to_right,rgba(10,25,47,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(10,25,47,0.035)_1px,transparent_1px)] bg-[size:1.75rem_1.75rem]">
              <!-- Subtle hover overlay -->
              <div class="absolute inset-0 bg-text-main/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
              <Image 
                src={profileImg} 
                alt={isAr ? "عمرو موسى" : "Amr Mousa"} 
                class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                style="mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%);"
                width={512}
                height={512}
                quality={90}
                loading="eager"
              />
            </div>
          </div>
          
          <div class="text-center space-y-1">
            <h3 class="text-xl font-bold text-text-main font-serif">{isAr ? "عمرو موسى" : "Amr Mousa"}</h3>
            <p class="text-xs text-hero-ice-blue font-bold tracking-widest uppercase font-sans">{isAr ? "المؤسس ومحلل البيانات الرئيسي" : "Founder & Lead Analyst"}</p>
          </div>
        </div>

        <!-- Bio Details -->
        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "تعرف عليّ" : "GET TO KNOW ME"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "كيف بدأت القصة؟" : "How the Story Began"}
            </h2>
          </div>

          <p class="text-sm text-text-main/70 font-sans leading-relaxed">
            {isAr ? (
              "أنا عمرو موسى، بدأت موسى للتحليلات كفكرة بسيطة: مساعدة أصحاب المشاريع والمتاجر على فهم أرقامهم بدون تعقيد. كمحلل بيانات ومسوق، دوري ببساطة هو ترتيب فوضى البيانات وبناء لوحات تحكم واضحة تساعدك على اتخاذ قرارات صحيحة وتقليل الهدر الإعلاني بناءً على حقائق وأرقام حقيقية، بعيداً عن الوعود الوهمية."
            ) : (
              "I'm Amr Mousa, and I started Mousa Analytics with a simple idea: helping business owners understand their numbers without the headache. As an analyst and marketer, my role is simple—bringing order to data data chaos and building clean dashboards that help you make better decisions and reduce ad waste based on real facts, not hollow promises."
            )}
          </p>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 4: Core Capabilities -->
      <section class="space-y-8">
        <div class="flex items-center justify-between">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "القدرات الفنية والتقنية" : "TECHNICAL CAPABILITIES"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "التحليل الفني والنمذجة" : "Analytical & Technical Stack"}
            </h2>
          </div>
          <!-- Swipe Indicator (Mobile Only) -->
          <div class="md:hidden flex items-center gap-1.5 text-[10px] font-bold text-text-main/60 uppercase font-sans tracking-widest">
            <span>{isAr ? "اسحب لليمين" : "Swipe"}</span>
            <i class={`fa-solid ${isAr ? 'fa-arrow-left' : 'fa-arrow-right'} text-[8px] animate-pulse`}></i>
          </div>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 no-scrollbar pb-4 md:pb-0 md:grid md:grid-cols-2 lg:grid-cols-4 md:overflow-x-visible">
          <!-- Card 1: SQL -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 hover:scale-105 transition-transform duration-300">
                <i class="fa-solid fa-database text-xl" aria-hidden="true" title="SQL Database"></i>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "تنظيم قواعد البيانات" : "Database Organization"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "ترتيب وتجهيز البيانات الخاصة بمشروعك لجعلها دقيقة وسهلة الاستخدام في التقارير." 
                  : "Organizing and preparing your business data to make it accurate and easy to use in reports."}
              </p>
            </div>
          </div>

          <!-- Card 2: Python -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-[#3776AB]/10 flex items-center justify-center text-[#3776AB] hover:scale-105 transition-transform duration-300">
                <i class="fa-brands fa-python text-2xl" aria-hidden="true" title="Python"></i>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "أتمتة المهام اليومية" : "Task Automation"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "كتابة أكواد برمجية ذكية لتنظيف البيانات، وتوفير الوقت عن طريق أتمتة المهام المتكررة." 
                  : "Writing smart code to clean datasets and saving time by automating repetitive daily tasks."}
              </p>
            </div>
          </div>

          <!-- Card 3: Excel -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-[#10793F]/10 flex items-center justify-center text-[#10793F] hover:scale-105 transition-transform duration-300">
                <i class="fa-regular fa-file-excel text-2xl" aria-hidden="true" title="Microsoft Excel"></i>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "النماذج المالية والتحليلية" : "Financial & Analytical Models"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "بناء معادلات متقدمة وتصميم نماذج مالية لمشروعك لمتابعة الأرباح والمصاريف تلقائياً." 
                  : "Building advanced formulas and designing financial models to track profits and expenses automatically."}
              </p>
            </div>
          </div>

          <!-- Card 4: Power BI -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-[#F2C811]/10 flex items-center justify-center text-[#F2C811] hover:scale-105 transition-transform duration-300">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" aria-label="Power BI" role="img">
                  <title>Power BI</title>
                  <rect x="3" y="12" width="4" height="8" rx="0.5" />
                  <rect x="10" y="7" width="4" height="13" rx="0.5" />
                  <rect x="17" y="2" width="4" height="18" rx="0.5" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "لوحات البيانات التفاعلية" : "Interactive Dashboards"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "بناء لوحات تحكم تفاعلية وسهلة القراءة تظهر أرقام مشروعك بوضوح لاتخاذ قرارات أسرع." 
                  : "Building interactive, clean dashboards that show your business numbers clearly for faster decision-making."}
              </p>
            </div>
          </div>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 5: Experience Timeline (Horizontal Scroll on Mobile) -->
      <section class="space-y-8">
        <div class="flex items-center justify-between">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "الخبرة العملية" : "PROFESSIONAL HISTORY"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "رحلة البناء والتعلم" : "Experience & Internships"}
            </h2>
          </div>
          <!-- Swipe/Scroll Indicator -->
          <div class="flex items-center gap-1.5 text-[10px] font-bold text-text-main/60 uppercase font-sans tracking-widest">
            <span>{isAr ? "اسحب لليمين" : "Scroll / Swipe"}</span>
            <i class={`fa-solid ${isAr ? 'fa-arrow-left' : 'fa-arrow-right'} text-[8px] animate-pulse`}></i>
          </div>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 no-scrollbar pb-4 w-full px-6 -mx-6">
          <!-- Experience Card 1: NTI -->
          <div class="premium-card-global w-[76vw] md:w-[460px] lg:w-[500px] snap-start flex-shrink-0 p-6 md:p-10 flex flex-col justify-between">
            <div class="space-y-4 font-sans">
              <!-- Top Badges -->
              <div class="flex flex-wrap gap-2.5">
                <span class="px-3.5 py-1 rounded-full bg-text-main/5 text-text-main/60 text-[10px] md:text-xs font-bold tracking-wider uppercase whitespace-nowrap">
                  {isAr ? "فبراير 2026 - الحاضر" : "FEB 2026 – PRESENT"}
                </span>
                <span class="px-3.5 py-1 rounded-full bg-hero-ice-blue/10 text-hero-ice-blue text-[10px] md:text-xs font-bold tracking-wider">
                  {isAr ? "المعهد القومي للاتصالات" : "National Telecommunication Institute - NTI"}
                </span>
              </div>
              
              <!-- Job Title -->
              <h3 class="text-xl md:text-2xl font-bold text-text-main font-sans mt-1">
                {isAr ? "محلل بيانات متدرب" : "Internship Data Analyst"}
              </h3>

              <!-- Custom Bullet List -->
              <ul class="space-y-3.5 text-[13px] md:text-sm text-text-main/80 leading-relaxed font-light mt-3">
                {isAr ? (
                  <>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>إتمام برنامج تدريبي مكثف وعملي بمجموع 120 ساعة يركز على ذكاء الأعمال الموجه بالبيانات ومنهجيات التحليل المتقدمة.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>بناء وتسليم أكثر من 3 مشاريع تحليلية متكاملة باستخدام Excel و Power BI و Python و SQL لتحويل البيانات الأولية إلى رؤى استراتيجية.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>التعاون ضمن فريق عمل احترافي لتطوير النماذج التحليلية وتقديم نتائج عالية التأثير من خلال عروض تقديمية فنية متعددة.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>إظهار توازن قوي بين التحليل الفني ومنطق الأعمال، وتقديم توصيات مفيدة لدعم اتخاذ القرار القائم على البيانات.</span>
                    </li>
                  </>
                ) : (
                  <>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Completed a 120-hour intensive internship program focused on data-driven business intelligence and advanced analytical methodologies.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Successfully delivered 3+ end-to-end analytical projects, utilizing Excel, Power BI, Python, and SQL to transform raw data into strategic insights.</span>
                    </li>
