---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation.astro';
import Footer from '../../components/ui/Footer.astro';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (!lang || !['en', 'ar'].includes(lang)) {
  return Astro.redirect('/en/');
}

const isAr = lang === 'ar';
---

<Layout lang={lang} pageId="about">
  <Navigation lang={lang} activePage="about" />

  <!-- Inject Schema.org JSON-LD Metadata -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `https://amrmousa.com/${lang}/#person`,
        "name": isAr ? "عمرو موسى" : "Amr Mousa",
        "jobTitle": isAr ? "محلل بيانات وتسويق" : "Data & Marketing Analyst",
        "knowsAbout": ["SQL", "Python", "Power BI", "Excel", "Performance Marketing", "Conversion Rate Optimization"],
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "National Telecommunication Institute (NTI)"
          },
          {
            "@type": "EducationalOrganization",
            "name": "Digital Egypt Pioneers Initiative (DEPI)"
          }
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "So Care"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cairo",
          "addressCountry": "EG"
        }
      },
      {
        "@type": "ProfilePage",
        "@id": `https://amrmousa.com/${lang}/about/`,
        "mainEntity": {
          "@id": `https://amrmousa.com/${lang}/#person`
        }
      }
    ]
  })} />

  <main class="flex-grow pt-24 md:pt-32 pb-20 relative overflow-hidden bg-transparent">
    <!-- Atmospheric Ambient Glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_80%_20%,oklch(75%_0.12_255_/_0.06),transparent_70%)] pointer-events-none z-0" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_50%_at_20%_80%,oklch(75%_0.12_255_/_0.04),transparent_60%)] pointer-events-none z-0" aria-hidden="true"></div>

    <article class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 space-y-24">
      <!-- Section 1: Philosophy & Value Pillars -->
      <section class="grid grid-cols-1 lg:grid-cols-[35%_65%] gap-12 lg:gap-20 items-start">
        <aside class="space-y-4">
          <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
            {isAr ? "الفلسفة والركائز" : "PHILOSOPHY & PILLARS"}
          </span>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-serif text-text-main leading-tight">
            {isAr ? (
              <>
                كيف أحقق <span class="text-hero-ice-blue italic font-medium">النتائج الفعالة</span>
              </>
            ) : (
              <>
                How I Drive <span class="text-hero-ice-blue italic font-medium">B2C Growth</span>
              </>
            )}
          </h1>
          <p class="text-sm text-text-main/60 font-sans leading-relaxed max-w-sm">
            {isAr 
              ? "الربط بين قواعد البيانات التحليلية وسيكولوجية المستهلك لفحص وتحسين ومضاعفة مبيعات المتاجر والتجارة الإلكترونية." 
              : "Bridging analytical models with consumer psychology to audit, optimize, and scale B2C conversion pipelines."}
          </p>
        </aside>

        <!-- Pillars Stack -->
        <div class="space-y-6">
          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-2 h-2 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "من الفوضى إلى التركيز" : "From Noise to Focus"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-5">
              {isAr 
                ? "البيانات تكون ذات قيمة فقط إذا كانت توجهك نحو اتخاذ إجراء. أقوم بتصفية الفوضى التقنية والمقاييس الوهمية للتركيز فقط على ما يحقق مبيعات فعلية ويضاعف العوائد." 
                : "Data is only valuable if it drives action. I filter out the technical noise and vanity metrics to focus strictly on what generates sales and scales revenue."}
            </p>
          </div>

          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-2 h-2 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "فك شيفرة السلوك البشري" : "Deciphering the 'Why'"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-5">
              {isAr 
                ? "الأرقام توضح المسار، ولكن علم النفس يفسر الرحلة. من خلال دمج تحليلات البيانات مع فهم سلوك المستهلك، أحدد الأسباب الدقيقة وراء كل نقرة أو تراجع عن الشراء." 
                : "Numbers show the path, but psychology explains the journey. By combining data analytics with consumer behavior, I map the exact reasons behind every click and drop-off."}
            </p>
          </div>

          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-2 h-2 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "سد ثغرات مسارات البيع" : "Bridging the Funnel"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-5">
              {isAr 
                ? "تسريب العملاء من مسار الشراء يعني ميزانية مهدورة. أقوم بفحص وربط التتبع التقني مع المحتوى الإبداعي لضمان رحلة سلسة من الظهور الأول حتى الدفع النهائي." 
                : "A conversion leak is wasted budget. I audit and bridge your technical tracking with creative campaign assets to ensure a seamless path from first impression to checkout."}
            </p>
          </div>

          <div class="border border-text-main/8 rounded-2xl p-6 bg-hero-card/50 backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-hero-ice-blue/20">
            <h2 class="text-base font-bold text-text-main font-serif flex gap-3 items-center leading-snug">
              <span class="w-2 h-2 rounded-full bg-hero-ice-blue shrink-0"></span>
              <span>{isAr ? "المرونة والاتجاه الواضح" : "Structured & Scalable Logic"}</span>
            </h2>
            <p class="mt-3 text-sm text-text-main/80 font-sans leading-relaxed ps-5">
              {isAr 
                ? "الأنظمة وخوارزميات الإعلانات تتغير، لكن منطق التحليل المنظم يظل ثابتاً. أقوم ببناء لوحات بيانات مخصصة وقابلة للتطوير تنمو مع عملك، مما يضمن لك اتجاهاً واضحاً دائماً." 
                : "Systems and algorithms change, but structured logic remains. I build scalable, custom reporting dashboards that grow with your business, ensuring you always have clear direction."}
            </p>
          </div>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 2: Core Capabilities (Horizontal Scroll on Mobile) -->
      <section class="space-y-8">
        <div class="flex items-center justify-between">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "القدرات الفنية" : "CORE CAPABILITIES"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "التحليل الفني والنمذجة" : "Analytical & Technical Stack"}
            </h2>
          </div>
          <!-- Swipe Indicator (Mobile Only) -->
          <div class="md:hidden flex items-center gap-1.5 text-[10px] font-bold text-text-main/40 uppercase font-sans tracking-widest">
            <span>{isAr ? "اسحب لليمين" : "Swipe"}</span>
            <i class={`fa-solid ${isAr ? 'fa-arrow-left' : 'fa-arrow-right'} text-[8px] animate-pulse`}></i>
          </div>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 no-scrollbar pb-4 md:pb-0 md:grid md:grid-cols-2 lg:grid-cols-4 md:overflow-x-visible">
          <!-- Card 1: SQL -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 hover:scale-105 transition-transform duration-300">
                <i class="fa-solid fa-database text-xl" aria-hidden="true" title="SQL Database"></i>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "قواعد البيانات العلاقاتية" : "Relational Database Design"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "تصميم الاستعلامات المعقدة وتنظيف البيانات وضمان سلامة تدفق الهياكل البرمجية." 
                  : "Writing highly optimized queries, analytical aggregates, and structuring schema models for reporting."}
              </p>
            </div>
          </div>

          <!-- Card 2: Python -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-[#3776AB]/10 flex items-center justify-center text-[#3776AB] hover:scale-105 transition-transform duration-300">
                <i class="fa-brands fa-python text-2xl" aria-hidden="true" title="Python"></i>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "معالجة البيانات وأتمتتها" : "Wrangling & Script Automation"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "استخدام Pandas/Numpy لتنظيف البيانات وهيكلتها وأتمتة المهام المكررة بكفاءة." 
                  : "Applying Pandas, NumPy, and scripting methods to ingest, clean, and automate business data tasks."}
              </p>
            </div>
          </div>

          <!-- Card 3: Excel -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-[#10793F]/10 flex items-center justify-center text-[#10793F] hover:scale-105 transition-transform duration-300">
                <i class="fa-regular fa-file-excel text-2xl" aria-hidden="true" title="Microsoft Excel"></i>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "النمذجة الرياضية المعقدة" : "Advanced Business Modeling"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "بناء معادلات متقدمة، النماذج المالية والتحليلية وأتمتة الجداول البرمجية عبر VBA." 
                  : "Constructing advanced formulas, analytics, and business logic using VBA and structured spreadsheets."}
              </p>
            </div>
          </div>

          <!-- Card 4: Power BI -->
          <div class="premium-card-global w-[85%] sm:w-[48%] md:w-auto snap-start flex-shrink-0 flex flex-col justify-between min-h-[160px]">
            <div class="space-y-3 font-sans">
              <div class="w-10 h-10 rounded-xl bg-[#F2C811]/10 flex items-center justify-center text-[#F2C811] hover:scale-105 transition-transform duration-300">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" aria-label="Power BI" role="img">
                  <title>Power BI</title>
                  <rect x="3" y="12" width="4" height="8" rx="0.5" />
                  <rect x="10" y="7" width="4" height="13" rx="0.5" />
                  <rect x="17" y="2" width="4" height="18" rx="0.5" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-text-main font-serif">
                {isAr ? "لوحات البيانات التفاعلية" : "Interactive Dashboard Design"}
              </h3>
              <p class="text-xs text-text-main/70 leading-relaxed font-light">
                {isAr 
                  ? "بناء نمذجة Star Schema المتقدمة وكتابة مقاييس DAX التفاعلية لوضوح اتخاذ القرار." 
                  : "Engineering Star Schema database models and writing custom DAX measures for executive reporting."}
              </p>
            </div>
          </div>
        </div>
      </section>

      <hr class="border-t border-text-main/5" />

      <!-- Section 3: Experience Timeline (Horizontal Scroll on Mobile) -->
      <section class="space-y-8">
        <div class="flex items-center justify-between">
          <div class="space-y-2">
            <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase font-sans">
              {isAr ? "الخبرة العملية" : "PROFESSIONAL HISTORY"}
            </span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-serif text-text-main">
              {isAr ? "رحلة البناء والتعلم" : "Experience & Internships"}
            </h2>
          </div>
          <!-- Swipe/Scroll Indicator -->
          <div class="flex items-center gap-1.5 text-[10px] font-bold text-text-main/40 uppercase font-sans tracking-widest">
            <span>{isAr ? "اسحب لليمين" : "Scroll / Swipe"}</span>
            <i class={`fa-solid ${isAr ? 'fa-arrow-left' : 'fa-arrow-right'} text-[8px] animate-pulse`}></i>
          </div>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 no-scrollbar pb-4 w-full">
          <!-- Experience Card 1: NTI -->
          <div class="premium-card-global w-[92%] sm:w-[85%] md:w-[460px] lg:w-[500px] snap-start flex-shrink-0 p-7 md:p-10 flex flex-col justify-between">
            <div class="space-y-4 font-sans">
              <!-- Top Badges -->
              <div class="flex flex-wrap gap-2.5">
                <span class="px-3.5 py-1 rounded-full bg-text-main/5 text-text-main/60 text-[10px] md:text-xs font-bold tracking-wider uppercase whitespace-nowrap">
                  {isAr ? "فبراير 2026 - الحاضر" : "FEB 2026 – PRESENT"}
                </span>
                <span class="px-3.5 py-1 rounded-full bg-hero-ice-blue/10 text-hero-ice-blue text-[10px] md:text-xs font-bold tracking-wider">
                  {isAr ? "المعهد القومي للاتصالات" : "National Telecommunication Institute - NTI"}
                </span>
              </div>
              
              <!-- Job Title -->
              <h3 class="text-xl md:text-2xl font-bold text-text-main font-sans mt-1">
                {isAr ? "محلل بيانات متدرب" : "Internship Data Analyst"}
              </h3>

              <!-- Custom Bullet List -->
              <ul class="space-y-3.5 text-[13px] md:text-sm text-text-main/80 leading-relaxed font-light mt-3">
                {isAr ? (
                  <>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>إتمام برنامج تدريبي مكثف وعملي بمجموع 120 ساعة يركز على ذكاء الأعمال الموجه بالبيانات ومنهجيات التحليل المتقدمة.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>بناء وتسليم أكثر من 3 مشاريع تحليلية متكاملة باستخدام Excel و Power BI و Python و SQL لتحويل البيانات الأولية إلى رؤى استراتيجية.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>التعاون ضمن فريق عمل احترافي لتطوير النماذج التحليلية وتقديم نتائج عالية التأثير من خلال عروض تقديمية فنية متعددة.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>إظهار توازن قوي بين التحليل الفني ومنطق الأعمال، وتقديم توصيات مفيدة لدعم اتخاذ القرار القائم على البيانات.</span>
                    </li>
                  </>
                ) : (
                  <>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Completed a 120-hour intensive internship program focused on data-driven business intelligence and advanced analytical methodologies.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Successfully delivered 3+ end-to-end analytical projects, utilizing Excel, Power BI, Python, and SQL to transform raw data into strategic insights.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Collaborated within a professional team to refine analytical models and presented high-impact findings through multiple technical presentations.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Demonstrated a strong balance between technical analysis and business logic, providing meaningful recommendations for data-supported decision making.</span>
                    </li>
                  </>
                )}
              </ul>
            </div>
          </div>

          <!-- Experience Card 2: So Care -->
          <div class="premium-card-global w-[92%] sm:w-[85%] md:w-[460px] lg:w-[500px] snap-start flex-shrink-0 p-7 md:p-10 flex flex-col justify-between">
            <div class="space-y-4 font-sans">
              <!-- Top Badges -->
              <div class="flex flex-wrap gap-2.5">
                <span class="px-3.5 py-1 rounded-full bg-text-main/5 text-text-main/60 text-[10px] md:text-xs font-bold tracking-wider uppercase whitespace-nowrap">
                  {isAr ? "يناير 2026 - الحاضر" : "JAN 2026 – PRESENT"}
                </span>
                <span class="px-3.5 py-1 rounded-full bg-hero-ice-blue/10 text-hero-ice-blue text-[10px] md:text-xs font-bold tracking-wider">
                  {isAr ? "سو كير" : "So Care"}
                </span>
              </div>
              
              <!-- Job Title -->
              <h3 class="text-xl md:text-2xl font-bold text-text-main font-sans mt-1">
                {isAr ? "مشتري إعلانات ومطور محتوى" : "Media Buyer | Content Developer"}
              </h3>

              <!-- Custom Bullet List -->
              <ul class="space-y-3.5 text-[13px] md:text-sm text-text-main/80 leading-relaxed font-light mt-3">
                {isAr ? (
                  <>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>إدارة وتحسين حملات تسويق أداء متعددة ذات تحويلات عالية، وتحقيق زيادة استثنائية بنسبة +250% في إجمالي العوائد.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>تطوير استراتيجية محتوى متكاملة نتج عنها إنتاج أكثر من 30 قالباً إعلانياً مخصصاً وأفكار مقاطع مرئية (Reels) مصممة لتحقيق أقصى قدر من التفاعل.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>سد الفجوة بين شراء الإعلانات والتنفيذ الإبداعي من خلال تطوير محتوى استراتيجي يتماشى تماماً مع أهداف أداء الحملة.</span>
                    </li>
                    <li class="hidden md:flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>قيادة التخطيط الاستراتيجي وتجهيز الأصول الإبداعية لحملة إطلاق موقع إلكتروني واسع النطاق قادم لدعم التوسع الرقمي.</span>
                    </li>
                  </>
                ) : (
                  <>
                    <li class="flex gap-2.5 items-start">
                      <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-hero-ice-blue shrink-0 mt-1.5 md:mt-2" aria-hidden="true"></span>
                      <span>Orchestrated and optimized multiple high-conversion performance marketing campaigns, achieving a remarkable +250% increase in total revenue.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
