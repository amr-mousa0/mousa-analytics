---
import Layout from '../../../layouts/Layout.astro';
import Navigation from '../../../components/ui/Navigation.astro';
import Footer from '../../../components/ui/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

if (!lang || !['en', 'ar'].includes(lang)) {
  return Astro.redirect('/en/');
}

const isAr = lang === 'ar';

// Localization Texts
const t = {
  backBtn: isAr ? "العودة للخدمات" : "Back to Services",
  proposalBadge: isAr ? "مقترح مشروع مخصص" : "TAILORED PROFESSIONAL PROPOSAL",
  title: isAr ? "تطوير أنظمة إدارة العملاء (CRM) والأنظمة المخصصة" : "Custom CRM & Systems Development",
  execSummaryTitle: isAr ? "الملخص التنفيذي" : "Executive Summary",
  execSummaryText: isAr 
    ? "هل تعتمد على اشتراكات CRM باهظة الثمن أو جداول بيانات معقدة ومبعثرة لا تتصل بموقعك الإلكتروني؟ أقوم بتطوير تطبيقات ويب مخصصة لإدارة علاقات العملاء (CRM) مصممة بالكامل لتناسب سير عملك الخاص. أربط طلباتك مباشرة بجوجل أناليتكس (GA4/GTM) وأقوم بإعداد توجيه تلقائي للعملاء المحتملين وصلاحيات الموظفين، مما يضمن عدم فقدان أي عميل محتمل وأن تكون بياناتك التسويقية دقيقة بنسبة 100%."
    : "Relying on expensive CRM subscriptions or messy spreadsheets that don't talk to your website? I develop custom web CRM applications tailored entirely to your workflow. I connect your orders directly with Google Analytics (GA4/GTM) and setup automated lead routing and employee privileges, ensuring not a single lead is lost and your marketing data is 100% accurate.",
  
  scopeTitle: isAr ? "ما سأقوم به (نطاق العمل)" : "What I Will Do (Scope of Work)",
  scopeItems: isAr ? [
    {
      title: "تطوير ويب مخصص لنظام الـ CRM (بدون اشتراكات)",
      desc: "رسم خريطة لدورة حياة العميل المحتمل، وحالات الطلبات، ومراحل قمع المبيعات، ومستويات صلاحيات الفريق."
    },
    {
      title: "مزامنة مباشرة من الطلبات إلى التحليلات (GA4/GTM)",
      desc: "بناء تطبيق ويب مخصص لنظام إدارة العملاء (بدون رسوم إضافية للمستخدمين) بهيكل قاعدة بيانات نظيف وسريع."
    },
    {
      title: "صلاحيات وأمان متقدم للأدوار والمستخدمين",
      desc: "دمج واجهات برمجة تطبيقات (APIs) مباشرة بدون تأخير لربط طلبات الويب بالتحليلات وإرسال إشعارات للفريق (عبر واتساب أو سلاك)."
    },
    {
      title: "سير عمل مؤتمت وأنابيب توجيه العملاء",
      desc: "برمجة تدفقات عمل تلقائية لتتبع مراحل الصفقات، وتوزيع العملاء على الموظفين، ومراقبة أداء المبيعات."
    }
  ] : [
    {
      title: "Custom CRM Web Development (No Subscriptions)",
      desc: "Mapping your lead lifecycle, order statuses, custom sales funnels, and team privilege levels."
    },
    {
      title: "Direct Order-to-Analytics Sync (GA4/GTM)",
      desc: "Building a custom CRM web app (no per-user fees) with a clean database architecture."
    },
    {
      title: "Granular Role Privileges & Access Security",
      desc: "Integrating direct, zero-delay APIs linking web orders to analytics and team notifications (WhatsApp/Slack)."
    },
    {
      title: "Automated Workflow & Lead Routing Pipelines",
      desc: "Coding automated workflows to track deal stages, assign leads, and monitor sales performance."
    }
  ],

  deliverablesTitle: isAr ? "ما ستحصل عليه (العائد والنتائج)" : "What You Will Get (Business ROI & Deliverables)",
  deliverablesItems: isAr ? [
    "منصة CRM مخصصة بنسبة 100% ومملوكة لك بالكامل، مما يغنيك عن دفع رسوم اشتراك برمجية شهرية باهظة.",
    "عدم فقدان أي عميل محتمل: التقاط وتوجيه تلقائي فوري للبيانات لفريق المبيعات الخاص بك في أقل من 60 ثانية.",
    "مزامنة تحليلات دقيقة بنسبة 100% تربط الطلبات بجوجل أناليتكس لتتبع عائد الإنفاق إعلاني (ROAS) الحقيقي.",
    "مستويات صلاحيات دقيقة للمستخدمين تمنع تسريب البيانات وتضمن رؤية الموظف للعملاء الموكلين إليه فقط."
  ] : [
    "100% custom CRM platform owned by you, eliminating expensive monthly software subscription fees.",
    "Zero lost leads: instant automatic capturing and routing to your sales team in under 60 seconds.",
    "100% accurate analytics sync linking orders to GA4/GTM to track true marketing ROAS.",
    "Granular user privilege levels, preventing data leaks and ensuring employees only see their assigned leads."
  ],

  ctaTitle: isAr ? "قبول المقترح وبدء المشروع" : "Accept Proposal & Start Project",
  ctaDesc: isAr 
    ? "جاهز لبناء نظام مبيعات خاص بك وتوفير رسوم الاشتراكات المتكررة؟ اضغط أدناه للموافقة على هذا المقترح وبدء التنسيق مباشرة عبر واتساب."
    : "Ready to build your proprietary sales system and eliminate recurring subscription fees? Click below to accept this proposal and start collaborating directly on WhatsApp.",
  ctaBtn: isAr ? "الموافقة على المقترح والبدء الآن" : "Accept Proposal & Start Project",

  faqTitle: isAr ? "الأسئلة الشائعة حول الخدمة" : "Frequently Asked Questions",
  faqItems: isAr ? [
    {
      q: "هل يتطلب هذا الـ CRM دفع اشتراكات شهرية؟",
      a: "لا أبداً. هذا هو الميزة الكبرى للتطوير المخصص؛ ستحصل على نظام تمتلك كوده بالكامل ويتم استضافته على خوادم سحابية ذات تكلفة شبه منعدمة أو مجانية بالكامل للشركات الصغيرة، مما يلغي اشتراكات البرمجيات المكلفة لكل مستخدم."
    },
    {
      q: "كيف يتم ربط وتوجيه العملاء الجدد للفريق تلقائياً؟",
      a: "عند قيام زائر بالتسجيل أو الشراء من موقعك، يقوم النظام بالتقاط البيانات فوراً وتوزيعها على فريق المبيعات بناءً على قواعد تحددها (مثل التوزيع بالتناوب أو التخصص الجغرافي) وإشعارهم فوراً عبر واتساب أو سلاك للرد الفوري."
    },
    {
      q: "هل يمكنني لاحقاً ربط هذا النظام بأدوات أخرى؟",
      a: "نعم بالتأكيد. أقوم ببناء النظام بهندسة برمجية تدعم التكامل والتوسع عبر واجهات برمجة تطبيقات قياسية (RESTful APIs)، مما يتيح لك ربطه مستقبلاً ببرامج المحاسبة، أو خدمات البريد الإلكتروني، أو أي أدوات خارجية أخرى بسهولة."
    },
    {
      q: "كيف تضمن دقة بيانات المبيعات في جوجل أناليتكس (GA4)؟",
      a: "أقوم بالربط المباشر من خلال بروتوكول القياس (Measurement Protocol) الخاص بجوجل، مما يعني إرسال قيم الطلبات والمبيعات الحقيقية من قاعدة بيانات الـ CRM مباشرة إلى GA4 عند إتمام الصفقة، متجاوزاً مشاكل حظر ملفات تعريف الارتباط أو أدوات منع الإعلانات."
    }
  ] : [
    {
      q: "Does this custom CRM require any monthly subscription fees?",
      a: "No. This is the biggest advantage of custom systems; you own the source code entirely. It is deployed on serverless cloud hosts with virtually zero runtime costs, eliminating the expensive per-user subscription fees associated with traditional SaaS CRMs."
    },
    {
      q: "How does the automatic lead capturing and routing work?",
      a: "When a visitor submits a form on your site, the system instantly processes the entry, saves it to the CRM database, and assigns it to a sales agent using predefined rules (like Round-Robin or category matching), sending an immediate notification via WhatsApp or Slack."
    },
    {
      q: "Can I connect this CRM to other tools in the future?",
      a: "Yes. I build the application with a clean, extensible RESTful API architecture, making it simple to link your CRM with accounting software, email marketing engines, or delivery systems down the line as your business operations grow."
    },
    {
      q: "How does this guarantee 100% accurate marketing data in Google Analytics (GA4)?",
      a: "I use Google's server-side Measurement Protocol to send actual sales conversions from the CRM database directly to GA4. This bypasses client-side web browser tracking blockers or cookie consent limitations, providing accurate ROAS data."
    }
  ]
};

// WhatsApp pre-filled message URL
const whatsappMessage = isAr 
  ? "مرحباً عمرو، أود الموافقة على مقترح تطوير أنظمة إدارة العملاء (CRM) والأنظمة المخصصة والبدء في تفاصيل المشروع الحالية."
  : "Hi Amr, I'd like to accept the Custom CRM & Systems Development proposal and discuss starting the project.";
---

<Layout lang={lang} pageId="custom-crm-proposal">
  <Navigation lang={lang} activePage="services" backUrl={`/${lang}/#services`} backText={t.backBtn} />

  <main class="flex-grow pt-24 md:pt-32 pb-20 relative overflow-hidden bg-transparent">
    <!-- Atmospheric Ambient Grid & Glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,rgba(37,99,235,0.03),transparent_70%)] pointer-events-none z-0" aria-hidden="true"></div>
    
    <div class="relative z-10 w-full max-w-4xl mx-auto px-6 sm:px-8 space-y-8">
      
      <!-- Main Proposal Card -->
      <div class="glass-card premium-card-global !p-0 overflow-hidden flex flex-col rounded-[24px]">
        
        <!-- Header: Blueprint Layout -->
        <div class="p-8 md:p-10 relative border-b border-slate-100 bg-slate-50/40 bg-[linear-gradient(to_right,rgba(37,99,235,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(37,99,235,0.04)_1px,transparent_1px)] bg-[size:16px_16px] space-y-4">
          <!-- Proposal Pill Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent-primary/20 bg-accent-primary/5 text-accent-primary text-[9px] font-bold tracking-wider uppercase font-mono">
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-accent-primary"></span>
            </span>
            {t.proposalBadge}
          </div>
          
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-text-main font-serif leading-tight">
            {t.title}
          </h1>

          <!-- Tech Stack Pills -->
          <div class="flex flex-wrap gap-2 pt-1 font-mono">
            <span class="px-3 py-1 rounded-full bg-slate-200/50 text-text-main/65 text-[10px] font-medium border border-text-main/5 transition-colors hover:bg-slate-200/80">Custom CRM</span>
            <span class="px-3 py-1 rounded-full bg-slate-200/50 text-text-main/65 text-[10px] font-medium border border-text-main/5 transition-colors hover:bg-slate-200/80">Web Dev</span>
            <span class="px-3 py-1 rounded-full bg-slate-200/50 text-text-main/65 text-[10px] font-medium border border-text-main/5 transition-colors hover:bg-slate-200/80">Analytics</span>
            <span class="px-3 py-1 rounded-full bg-slate-200/50 text-text-main/65 text-[10px] font-medium border border-text-main/5 transition-colors hover:bg-slate-200/80">Workflow</span>
          </div>
        </div>

        <!-- Executive Summary Section -->
        <div class="p-8 md:p-10 pb-4">
          <div class="p-6 rounded-2xl bg-slate-50/50 border border-slate-100/70 space-y-3 shadow-[inset_0_1px_2px_rgba(0,0,0,0.01)]">
            <h2 class="text-[10px] font-bold uppercase tracking-widest text-text-main/45 font-sans flex items-center gap-2">
              <i class="fa-solid fa-chart-simple text-accent-primary/60" aria-hidden="true"></i>
              {t.execSummaryTitle}
            </h2>
            <p class="text-text-main/80 text-[13.5px] sm:text-[14px] leading-relaxed font-sans font-light">
              {t.execSummaryText}
            </p>
          </div>
        </div>

        <!-- Scope & Deliverables Columns -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 p-8 md:p-10 pt-4">
          
          <!-- Column 1: Scope of Work -->
          <div class="space-y-6">
            <h3 class="text-base font-bold text-text-main font-serif flex items-center gap-2 border-b border-slate-100 pb-3">
              <span class="text-accent-primary/70"><i class="fa-solid fa-list-check text-sm" aria-hidden="true"></i></span>
              {t.scopeTitle}
            </h3>
            
            <div class="space-y-3">
              {t.scopeItems.map((item, i) => (
                <div class="group flex gap-4 items-start p-3 -mx-3 rounded-xl transition-all duration-300 hover:bg-slate-50/60 cursor-default">
                  <div class="w-8.5 h-8.5 rounded-xl bg-accent-primary/8 text-accent-primary border border-accent-primary/12 flex items-center justify-center font-bold text-[11px] flex-shrink-0 transition-transform duration-300 group-hover:scale-105 shadow-xs">
                    0{i + 1}
                  </div>
                  <div class="space-y-1">
                    <h4 class="text-[13px] font-bold text-text-main/85 font-sans tracking-wide">
                      {item.title}
                    </h4>
                    <p class="text-text-main/60 text-[12px] leading-relaxed font-sans font-light">
                      {item.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Column 2: ROI & Deliverables -->
          <div class="space-y-6">
            <h3 class="text-base font-bold text-text-main font-serif flex items-center gap-2 border-b border-slate-100 pb-3">
              <span class="text-accent-primary/70"><i class="fa-solid fa-shield-halved text-sm" aria-hidden="true"></i></span>
              {t.deliverablesTitle}
            </h3>
            
            <div class="space-y-3">
              {t.deliverablesItems.map((item) => (
                <div class="flex gap-3 items-start p-3 -mx-3 rounded-xl transition-all duration-300 hover:bg-slate-50/60 cursor-default">
                  <span class="text-accent-primary/95 text-[15px] mt-0.5 flex-shrink-0 w-5 h-5 flex items-center justify-center">
                    <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
                  </span>
                  <p class="text-text-main/75 text-[13px] sm:text-[13.5px] leading-relaxed font-sans font-light">
                    {item}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Accept Proposal & Start Project CTA (WhatsApp) -->
        <div class="p-8 md:p-10 bg-success-bg border-t border-success-border flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="space-y-1.5 text-center md:text-start max-w-xl">
            <h3 class="text-base font-bold text-text-main font-serif">
              {t.ctaTitle}
            </h3>
            <p class="text-text-main/60 text-[12.5px] leading-relaxed font-sans font-light">
              {t.ctaDesc}
            </p>
          </div>

          <button 
            id="accept-proposal-btn"
            data-msg={whatsappMessage}
            class="h-12 px-6 rounded-full bg-success-primary hover:bg-success-hover text-white font-semibold text-xs tracking-wider flex items-center justify-center gap-2 shadow-success hover:shadow-success-hover active:scale-95 transition-all duration-300 cursor-pointer flex-shrink-0 w-full md:w-auto text-center border-none"
          >
            <i class="fa-solid fa-comments text-sm" aria-hidden="true"></i>
            <span>{t.ctaBtn}</span>
          </button>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-6 pt-6">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text-main font-serif text-center md:text-start flex items-center justify-center md:justify-start gap-2">
          <span class="text-xl">💬</span>
          {t.faqTitle}
        </h2>

        <div class="grid grid-cols-1 gap-4 w-full">
          {t.faqItems.map((faq) => (
            <details class="group bg-white/70 border border-text-main/5 rounded-2xl p-5 transition-all duration-300 hover:border-text-main/12 hover:shadow-[0_4px_16px_rgba(10,25,47,0.03)] cursor-pointer outline-none">
              <summary class="flex justify-between items-center font-bold text-text-main/90 text-xs sm:text-[13px] tracking-wide font-sans list-none select-none outline-none">
                <span class="pe-4 leading-relaxed flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-primary/45 group-hover:bg-accent-primary transition-colors duration-300"></span>
                  {faq.q}
                </span>
                <span class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-[8px] text-text-main/40 group-open:rotate-180 group-hover:bg-slate-200/60 transition-all duration-300 flex-shrink-0 font-sans">
                  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </span>
              </summary>
              <p class="text-text-main/60 text-xs sm:text-[13.5px] leading-relaxed font-sans font-light mt-3.5 pt-3.5 border-t border-slate-100 select-text">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  // Adblock-resilient dynamic WhatsApp redirection
  const btn = document.getElementById('accept-proposal-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      const msg = btn.getAttribute('data-msg') || '';
      const domainParts = ['wa', 'me'];
      const targetDomain = domainParts.join('.');
      const recipientNum = '201202353381';
      const redirectUrl = `https://${targetDomain}/${recipientNum}?text=${encodeURIComponent(msg)}`;
      window.open(redirectUrl, '_blank', 'noopener,noreferrer');
    });
  }
</script>

<style>
  /* Remove default details summary arrow marker */
  details summary::-webkit-details-marker {
    display: none;
  }
  
  /* Polish focused states for FAQ items */
  details:focus-within {
    border-color: rgba(37, 99, 235, 0.25) !important;
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.05) !important;
    outline: none !important;
  }
  details summary:focus-visible {
    outline: none !important;
  }
</style>
