---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Navigation from '../../../components/ui/Navigation.astro';
import Footer from '../../../components/ui/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const isAr = lang === 'ar';

// Fetch and filter localized blog posts
const allPosts = await getCollection('blog');
const activePosts = allPosts
  .filter(post => !post.data.draft && post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const t = {
  title: isAr ? "المدونة والمقالات" : "Blog & Articles",
  subtitle: isAr ? "مقالات متخصصة في التحليلات، التسويق وأتمتة العمليات" : "Expert articles on analytics, performance marketing & automation",
  readMore: isAr ? "اقرأ المقال" : "Read Article",
  publishedOn: isAr ? "نشر في" : "Published on",
  emptyState: isAr ? "لا توجد مقالات منشورة حالياً." : "No articles published yet."
};
---

<Layout 
  lang={lang} 
  pageId="blog"
  contentType="page"
>
  <Navigation lang={lang} activePage="blog" />

  <main class="flex-grow pt-24 md:pt-32 pb-20 relative overflow-hidden bg-transparent">
    <!-- Ambient Glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,rgba(37,99,235,0.03),transparent_70%)] pointer-events-none z-0" aria-hidden="true"></div>

    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 space-y-12">
      <!-- Title Block -->
      <div class="text-center max-w-xl mx-auto space-y-3 pt-4">
        <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-accent-primary uppercase font-mono">
          {isAr ? "رؤى وأفكار" : "INSIGHTS & ARTICLES"}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight font-serif text-text-main leading-tight">
          {t.title}
        </h1>
        <p class="text-text-main/60 text-xs sm:text-sm font-sans leading-relaxed">
          {t.subtitle}
        </p>
      </div>

      <!-- Feed Grid -->
      {activePosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-6">
          {activePosts.map((post) => {
            const postSlug = post.slug.split('/').pop();
            const formattedDate = new Date(post.data.publishDate).toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            });

            return (
              <a href={`/${lang}/blog/${postSlug}/`} class="glass-card glass-card-hover group rounded-[20px] p-5 flex flex-col gap-4 transition-all duration-300">
                {post.data.coverImage && (
                  <div class="overflow-hidden rounded-xl border border-text-main/10 aspect-video">
                    <Image 
                      src={post.data.coverImage} 
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      width={400}
                      quality={85}
                    />
                  </div>
                )}
                <div class="flex-grow flex flex-col justify-between gap-4">
                  <div class="space-y-2">
                    <div class="flex items-center gap-2 text-[10px] font-mono text-text-main/45">
                      <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary font-semibold">{post.data.category}</span>
                      <span>•</span>
                      <span>{formattedDate}</span>
                    </div>
                    <h2 class="text-base font-bold text-text-main group-hover:text-accent-primary transition-colors duration-300 font-serif leading-snug">
                      {post.data.title}
                    </h2>
                    <p class="text-text-main/60 text-xs leading-relaxed font-sans font-light line-clamp-3">
                      {post.data.description}
                    </p>
                  </div>
                  <div class="flex items-center gap-1.5 text-[11px] font-bold text-accent-primary uppercase tracking-wider mt-2 group-hover:gap-2.5 transition-all">
                    <span>{t.readMore}</span>
                    <span class="text-xs">{isAr ? "←" : "→"}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 bg-hero-card/40 border border-text-main/5 rounded-[24px] max-w-md mx-auto">
          <p class="text-sm text-text-main/50 font-sans">{t.emptyState}</p>
        </div>
      )}
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
