---
import Icon from '../../../components/ui/Icon.astro';
import { ContentFacade } from '../../../lib/content/facade.js';
import { getImageUrl } from '../../../scripts/imageHelper';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import { resolveDynamicSeo } from '../../../scripts/seoResolver';
import { useTranslations } from '../../../i18n/index.js';
import { getWhatsAppUrl } from '../../../lib/contact/cta.js';

// Dynamic static route generations with fallback support
export async function getStaticPaths() {
  const allServices = await ContentFacade.getServices({ includeDrafts: true });
  const isProd = import.meta.env.PROD;
  const showDrafts = !isProd;

  // Filter drafts based on build mode
  const activeServices = allServices.filter(item => showDrafts || !item.data.draft);

  // Group services by translation key
  const servicesByKey: Record<string, { en?: any; ar?: any }> = {};
  activeServices.forEach(service => {
    // Slugs are defined as "en/advanced-excel" or similar
    const [lang] = service.slug.split('/');
    const key = service.slug.split('/').slice(1).join('/');
    if (!servicesByKey[key]) {
      servicesByKey[key] = {};
    }
    if (lang === 'en') servicesByKey[key].en = service;
    if (lang === 'ar') servicesByKey[key].ar = service;
  });

  const paths: any[] = [];
  Object.entries(servicesByKey).forEach(([key, versions]) => {
    // Generate English page
    if (versions.en) {
      paths.push({
        params: { lang: 'en', slug: key },
        props: { service: versions.en, isFallback: false }
      });
    } else if (versions.ar) {
      // Fallback: English page uses Arabic content
      paths.push({
        params: { lang: 'en', slug: key },
        props: { service: versions.ar, isFallback: true }
      });
    }

    // Generate Arabic page
    if (versions.ar) {
      paths.push({
        params: { lang: undefined, slug: key },
        props: { service: versions.ar, isFallback: false }
      });
    } else if (versions.en) {
      // Fallback: Arabic page uses English content
      paths.push({
        params: { lang: undefined, slug: key },
        props: { service: versions.en, isFallback: true }
      });
    }
  });

  return paths;
}

const { lang, slug } = Astro.params;
const { service, isFallback } = Astro.props;

if (lang !== undefined && lang !== 'en') {
  return Astro.redirect('/');
}

const currentLang = lang || 'ar';
const isAr = currentLang === 'ar';
const t = useTranslations(currentLang);
const s = t.services;

// Resolve SEO from central source ONLY (Single Source of Truth)
const seoData = await resolveDynamicSeo(currentLang, slug, 'service');

// Check if noindex should be applied (draft OR central SEO noindex flag)
const shouldNoindex = service?.data?.draft || seoData.noindex;

// Resolve dynamic template fields with sensible fallbacks
const scopeTitle = service?.data?.scopeTitle || s.scopeTitle;
const deliverablesTitle = service?.data?.deliverablesTitle || s.deliverablesTitle;
const ctaTitle = service?.data?.ctaTitle || s.ctaTitle;
const ctaDesc = service?.data?.ctaDesc || s.ctaDesc;
const ctaBtn = service?.data?.ctaBtn || s.ctaBtn;
const faqTitle = service?.data?.faqTitle || s.faqTitle;

const whatsappMessage = service?.data?.whatsappMessage || (isAr 
  ? `مرحباً عمرو، أود الموافقة على مقترح ${service?.data?.title || ''} والبدء في تفاصيل المشروع الحالية.`
  : `Hi Amr, I'd like to accept the ${service?.data?.title || ''} proposal and discuss starting the project.`);

// Fetch matching projects of the current category (T013)
// Fetch matching projects of the current category or tags
const category = service?.data?.category?.toLowerCase() || '';
const serviceTags = (service?.data?.tags || []).map((t: string) => t.toLowerCase());

const allProjects = await ContentFacade.getProjects({ lang: currentLang });
const activeProjects = (allProjects || []).filter((p: any) => {
  const pCat = p?.data?.category?.toLowerCase() || '';
  const pTags = (p?.data?.tags || []).map((t: string) => t.toLowerCase());
  return (category && pCat === category) || pTags.some((tag: string) => serviceTags.includes(tag));
});

const rawDeliverables = service?.data?.deliverablesItems || service?.data?.deliverableItems || [];
const coverImgSrc = getImageUrl(service?.data?.coverImage);
---

<Layout 
  lang={currentLang} 
  pageId={`service-${slug}`}
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage || coverImgSrc}
  canonicalUrl={seoData.canonicalUrl}
  noindex={shouldNoindex}
  contentType="service"
  slug={slug}
  pageCategory={service?.data?.category}
  isFallback={isFallback}
>
  <Navbar lang={currentLang === 'en' ? 'en' : 'ar'} activePage="services" backUrl={currentLang === 'ar' ? '/#services' : '/en/#services'} backText={s.backToServices} />

  <main class="flex-grow pt-24 md:pt-32 pb-20 relative bg-bg-primary">

    <div class="relative w-full max-w-3xl mx-auto px-6 sm:px-8">
      <div class="space-y-14 md:space-y-20">

      {isFallback && (
        <div class="rounded-lg border border-amber-500/20 bg-amber-500/5 px-4 py-3 sm:px-5 text-amber-700/90 text-xs sm:text-sm font-sans flex items-center gap-3">
          <Icon name="xmark" class="w-4 h-4 shrink-0" />
          <span>{s.fallbackNotice}</span>
        </div>
      )}

      <!-- Proposal Masthead -->
      <header class="space-y-8 md:space-y-10">
        <div class="space-y-6 max-w-2xl">
          <span class="block font-mono text-xs uppercase tracking-widest text-text-muted">{s.proposalBadge}</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-text-main leading-tight">
            {service?.data?.title}
          </h1>
          {service?.data?.description && (
            <p class="text-lg text-text-muted leading-relaxed font-light">
              {service.data.description}
            </p>
          )}
        </div>

        <!-- Cover Image -->
        {coverImgSrc && (
          <figure class="relative">
            <img
              src={coverImgSrc}
              alt={service?.data?.title || ''}
              class="w-full aspect-video object-cover block"
              width="1000"
              height="500"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
          </figure>
        )}
      </header>

      <!-- Executive Summary -->
      <section class="space-y-5 max-w-2xl">
        <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">{s.execSummaryTitle}</h2>
        <p class="text-xl text-text-main leading-relaxed font-light">
          {service?.data?.execSummaryText}
        </p>
      </section>

      <!-- Scope & Deliverables -->
      <section class="grid grid-cols-1 md:grid-cols-2 items-start">
        <!-- Scope of Work -->
        <div class="md:pe-14 pb-12 md:pb-0">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-main mb-6">{scopeTitle}</h3>
          <ol class="divide-y divide-text-main/10">
            {(service?.data?.scopeItems || []).map((item: { title: string; desc: string }, index: number) => (
              <li class="flex items-start gap-5 py-5 first:pt-0">
                <span class="font-mono text-xs text-text-muted pt-1 shrink-0">{String(index + 1).padStart(2, '0')}</span>
                <div class="space-y-1.5">
                  <span class="block text-sm font-semibold text-text-main">{item.title}</span>
                  <p class="text-text-muted text-sm leading-relaxed font-light break-words">{item.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- Deliverables -->
        <div class="md:ps-14 md:border-s md:border-text-main/10">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-main mb-6">{deliverablesTitle}</h3>
          <ul class="divide-y divide-text-main/10">
            {rawDeliverables.map((item: any) => {
              const isObj = typeof item === 'object' && item !== null;
              const itemTitle = isObj ? item.title : (typeof item === 'string' ? item : '');
              const itemDesc = isObj ? item.desc : null;
              if (!itemTitle) return null;

              return (
                <li class="flex items-start gap-3 py-4 first:pt-0">
                  <Icon name="circle-check" class="w-4 h-4 text-text-muted shrink-0 mt-0.5" />
                  <div class="space-y-1">
                    <span class="block text-sm font-semibold text-text-main leading-snug">{itemTitle}</span>
                    {itemDesc && (
                      <p class="text-text-muted text-sm leading-relaxed font-light break-words">{itemDesc}</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <!-- FAQ -->
      {service?.data?.faqItems && service.data.faqItems.length > 0 && (
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-text-main">{faqTitle}</h2>
          <div class="mt-4 divide-y divide-text-main/10">
            {(service.data.faqItems || []).map((faq: any) => {
              const question = faq.q || faq.question || '';
              const answer = faq.a || faq.answer || '';
              return (
                <details class="group py-5">
                  <summary class="flex items-center justify-between gap-6 cursor-pointer list-none select-none">
                    <span class="text-sm font-semibold text-text-main">{question}</span>
                    <svg class="w-4 h-4 text-text-muted transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <p class="mt-4 text-sm text-text-muted leading-relaxed font-light pt-4 border-t border-text-main/10 break-words">
                    {answer}
                  </p>
                </details>
              );
            })}
          </div>
        </section>
      )}

      <!-- CTA -->
      <section class="border-t border-text-main/10 pt-10 md:pt-12 flex flex-col sm:flex-row sm:items-center justify-between gap-8">
        <div class="space-y-3 max-w-xl">
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-main">
            {ctaTitle}
          </h3>
          <p class="text-text-muted text-sm sm:text-base leading-relaxed font-sans font-light">
            {ctaDesc}
          </p>
        </div>

        <a
          href={getWhatsAppUrl({ message: whatsappMessage, lang: currentLang })}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 min-h-[48px] px-6 rounded-lg bg-success-primary hover:bg-success-hover text-white text-sm font-semibold tracking-wide transition-colors active:scale-[0.98] shrink-0 w-full sm:w-auto"
        >
          <Icon name="whatsapp" class="w-4 h-4" />
          <span>{ctaBtn}</span>
        </a>
      </section>

      <!-- Related Case Studies -->
      {activeProjects && activeProjects.length > 0 && (
        <section>
          <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">
            {s.relatedProjectsTitle}
          </h2>
          <ul class="mt-4 divide-y divide-text-main/10">
            {activeProjects.map((p: any) => {
              const pSlug = p.slug.split('/').pop();
              return (
                <li>
                  <a href={currentLang === 'ar' ? `/projects/${pSlug}/` : `/en/projects/${pSlug}/`} class="group flex items-center justify-between gap-6 py-5">
                    <div class="space-y-1 overflow-hidden">
                      <span class="block font-mono text-xs uppercase tracking-wider text-text-muted">{t.blogPage.caseStudyTag}</span>
                      <span class="block text-sm font-semibold text-text-main truncate group-hover:text-accent-primary transition-colors">{p?.data?.title}</span>
                    </div>
                    <svg class="w-4 h-4 text-text-muted group-hover:text-accent-primary transition-colors shrink-0 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5 15.75 12 8.25 19.5" /></svg>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      </div>
    </div>
  </main>

  <Footer lang={currentLang === 'en' ? 'en' : 'ar'} />
</Layout>
