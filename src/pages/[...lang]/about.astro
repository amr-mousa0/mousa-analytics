---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { Image } from 'astro:assets';
import profileImg from '../../assets/images/amr-hero-v5.png';
import { useTranslations } from '../../i18n/index.js';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: undefined } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (lang !== undefined && lang !== 'en') {
  return Astro.redirect('/');
}

const currentLang = lang || 'ar';
const t = useTranslations(currentLang);
const ab = t.aboutPage;

import AboutHeroCinematic from '../../components/sections/about-hero-cinematic';
import GalleryStripParallax from '../../components/sections/gallery-strip-parallax';
import SocialCards from '../../components/ui/carousels/fan/fan-carousel';
import EvidenceStrip from '../../components/sections/evidence-strip';
import ReadyCtaCinematic from '../../components/sections/ready-cta-cinematic';
import ApproachPinnedRoadmap from '../../components/sections/approach-pinned-roadmap';
import { ContentFacade } from '../../lib/content/facade.js';
import type { CarouselItem } from '../../components/ui/carousels/base/carousel.types';

const experienceCards = ab.experienceCards || [];
const rawCapabilities = await ContentFacade.getCapabilities({ lang: currentLang as 'en' | 'ar' });
const capabilityItems: CarouselItem[] = rawCapabilities.map((cap) => ({
  id: cap.slug || cap.id,
  title: cap.data.title,
  description: cap.data.description,
  tag: cap.data.tag,
  icon: cap.data.icon,
}));

const approachPillars = [
  { number: "01", title: ab.pillar1Title, desc: ab.pillar1Desc },
  { number: "02", title: ab.pillar2Title, desc: ab.pillar2Desc },
  { number: "03", title: ab.pillar3Title, desc: ab.pillar3Desc },
];
---

<Layout lang={currentLang} pageId="about">
  <Navbar lang={currentLang === 'en' ? 'en' : 'ar'} activePage="about" />

  <!-- Inject Schema.org JSON-LD Metadata -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `https://mousa-analytics.vercel.app/${currentLang === 'ar' ? '' : 'en/'}#person`,
        "name": t.nav.authorName,
        "jobTitle": ab.founderJobTitle,
        "knowsAbout": ["SQL", "Python", "Power BI", "Excel", "Performance Marketing", "Conversion Rate Optimization"],
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "National Telecommunication Institute (NTI)"
          },
          {
            "@type": "EducationalOrganization",
            "name": "Digital Egypt Pioneers Initiative (DEPI)"
          }
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "So Care"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cairo",
          "addressCountry": "EG"
        }
      },
      {
        "@type": "ProfilePage",
        "@id": `https://mousa-analytics.vercel.app/${currentLang === 'ar' ? 'about/' : 'en/about/'}`,
        "url": `https://mousa-analytics.vercel.app/${currentLang === 'ar' ? 'about/' : 'en/about/'}`,
        "mainEntity": {
          "@id": `https://mousa-analytics.vercel.app/${currentLang === 'ar' ? '' : 'en/'}#person`
        }
      }
    ]
  })} />

  <main class="flex-grow pb-20 relative overflow-hidden bg-transparent">
    <!-- Section 1: TOLVA Editorial Hero Block -->
    <AboutHeroCinematic client:load lang={currentLang} />

    <!-- Section 1.5: Cinematic Gallery Strip — living portfolio divider between hero and content -->
    <GalleryStripParallax client:load />

    <!-- Section 2: Evidence Strip (Trust Metrics) -->
    <div class="relative z-10 w-full bg-primary-bg">
      <EvidenceStrip lang={currentLang as 'en' | 'ar'} />
    </div>

    <!-- Section 3: Profile / About (High-End Dark Ethereal Glass Layout) -->
    <section class="relative w-full bg-[#050505] text-[#FAFAFA] py-32 md:py-48 overflow-hidden z-20">
      <!-- Ethereal Glass Glow -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.04)_0%,transparent_70%)] pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto w-full px-6 sm:px-8 lg:px-12 relative z-10">
        
        <div class="grid grid-cols-1 md:grid-cols-[38%_62%] lg:grid-cols-[35%_65%] gap-12 md:gap-20 lg:gap-24 items-center">
          <!-- Visual Column: Double Bezel Architecture -->
          <div class="reveal-el translate-y-16 opacity-0 blur-md transition-all duration-[1.2s] ease-[cubic-bezier(0.32,0.72,0,1)] delay-100 w-full max-w-sm mx-auto md:mx-0">
            <div class="group relative w-full aspect-[4/5] p-2 bg-white/5 border border-white/10 rounded-[2rem] overflow-hidden shadow-2xl">
              <!-- Inner Core -->
              <div class="w-full h-full relative bg-[#0a0a0a] rounded-[calc(2rem-0.5rem)] overflow-hidden shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)]">
                <Image 
                  src={profileImg} 
                  alt={t.nav.authorName} 
                  class="w-full h-full object-cover transition-transform duration-[1.5s] ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
                  width={600}
                  height={750}
                  quality={90}
                />
                <!-- Subtle overlay -->
                <div class="absolute inset-0 bg-black/10 pointer-events-none transition-opacity duration-700 group-hover:opacity-0"></div>
              </div>
            </div>
          </div>

          <!-- Bio Details -->
          <div class="space-y-10 md:pt-4 text-white/80">
            <p class="reveal-el translate-y-16 opacity-0 blur-md transition-all duration-[1.2s] ease-[cubic-bezier(0.32,0.72,0,1)] delay-200 text-lg md:text-xl lg:text-2xl font-sans leading-[1.8] font-light tracking-wide">
              {ab.storyP1}
            </p>
            <p class="reveal-el translate-y-16 opacity-0 blur-md transition-all duration-[1.2s] ease-[cubic-bezier(0.32,0.72,0,1)] delay-300 text-lg md:text-xl lg:text-2xl font-sans leading-[1.8] font-light tracking-wide text-white/50">
              {ab.storyP2}
            </p>

            <!-- Toolkit / Capabilities Tags -->
            <div class="reveal-el translate-y-16 opacity-0 blur-md transition-all duration-[1.2s] ease-[cubic-bezier(0.32,0.72,0,1)] delay-400 pt-8 border-t border-white/10 mt-8">
              <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-blue-400/80 uppercase font-sans block mb-6">
                {ab.techCapabilities}
              </span>
              <div class="flex flex-wrap gap-3">
                {rawCapabilities.map((cap) => (
                  <div class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-xs md:text-sm text-white/90 font-sans tracking-wide shadow-sm hover:bg-white/10 transition-colors">
                    {cap.data.title}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </section>

    <!-- Reopen Light Theme Wrapper -->
    <div class="relative z-10 w-full bg-primary-bg">
      <article class="w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 space-y-24 py-24 md:py-32">

      <!-- Section 4: Values & Philosophy Block (Staggered Zig-Zag Pinned Note Roadmap Cards) -->
      <ApproachPinnedRoadmap
        client:visible
        eyebrow={ab.ourApproach}
        titlePrefix={ab.viewDataTitlePrefix}
        titleHighlight={ab.viewDataHighlight}
        subhead={ab.heroSubhead}
        pillars={approachPillars}
        lang={currentLang as 'en' | 'ar'}
      />

      </article>
    </div>

    <!-- Section 5: Experience Timeline (Edge-to-Edge Dark Layout with Curves) -->
    <section class="relative w-full bg-[#050505] text-[#FAFAFA] py-32 md:py-48 overflow-hidden z-20 dark">
      <!-- Ethereal Glass Glow -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
        <div class="w-[34rem] sm:w-[48rem] h-[22rem] sm:h-[28rem] rounded-full bg-blue-600/10 blur-[120px]"></div>
      </div>
      


      <div class="relative z-10 space-y-16 max-w-[100rem] mx-auto w-full px-4 sm:px-8 lg:px-12">
        <div class="flex items-center justify-center text-center">
          <div class="space-y-4 md:space-y-6">
            <span class="reveal-el translate-y-8 opacity-0 blur-sm transition-all duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] text-[10px] md:text-xs font-semibold tracking-[0.25em] text-blue-400/80 uppercase font-sans block drop-shadow-md">
              {ab.historyEyebrow}
            </span>
            <h2 class="reveal-el translate-y-8 opacity-0 blur-sm transition-all duration-[1000ms] ease-[cubic-bezier(0.16,1,0.3,1)] delay-100 text-4xl sm:text-5xl md:text-7xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-white via-white/90 to-white/20 pb-2 drop-shadow-xl">
              {ab.historyTitle}
            </h2>
          </div>
        </div>

        <div class="w-full flex justify-center pt-8 pb-12">
          <SocialCards client:load cards={experienceCards} />
        </div>
      </div>
      

    </section>

    <!-- Reopen Light Theme Wrapper -->
    <div class="relative z-10 w-full bg-gradient-to-b from-[#F8F9FA] to-primary-bg">
      <article class="w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 space-y-24 pt-24 md:pt-32">


      <!-- Section 6: Action CTA Block (Ready to grow sales cinematic component) -->
      <ReadyCtaCinematic
        client:visible
        headline={ab.readyHeadline}
        subhead={ab.heroSubhead}
        buttonText={ab.getStarted}
        targetUrl={currentLang === 'ar' ? "/#contact" : "/en/#contact"}
        lang={currentLang as 'en' | 'ar'}
      />

    </article>
    </div>
  </main>

  <Footer lang={currentLang === 'en' ? 'en' : 'ar'} />

  <style is:inline>
    /* Cursor blink keyframe for typewriter */
    @keyframes cursor-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    /* Accent line reveal animation */
    .about-accent-line.is-visible {
      animation: accent-line-grow 1.2s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }
    @keyframes accent-line-grow {
      from { width: 0; }
      to { width: 120px; }
    }
    @media (min-width: 768px) {
      @keyframes accent-line-grow {
        from { width: 0; }
        to { width: 180px; }
      }
    }
    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .about-typewriter-cursor { animation: none !important; opacity: 1; }
      .about-accent-line.is-visible { animation: none !important; width: 120px; }
    }
  </style>

  <script is:inline>
    const initReveal = () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('translate-y-16', 'translate-y-12', 'translate-y-24', 'opacity-0', 'blur-md', 'blur-sm', 'blur-lg');
            entry.target.classList.add('translate-y-0', 'opacity-100', 'blur-0');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -100px 0px' });
      
      document.querySelectorAll('.reveal-el').forEach((el) => {
        observer.observe(el);
      });
    };

    /* Typewriter effect for the tagline */
    const initTypewriter = () => {
      const el = document.querySelector('.about-typewriter');
      if (!el) return;
      const fullText = el.getAttribute('data-full-text') || '';
      const textSpan = el.querySelector('.about-typewriter-text');
      const cursorSpan = el.querySelector('.about-typewriter-cursor');
      if (!textSpan || !fullText) return;

      let started = false;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReduced) {
        textSpan.textContent = fullText;
        if (cursorSpan) cursorSpan.style.display = 'none';
        return;
      }

      const typewriterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true;
            typewriterObserver.unobserve(entry.target);
            let i = 0;
            const speed = 35; // ms per character
            const type = () => {
              if (i <= fullText.length) {
                textSpan.textContent = fullText.slice(0, i);
                i++;
                setTimeout(type, speed);
              } else {
                // Hide cursor after typing finishes (with a brief pause)
                setTimeout(() => {
                  if (cursorSpan) {
                    cursorSpan.style.transition = 'opacity 0.6s ease';
                    cursorSpan.style.opacity = '0';
                  }
                }, 800);
              }
            };
            // Small delay before starting to type
            setTimeout(type, 600);
          }
        });
      }, { rootMargin: '0px 0px -50px 0px' });

      typewriterObserver.observe(el);
    };

    /* Accent line width animation */
    const initAccentLine = () => {
      const line = document.querySelector('.about-accent-line');
      if (!line) return;
      const lineObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            line.classList.add('is-visible');
            lineObserver.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -50px 0px' });
      lineObserver.observe(line);
    };

    const initAll = () => {
      initReveal();
      initTypewriter();
      initAccentLine();
    };

    document.addEventListener('astro:page-load', initAll);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</Layout>
