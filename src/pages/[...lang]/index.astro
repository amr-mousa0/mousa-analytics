---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/ui/Navigation.astro';
import Hero from '../../components/sections/Hero.astro';
import Services from '../../components/sections/Services.astro';
import Projects from '../../components/sections/Projects.astro';
import Footer from '../../components/ui/Footer.astro';

import { getImage } from 'astro:assets';
import analyticsBgImgDesktop from '../../assets/images/analyst-side-bg-desktop.png';
import analyticsBgImgMobile from '../../assets/images/analyst-side-bg-mobile.png';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: undefined } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (lang !== undefined && lang !== 'en') {
  return Astro.redirect('/');
}

const currentLang = lang || 'ar';
const isAr = currentLang === 'ar';

// Pre-optimize hero images at build time for preloading
const desktopImg = await getImage({ src: analyticsBgImgDesktop, quality: 85, format: 'webp' });
const mobileImg = await getImage({ src: analyticsBgImgMobile, quality: 80, format: 'webp' });
---

<Layout lang={currentLang} pageId="homepage" preloadImageMobile={mobileImg.src} preloadImageDesktop={desktopImg.src}>


  <Navigation lang={currentLang} activePage="home" />
  <main class="flex-grow">
    <Hero lang={currentLang} desktopImg={desktopImg} mobileImg={mobileImg} />
    <Services lang={currentLang} />
    <Projects lang={currentLang} />
  </main>
  <Footer lang={currentLang} />
</Layout>
