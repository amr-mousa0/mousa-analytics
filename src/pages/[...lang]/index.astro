---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import CinematicHero from '../../components/sections/CinematicHero.astro';
import VisualCollage from '../../components/sections/VisualCollage.astro';
import Services from '../../components/sections/Services.astro';
import Projects from '../../components/sections/Projects.astro';
import PainPoints from '../../components/sections/PainPoints.astro';
import Footer from '../../components/layout/Footer.astro';

// Dynamic route parameters
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: undefined } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (lang !== undefined && lang !== 'en') {
  return Astro.redirect('/');
}

const currentLang = (lang || 'ar') as 'en' | 'ar';
const heroImage = currentLang === 'ar' ? '/dashboard-hero-right.webp' : '/dashboard-hero-left.webp';
---

<Layout lang={currentLang} pageId="homepage" preloadImageMobile={heroImage} preloadImageDesktop={heroImage}>
  <Navbar lang={currentLang} activePage="home" />
  <main class="flex-grow">
    <CinematicHero lang={currentLang} />
    <VisualCollage lang={currentLang} />
    <Services lang={currentLang} />
    <Projects lang={currentLang} />
    <PainPoints lang={currentLang} />
  </main>
  <Footer lang={currentLang} />
</Layout>
