---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Icon from '../../components/ui/Icon.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
import { getContactHref } from '../../lib/contact/cta.js';
import { useTranslations } from '../../i18n/index.js';

// Dynamic route parameters for bilingual setup
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: undefined } },
  ];
}

const { lang } = Astro.params;

// Route Parameter Guard
if (lang !== undefined && lang !== 'en') {
  return Astro.redirect('/');
}

const currentLang = lang || 'ar';
const isAr = currentLang === 'ar';
const t = useTranslations(currentLang);
const tm = t.termsPage;

const contactVariant = isAr ? 'whatsapp' : 'primary';
const contactIcon = isAr ? 'whatsapp' : 'envelope';
---

<Layout lang={currentLang} pageId="terms">
  <Navbar lang={currentLang === 'en' ? 'en' : 'ar'} activePage="" />

  <!-- Inject Schema.org JSON-LD Metadata for Legal Page -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": new URL(currentLang === 'ar' ? 'terms/' : 'en/terms/', Astro.site).href,
        "url": new URL(currentLang === 'ar' ? 'terms/' : 'en/terms/', Astro.site).href,
        "name": tm.title,
        "description": tm.subtitle,
        "isPartOf": {
          "@type": "WebSite",
          "@id": new URL(currentLang === 'ar' ? '#website' : 'en/#website', Astro.site).href
        }
      }
    ]
  })} />


  <main class="flex-grow pt-24 md:pt-32 pb-20 relative overflow-hidden bg-transparent font-sans">
    <!-- Atmospheric Premium Ambient Glows -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_80%_20%,oklch(75%_0.12_255_/_0.06),transparent_70%)] pointer-events-none z-0" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_50%_at_20%_80%,oklch(75%_0.12_255_/_0.04),transparent_60%)] pointer-events-none z-0" aria-hidden="true"></div>

    <article class="relative z-10 w-full max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 space-y-16" dir={isAr ? "rtl" : "ltr"}>
      
      <!-- Premium Editorial Header -->
      <header class="text-center space-y-4 max-w-3xl mx-auto">
        <span class="text-[10px] sm:text-xs font-bold tracking-[0.25em] text-hero-ice-blue uppercase">
          {tm.eyebrow}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-main leading-tight">
          {tm.title}
        </h1>
        <p class="text-sm sm:text-base text-text-main/70 max-w-xl mx-auto font-light leading-relaxed">
          {tm.subtitle}
        </p>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-text-main/5 border border-text-main/10 text-text-main/55 text-[10px] font-medium font-mono select-none">
          <Icon name="calendar-check" class="w-3 h-3" />
          <span>{tm.lastUpdated}</span>
        </div>
      </header>

      <!-- Minimalist elegant divider -->
      <div class="w-24 h-[1px] bg-gradient-to-r from-transparent via-text-main/20 to-transparent mx-auto" aria-hidden="true"></div>

      <!-- Core Content Grid -->
      <div class="space-y-12 text-text-main/80 text-sm sm:text-[15px] leading-relaxed font-light">
        
        <!-- Intro Section -->
        <section class="glass-card p-6 sm:p-8 rounded-xl border border-text-main/5 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center text-accent-primary shrink-0">
              <Icon name="gears" class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-text-main">
              {tm.introTitle}
            </h2>
          </div>
          <p class="text-text-main/70">
            {tm.introText}
          </p>
        </section>

        <!-- Scope of Services -->
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center text-accent-primary shrink-0">
              <Icon name="chart-line" class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-text-main">
              {tm.scopeTitle}
            </h2>
          </div>
          <p class="text-text-main/75">
            {tm.scopeText}
          </p>
          <ul class="list-none space-y-3 pl-0">
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-2.5 shrink-0" aria-hidden="true"></span>
              <span>{tm.scopeItem1}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-2.5 shrink-0" aria-hidden="true"></span>
              <span>{tm.scopeItem2}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-2.5 shrink-0" aria-hidden="true"></span>
              <span>{tm.scopeItem3}</span>
            </li>
          </ul>
        </section>

        <!-- Client Responsibilities -->
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center text-accent-primary shrink-0">
              <Icon name="user" class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-text-main">
              {tm.responsibilityTitle}
            </h2>
          </div>
          <p class="text-text-main/75">
            {tm.responsibilityText}
          </p>
          <ul class="list-none space-y-3 pl-0">
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-2.5 shrink-0" aria-hidden="true"></span>
              <span>{tm.responsibilityItem1}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-2.5 shrink-0" aria-hidden="true"></span>
              <span>{tm.responsibilityItem2}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-primary mt-2.5 shrink-0" aria-hidden="true"></span>
              <span>{tm.responsibilityItem3}</span>
            </li>
          </ul>
        </section>

        <!-- Intellectual Property -->
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center text-accent-primary shrink-0">
              <Icon name="shield-halved" class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-text-main">
              {tm.ipTitle}
            </h2>
          </div>
          <p class="text-text-main/75">
            {tm.ipText}
          </p>
        </section>

        <!-- Payments and Termination -->
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center text-accent-primary shrink-0">
              <Icon name="calendar-check" class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-text-main">
              {tm.paymentTitle}
            </h2>
          </div>
          <p class="text-text-main/75">
            {tm.paymentText}
          </p>
        </section>

        <!-- Advisory Disclaimer -->
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-primary/10 flex items-center justify-center text-accent-primary shrink-0">
              <Icon name="eye" class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-text-main">
              {tm.disclaimerTitle}
            </h2>
          </div>
          <p class="text-text-main/75">
            {tm.disclaimerText}
          </p>
        </section>

      </div>

      <!-- Elegant Call to Actions -->
      <footer class="pt-8 border-t border-text-main/5 flex flex-col sm:flex-row items-center justify-center gap-4">
        <ActionButton
          href={getContactHref(isAr ? 'whatsapp' : 'email', currentLang as 'en' | 'ar')}
          target="_blank"
          variant={contactVariant}
          icon={contactIcon}
          iconPosition="left"
          class="w-full sm:w-auto"
        >
          {tm.contactBtn}
        </ActionButton>
        <ActionButton
          href={currentLang === 'ar' ? '/' : '/en/'}
          variant="outline"
          class="w-full sm:w-auto"
        >
          {tm.homeBtn}
        </ActionButton>
      </footer>

    </article>
  </main>

  <Footer lang={currentLang === 'en' ? 'en' : 'ar'} />
</Layout>
