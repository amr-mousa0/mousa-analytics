---
import { getImageUrl } from '../../../scripts/imageHelper.js';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import Icon from '../../../components/ui/Icon.astro';
import { ContentFacade } from '../../../lib/content/facade.js';
import { resolveDynamicSeo } from '../../../scripts/seoResolver';
import { useTranslations } from '../../../i18n/index.js';
import { getWhatsAppUrl } from '../../../lib/contact/cta.js';

// Dynamic static route generations with fallback support
export async function getStaticPaths() {
  let allProjects: any[] = [];
  
  try {
    const fileProjects = await ContentFacade.getProjects({ includeDrafts: true });
    if (fileProjects) {
      allProjects = fileProjects.map(p => ({
        id: p.id,
        slug: p.slug,
        draft: p.data.draft,
        ...p.data,
        data: p.data
      }));
    }
  } catch (e) {
    console.warn('[projects/[slug].astro] Local collection fallback error:', e);
  }

  const isProd = import.meta.env.PROD;
  const showDrafts = !isProd;

  // Filter drafts based on build mode
  const activeProjects = allProjects.filter(item => showDrafts || !item.draft);

  // Group projects by translation key
  const projectsByKey: Record<string, { en?: any; ar?: any }> = {};
  activeProjects.forEach(project => {
    const cleanKey = project.slug.replace(/^(ar|en)\//, '').split('/').pop() || project.slug;
    const isArabic = project.slug.startsWith('ar/') || (project as any).id?.startsWith('ar/');
    const langKey = isArabic ? 'ar' : 'en';

    if (!projectsByKey[cleanKey]) {
      projectsByKey[cleanKey] = {};
    }
    if (langKey === 'en') projectsByKey[cleanKey].en = project;
    if (langKey === 'ar') projectsByKey[cleanKey].ar = project;
  });

  const paths: any[] = [];
  Object.entries(projectsByKey).forEach(([key, versions]) => {
    if (!key || key === '') return;

    // Generate English page
    if (versions.en) {
      paths.push({
        params: { lang: 'en', slug: key },
        props: { project: versions.en, isFallback: false }
      });
    } else if (versions.ar) {
      paths.push({
        params: { lang: 'en', slug: key },
        props: { project: versions.ar, isFallback: true }
      });
    }

    // Generate Arabic page
    if (versions.ar) {
      paths.push({
        params: { lang: undefined, slug: key },
        props: { project: versions.ar, isFallback: false }
      });
    } else if (versions.en) {
      paths.push({
        params: { lang: undefined, slug: key },
        props: { project: versions.en, isFallback: true }
      });
    }
  });

  return paths;
}

const { lang, slug } = Astro.params;
const { project, isFallback } = Astro.props;

if (lang !== undefined && lang !== 'en' && lang !== 'projects') {
  return Astro.redirect('/');
}

const currentLang = (lang === 'en') ? 'en' : 'ar';
const t = useTranslations(currentLang);
const pr = t.projects;

// Resolve SEO from central source ONLY (Single Source of Truth)
const seoData = await resolveDynamicSeo(currentLang, slug, 'project');

// Check if noindex should be applied (draft OR central SEO noindex flag)
const shouldNoindex = project?.draft || project?.data?.draft || seoData.noindex;

// Defensive fallbacks for optional fields
const coverImgSrc = getImageUrl(project?.data?.coverImage);

// Fetch matching services of the current category (T013)
const allServices = await ContentFacade.getServices({ lang: currentLang });
const activeServices = (allServices || []).filter((s: any) => s?.data?.category === project?.data?.category);

// Spec-sheet fields derived from real content data only
const projectYear = project?.data?.publishedDate ? new Date(project.data.publishedDate).getFullYear() : '';
const projectStack = (project?.data?.tags || []).join(' · ');
---

<Layout 
  lang={currentLang} 
  pageId={`project-${slug}`}
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage || coverImgSrc}
  canonicalUrl={seoData.canonicalUrl}
  noindex={shouldNoindex}
  contentType="project"
  slug={slug}
  pageCategory={project?.data?.category}
  isFallback={isFallback}
>
  <Navbar lang={currentLang === 'en' ? 'en' : 'ar'} activePage="projects" backUrl={currentLang === 'ar' ? '/#projects' : '/en/#projects'} backText={pr.backToProjects} />

<main class="flex-grow pt-24 md:pt-32 pb-20 relative bg-bg-primary">

    <div class="relative w-full max-w-5xl mx-auto px-6 sm:px-8">
      <div class="space-y-14 md:space-y-20">

      {isFallback && (
        <div class="rounded-lg border border-amber-500/20 bg-amber-500/5 px-4 py-3 sm:px-5 text-amber-700/90 text-xs sm:text-sm font-sans flex items-center gap-3">
          <Icon name="xmark" class="w-4 h-4 shrink-0" />
          <span>{pr.fallbackNotice}</span>
        </div>
      )}

      <!-- Case Study Masthead -->
      <header class="space-y-10 md:space-y-12">
        <div class="space-y-6 md:space-y-8 max-w-3xl">
          <span class="block font-mono text-xs uppercase tracking-widest text-text-muted">{pr.caseStudyBadge}</span>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-main leading-tight">
            {project?.data?.title}
          </h1>
        </div>

        <!-- Specification Sheet -->
        <dl class="border-y border-text-main/10 py-6 md:py-8 grid grid-cols-1 sm:grid-cols-3 gap-x-8 gap-y-6">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-text-muted">{pr.metaCategory}</dt>
            <dd class="mt-1.5 text-lg font-semibold tracking-tight text-text-main">{project?.data?.category}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-text-muted">{pr.metaYear}</dt>
            <dd class="mt-1.5 text-lg font-semibold tracking-tight text-text-main">{projectYear}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-text-muted">{pr.metaStack}</dt>
            <dd class="mt-1.5 text-lg font-semibold tracking-tight text-text-main">{projectStack}</dd>
          </div>
        </dl>

        <!-- Project Hero Cover Image -->
        {coverImgSrc && (
          <figure class="relative">
            <img
              src={coverImgSrc}
              alt={project?.data?.title || ''}
              class="w-full aspect-video sm:aspect-[21/9] object-cover block"
              width="1200"
              height="600"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
          </figure>
        )}
      </header>

      <!-- Problem / Solution -->
      <section class="grid grid-cols-1 md:grid-cols-2 items-start">
        <div class="md:pe-14 pb-10 md:pb-0">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-text-main mb-5">{pr.problemTitle}</h2>
          <p class="text-text-secondary leading-relaxed">{project?.data?.problemText}</p>
        </div>
        <div class="md:ps-14 md:border-s md:border-text-main/10">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-text-main mb-5">{pr.solutionTitle}</h2>
          <p class="text-text-secondary leading-relaxed">{project?.data?.solutionText}</p>
        </div>
      </section>

      <!-- Impact -->
      {project?.data?.impactText && (
        <section class="border-t border-text-main/10 pt-10 md:pt-12 space-y-5 max-w-3xl">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-text-main">{pr.impactTitle}</h2>
          <p class="text-text-secondary leading-relaxed">{project.data.impactText}</p>
        </section>
      )}

      <!-- PDF Interactive Viewer Section -->
      {(() => {
        const resolvedPdf = project?.data?.pdfUrl || 
          (project?.data?.galleryImages || []).find((img: any) => typeof img === 'string' && img.toLowerCase().includes('.pdf'));
        if (!resolvedPdf) return null;
        return (
          <section class="border-t border-text-main/10 pt-10 md:pt-14 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center px-2 py-0.5 rounded bg-red-500/10 text-red-500 font-bold text-[10px] tracking-wider uppercase font-mono border border-red-500/20">
                    PDF DOCUMENT
                  </span>
                  <h2 class="text-sm font-semibold uppercase tracking-widest text-text-main">
                    {currentLang === 'ar' ? 'مستند وتقرير المشروع الفني (PDF)' : 'Project Documentation & Technical Report (PDF)'}
                  </h2>
                </div>
                <p class="text-text-muted text-xs font-sans">
                  {currentLang === 'ar' ? 'يمكنك قراءة وتصفح التقرير الفني الكامل مباشرة عبر الموقع' : 'Read and browse the full technical report directly within the browser'}
                </p>
              </div>

              <div class="flex items-center gap-3 shrink-0">
                <a 
                  href={resolvedPdf} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-text-main/5 hover:bg-text-main/10 text-text-main text-xs font-semibold transition-colors border border-text-main/10 shadow-sm"
                >
                  <Icon name="arrow-down-tray" class="w-3.5 h-3.5" />
                  <span>{currentLang === 'ar' ? 'تحميل ملف PDF' : 'Download PDF File'}</span>
                </a>
              </div>
            </div>

            <div class="w-full rounded-2xl border border-text-main/15 bg-[#0d0e12] overflow-hidden shadow-2xl relative">
              <iframe 
                src={resolvedPdf.startsWith('http') ? `https://docs.google.com/viewer?url=${encodeURIComponent(resolvedPdf)}&embedded=true` : resolvedPdf} 
                class="w-full h-[550px] sm:h-[650px] md:h-[750px] border-0 bg-white" 
                title={currentLang === 'ar' ? 'عرض مستند PDF' : 'PDF Document Viewer'}
                loading="lazy"
              ></iframe>
            </div>
          </section>
        );
      })()}

      <!-- CTA -->
      <section class="border-t border-text-main/10 pt-10 md:pt-12 flex flex-col sm:flex-row sm:items-center justify-between gap-8">
        <div class="space-y-3 max-w-xl">
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-text-main">
            {pr.similarResultsHeadline}
          </h3>
          <p class="text-text-muted text-sm sm:text-base leading-relaxed font-sans font-light">
            {pr.similarResultsDesc}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 md:gap-6">
          {project?.data?.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-medium text-text-secondary hover:text-text-main transition-colors"
            >
              <Icon name="github" class="w-4 h-4" />
              <span>{pr.githubBtn}</span>
            </a>
          )}

          <a
            href={getWhatsAppUrl({ message: project?.data?.whatsappStartProjectMsg || '', lang: currentLang })}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 min-h-[48px] px-6 rounded-lg bg-success-primary hover:bg-success-hover text-white text-sm font-semibold tracking-wide transition-colors active:scale-[0.98]"
          >
            <Icon name="whatsapp" class="w-4 h-4 shrink-0" />
            <span>{pr.discussSimilarProject}</span>
          </a>
        </div>
      </section>

      <!-- Related Services -->
      {activeServices && activeServices.length > 0 && (
        <section class="max-w-3xl">
          <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">
            {pr.relatedServicesTitle}
          </h2>
          <ul class="mt-4 divide-y divide-text-main/10">
            {activeServices.map((s: any) => {
              const sSlug = s.slug.split('/').pop();
              return (
                <li>
                  <a href={currentLang === 'ar' ? `/services/${sSlug}/` : `/en/services/${sSlug}/`} class="group flex items-center justify-between gap-6 py-5">
                    <div class="space-y-1 overflow-hidden">
                      <span class="block font-mono text-xs uppercase tracking-wider text-text-muted">{t.blogPage.professionalService}</span>
                      <span class="block text-sm font-semibold text-text-main truncate group-hover:text-accent-primary transition-colors">{s?.data?.title}</span>
                    </div>
                    <svg class="w-4 h-4 text-text-muted group-hover:text-accent-primary transition-colors shrink-0 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5 15.75 12 8.25 19.5" /></svg>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      </div>
    </div>
  </main>

  <Footer lang={currentLang === 'en' ? 'en' : 'ar'} />
</Layout>
