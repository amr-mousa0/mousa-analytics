---
// Root page — SEO-safe redirect to default locale /en/
// Uses meta refresh (Google-friendly) instead of JS-only redirect
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Mousa Analytics | Data & Marketing Simplified</title>
    <meta name="description" content="Mousa Analytics: We simplify data to help business owners make the right decisions." />
    <link rel="canonical" href="https://mousaanalytics.com/en/" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <script is:inline>
      // Fallback client redirect
      window.location.replace('/en/');
    </script>
  </head>
  <body>
    <p>Redirecting to default language... <a href="/en/">click here</a> if not redirected automatically.</p>
  </body>
</html>
