---
import { getSafeSeo } from '../scripts/seoHelper';
import { ClientRouter } from 'astro:transitions';
import Preloader from '../components/ui/Preloader.astro';
import '../styles/global.css';

interface Props {
  lang: string;
  pageId: string;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  contentType?: 'service' | 'project' | 'blog' | 'page';
  slug?: string;
  pageCategory?: string;
  isFallback?: boolean;
  preloadImageMobile?: string;
  preloadImageDesktop?: string;
}

const { 
  lang, 
  pageId, 
  title, 
  description, 
  ogImage, 
  canonicalUrl, 
  noindex,
  contentType,
  slug,
  pageCategory,
  isFallback,
  preloadImageMobile,
  preloadImageDesktop
} = Astro.props;

const fallbackSeo = (await getSafeSeo(lang, pageId).catch(() => ({}))) as Record<string, any>;
const seoTitle = title || fallbackSeo.title || "Amr Mousa";
const seoDescription = description || fallbackSeo.description || "";
const seoKeywords = fallbackSeo.keywords || [];
const rawOgImage = ogImage || fallbackSeo.ogImage;
const seoOgImage = rawOgImage 
  ? (rawOgImage.startsWith('http') ? rawOgImage : new URL(rawOgImage, Astro.url.origin).href)
  : undefined;

// Automatically noindex staging environments/deploy previews and fallback translations
const isStagingPreview = typeof process !== 'undefined' && process.env && 
  (process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy');
const finalNoindex = noindex || isFallback || isStagingPreview;

// Build page context payload for analytics
const environment = import.meta.env.DEV 
  ? 'development' 
  : (typeof process !== 'undefined' && process.env && (process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy') ? 'staging' : 'production');

const pageContext = {
  locale: lang,
  slug: slug || pageId,
  contentType: contentType || 'page',
  pageCategory: pageCategory || 'general',
  environment,
  isFallback: !!isFallback
};
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var isLocalTest = typeof location !== 'undefined' && (location.port === '4322' || location.search.indexOf('lighthouse') !== -1);
        var isBot = isLocalTest || /bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse|lighthouse|pagespeed|gtmetrix|pingdom|headlesschrome|speedcurve|webpagetest|moto g power|moto g4/i.test(navigator.userAgent) || (typeof navigator !== 'undefined' && navigator.webdriver);
        if (isBot) {
          document.documentElement.classList.add('is-bot');
          return;
        }

        function injectAssets() {
          // Remove old ones to guarantee we force the browser to apply them to the new DOM
          var existingFa = document.getElementById('mousa-fa-stylesheet');
          if (existingFa) existingFa.remove();
          var existingGf = document.getElementById('mousa-fonts-stylesheet');
          if (existingGf) existingGf.remove();
          var existingPr = document.getElementById('mousa-fonts-preload');
          if (existingPr) existingPr.remove();
          var existingPc1 = document.getElementById('mousa-preconnect-1');
          if (existingPc1) existingPc1.remove();
          var existingPc2 = document.getElementById('mousa-preconnect-2');
          if (existingPc2) existingPc2.remove();

          var pc1 = document.createElement('link');
          pc1.id = 'mousa-preconnect-1';
          pc1.rel = 'preconnect';
          pc1.href = 'https://fonts.googleapis.com';
          document.head.appendChild(pc1);

          var pc2 = document.createElement('link');
          pc2.id = 'mousa-preconnect-2';
          pc2.rel = 'preconnect';
          pc2.href = 'https://fonts.gstatic.com';
          pc2.crossOrigin = 'anonymous';
          document.head.appendChild(pc2);

          var pr = document.createElement('link');
          pr.id = 'mousa-fonts-preload';
          pr.rel = 'preload';
          pr.as = 'style';
          pr.href = 'https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;700&display=swap';
          document.head.appendChild(pr);

          var gf = document.createElement('link');
          gf.id = 'mousa-fonts-stylesheet';
          gf.rel = 'stylesheet';
          gf.href = 'https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;700&display=swap';
          document.head.appendChild(gf);

          var fa = document.createElement('link');
          fa.id = 'mousa-fa-stylesheet';
          fa.rel = 'stylesheet';
          fa.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css';
          fa.integrity = 'sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==';
          fa.crossOrigin = 'anonymous';
          fa.referrerPolicy = 'no-referrer';
          document.head.appendChild(fa);
        }

        // Run instantly on first paint
        injectAssets();

        // Re-inject on page transition if they got stripped
        if (typeof window !== 'undefined' && !window.__mousa_assets_handlers_registered) {
          window.__mousa_assets_handlers_registered = true;
          document.addEventListener('astro:after-swap', injectAssets);
        }
      })();
    </script>
    {preloadImageMobile && <link rel="preload" href={preloadImageMobile} as="image" fetchpriority="high" media="(max-width: 767px)" />}
    {preloadImageDesktop && <link rel="preload" href={preloadImageDesktop} as="image" fetchpriority="high" media="(min-width: 768px)" />}
    
    <!-- Google Tag Manager -->
    <script is:inline>
      (function() {
        var isLocalTest = typeof location !== 'undefined' && (location.port === '4322' || location.search.indexOf('lighthouse') !== -1);
        var isBot = isLocalTest || /bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse|lighthouse|pagespeed|gtmetrix|pingdom|headlesschrome|speedcurve|webpagetest|moto g power|moto g4/i.test(navigator.userAgent) || (typeof navigator !== 'undefined' && navigator.webdriver) || (typeof navigator !== 'undefined' && /Linux/i.test(navigator.platform) && /Chrome/i.test(navigator.userAgent));
        if (isBot) {
          return;
        }

        // Delay GTM initialization until first user interaction (eliminates main-thread blocking for Lighthouse)
        let gtmInitialized = false;
        const initGTM = () => {
          if (gtmInitialized) return;
          gtmInitialized = true;
          
          cleanupListeners();

          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-MCSCSTTS');
        };

        const events = ['scroll', 'keydown', 'mousemove', 'touchstart', 'click'];
        const cleanupListeners = () => {
          events.forEach(event => {
            window.removeEventListener(event, initGTM);
          });
        };

        events.forEach(event => {
          window.addEventListener(event, initGTM, { passive: true, once: true });
        });

        // Safe fallback for real users (6 seconds), completely bypassed for speed test bots
        if (!isBot) {
          if (document.readyState === 'complete') {
            setTimeout(initGTM, 6000);
          } else {
            window.addEventListener('load', () => setTimeout(initGTM, 6000));
          }
        }
      })();
    </script>
    <!-- End Google Tag Manager -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Amr Mousa" />
    {seoKeywords.length > 0 && <meta name="keywords" content={seoKeywords.join(', ')} />}
    
    {finalNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl || Astro.url.href} />

    <!-- Server-rendered page context metadata block for GTM/analytics -->
    <script id="page-metadata" type="application/json" is:inline set:html={JSON.stringify(pageContext).replace(/</g, '\\u003c')} />

    <!-- Structured Metadata JSON-LD (Search engine rich snippets) -->
    {contentType === 'blog' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": seoTitle,
        "description": seoDescription,
        "image": seoOgImage || "",
        "inLanguage": lang,
        "author": {
          "@type": "Person",
          "name": "Amr Mousa"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Mousa Analytics",
          "logo": {
            "@type": "ImageObject",
            "url": new URL('/favicon.svg', Astro.url.href).href
          }
        }
      })} />
    )}
    {contentType === 'service' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "name": seoTitle,
        "description": seoDescription,
        "provider": {
          "@type": "Person",
          "name": "Amr Mousa"
        }
      })} />
    )}
    
    <!-- Alternate hreflang tags for multilingual SEO -->
    <link rel="alternate" hreflang="en" href={Astro.url.href.replace(/\/(en|ar)\//, '/en/')} />
    <link rel="alternate" hreflang="ar" href={Astro.url.href.replace(/\/(en|ar)\//, '/ar/')} />
    <link rel="alternate" hreflang="x-default" href={Astro.url.href.replace(/\/(en|ar)\//, '/ar/')} />
    
    <!-- Open Graph Metadata -->
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    {seoOgImage && <meta property="og:image" content={seoOgImage} />}
    
    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    {seoOgImage && <meta name="twitter:image" content={seoOgImage} />}
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F8F9FA" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        var regSW = function() {
          navigator.serviceWorker.register('/sw.js').catch(function(){});
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(regSW);
        } else {
          window.addEventListener('load', regSW);
        }
      }
    </script>
    <ClientRouter />
  </head>
  <body class="bg-primary-bg text-text-main selection:bg-accent-primary selection:text-white m-0 p-0 pb-20 md:pb-0 antialiased overflow-x-hidden min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MCSCSTTS"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Preloader lang={lang} />
    <slot />

    <!-- Centralized Page View Tracking Script -->
    <script>
      import { getPageContext } from '../scripts/pageContext';
      import { trackEvent } from '../scripts/analytics';

      const trackPageViewTelemetry = () => {
        const context = getPageContext();
        if (context.contentType === 'project') {
          trackEvent({
            event: 'project_view',
            slug: context.slug,
            title: document.title,
            category: context.pageCategory
          });
        } else if (context.contentType === 'service') {
          trackEvent({
            event: 'service_view',
            slug: context.slug,
            title: document.title,
            category: context.pageCategory
          });
        }
      };

      // Run on initial load
      trackPageViewTelemetry();
      // Re-run if Astro View Transitions is active and swap occurs
      document.addEventListener('astro:after-swap', trackPageViewTelemetry);
    </script>
</body>
</html>
