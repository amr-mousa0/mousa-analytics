---
import { getSafeSeo } from '../scripts/seoHelper';
import { ClientRouter } from 'astro:transitions';
import Preloader from '../components/ui/Preloader.astro';
import '../styles/global.css';

interface Props {
  lang: string;
  pageId: string;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  contentType?: 'service' | 'project' | 'blog' | 'page';
  slug?: string;
  pageCategory?: string;
  isFallback?: boolean;
  preloadImageMobile?: string;
  preloadImageDesktop?: string;
}

const { 
  lang, 
  pageId, 
  title, 
  description, 
  ogImage, 
  canonicalUrl, 
  noindex,
  contentType,
  slug,
  pageCategory,
  isFallback,
  preloadImageMobile,
  preloadImageDesktop
} = Astro.props;

const fallbackSeo = (pageId.startsWith('service-') || pageId.startsWith('project-') || pageId.startsWith('blog-')) ? {} : (await getSafeSeo(lang, pageId).catch(() => ({}))) as Record<string, any>;
const seoTitle = title || fallbackSeo.title || "Amr Mousa";
const seoDescription = description || fallbackSeo.description || "";
const seoKeywords = fallbackSeo.keywords || [];
const rawOgImage = ogImage || fallbackSeo.ogImage;
const seoOgImage = rawOgImage 
  ? (rawOgImage.startsWith('http') ? rawOgImage : new URL(rawOgImage, Astro.site).href)
  : undefined;

// Automatically noindex staging environments/deploy previews and fallback translations
const isStagingPreview = typeof process !== 'undefined' && process.env && 
  (process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy');
const finalNoindex = noindex || isFallback || isStagingPreview;

// Dynamic domain-safe canonical URL
const canonicalPath = Astro.url.pathname;
const cleanCanonicalUrl = canonicalUrl || new URL(canonicalPath, Astro.site).href;

// Alternate hreflangs
const isUnlocalized = canonicalPath.includes('/404') || canonicalPath.includes('/admin') || finalNoindex;

const getHreflangUrl = (targetLang: string) => {
  const parts = canonicalPath.split('/').filter(Boolean);
  if (parts.length > 0 && (parts[0] === 'ar' || parts[0] === 'en')) {
    parts[0] = targetLang;
  } else {
    parts.unshift(targetLang);
  }
  return new URL('/' + parts.join('/') + '/', Astro.site).href;
};

const hreflangAr = isUnlocalized ? null : getHreflangUrl('ar');
const hreflangEn = isUnlocalized ? null : getHreflangUrl('en');
const hreflangDefault = isUnlocalized ? null : getHreflangUrl('ar');

// Env variables for analytics and verification
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || (typeof process !== 'undefined' && process.env ? process.env.PUBLIC_GOOGLE_SITE_VERIFICATION : '');
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || (typeof process !== 'undefined' && process.env ? process.env.PUBLIC_CLARITY_ID : '');
const gtmId = import.meta.env.PUBLIC_GTM_ID || (typeof process !== 'undefined' && process.env ? process.env.PUBLIC_GTM_ID : 'GTM-MCSCSTTS');

// Build page context payload for analytics
const environment = import.meta.env.DEV 
  ? 'development' 
  : (typeof process !== 'undefined' && process.env && (process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy') ? 'staging' : 'production');

const pageContext = {
  locale: lang,
  slug: slug || pageId,
  contentType: contentType || 'page',
  pageCategory: pageCategory || 'general',
  environment,
  isFallback: !!isFallback
};

// Global Schema Graph
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL(`${lang}/#website`, Astro.site).href,
      "url": new URL(`${lang}/`, Astro.site).href,
      "name": "Mousa Analytics",
      "description": lang === 'ar' ? 'تحليلات وحلول الأعمال المتقدمة' : 'Advanced Analytics & Business Solutions',
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": new URL(`${lang}/#organization`, Astro.site).href,
      "url": new URL(`${lang}/`, Astro.site).href,
      "name": "Mousa Analytics",
      "logo": {
        "@type": "ImageObject",
        "url": new URL('favicon.svg', Astro.site).href
      },
      "sameAs": [
        "https://www.linkedin.com/in/amr-mousa-063991206"
      ]
    },
    {
      "@type": "Person",
      "@id": new URL(`${lang}/#person`, Astro.site).href,
      "name": "Amr Mousa",
      "jobTitle": lang === 'ar' ? 'استشاري تحليلات ونظم أعمال' : 'Analytics & Business Systems Consultant',
      "url": new URL(`${lang}/about/`, Astro.site).href,
      "sameAs": [
        "https://www.linkedin.com/in/amr-mousa-063991206",
        "https://github.com/amr-mousa0"
      ],
      "worksFor": {
        "@id": new URL(`${lang}/#organization`, Astro.site).href
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": lang === 'ar' ? 'جامعة عين شمس' : 'Ain Shams University'
        }
      ]
    }
  ]
};

// Dynamic Breadcrumb Schema
const pathSegments = canonicalPath.split('/').filter(Boolean);
const breadcrumbs = [];
if (pathSegments.length > 0) {
  const currentLang = pathSegments[0];
  breadcrumbs.push({
    "@type": "ListItem",
    "position": 1,
    "name": currentLang === 'ar' ? 'الرئيسية' : 'Home',
    "item": new URL(`${currentLang}/`, Astro.site).href
  });

  let accumulatedPath = `/${currentLang}/`;
  for (let i = 1; i < pathSegments.length; i++) {
    const segment = pathSegments[i];
    accumulatedPath += `${segment}/`;
    
    let displayName = segment;
    if (segment === 'services') displayName = currentLang === 'ar' ? 'الخدمات' : 'Services';
    else if (segment === 'projects') displayName = currentLang === 'ar' ? 'المشاريع' : 'Projects';
    else if (segment === 'blog') displayName = currentLang === 'ar' ? 'المدونة' : 'Blog';
    else if (segment === 'about') displayName = currentLang === 'ar' ? 'من أنا' : 'About';
    else if (segment === 'terms') displayName = currentLang === 'ar' ? 'الشروط والأحكام' : 'Terms & Conditions';
    else if (segment === 'privacy') displayName = currentLang === 'ar' ? 'سياسة الخصوصية' : 'Privacy Policy';
    else {
      displayName = segment.replace(/-/g, ' ');
      displayName = displayName.charAt(0).toUpperCase() + displayName.slice(1);
    }

    breadcrumbs.push({
      "@type": "ListItem",
      "position": i + 1,
      "name": displayName,
      "item": new URL(accumulatedPath, Astro.site).href
    });
  }
}

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs
} : null;
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    
    <!-- Static Preconnect and Prefetch for Google Fonts and FontAwesome Stylesheets (T008) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;700&display=swap" as="style" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;700&display=swap" />
    </noscript>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    {preloadImageMobile && <link rel="preload" href={preloadImageMobile} as="image" fetchpriority="high" media="(max-width: 767px)" />}
    {preloadImageDesktop && <link rel="preload" href={preloadImageDesktop} as="image" fetchpriority="high" media="(min-width: 768px)" />}
    
    <!-- Deferred Google Tag Manager & Microsoft Clarity Tracking Script (T009, T022) -->
    <script is:inline define:vars={{ gtmId, clarityId }}>
      (function() {
        var isLocalTest = typeof location !== 'undefined' && (location.port === '4322' || location.search.indexOf('lighthouse') !== -1);
        var isBot = isLocalTest || /bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse|lighthouse|pagespeed|gtmetrix|pingdom|headlesschrome|speedcurve|webpagetest|moto g power|moto g4/i.test(navigator.userAgent) || (typeof navigator !== 'undefined' && navigator.webdriver);
        
        if (isBot) return;

        var trackingInitialized = false;
        
        function initTracking() {
          if (trackingInitialized) return;
          trackingInitialized = true;
          
          cleanupListeners();

          // Initialize GTM
          if (gtmId) {
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer',gtmId);
          }

          // Initialize Microsoft Clarity
          if (clarityId) {
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window,document,"clarity","script",clarityId);
          }
        }

        var events = ['scroll', 'keydown', 'mousemove', 'touchstart', 'click'];
        function cleanupListeners() {
          events.forEach(function(event) {
            window.removeEventListener(event, initTracking);
          });
        }

        // Add user interaction listeners
        events.forEach(function(event) {
          window.addEventListener(event, initTracking, { passive: true, once: true });
        });

        // Deferred loading on page idle or load
        var scheduleIdleLoad = function() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(function() {
              setTimeout(initTracking, 2000);
            });
          } else {
            setTimeout(initTracking, 3000);
          }
        };

        if (document.readyState === 'complete') {
          scheduleIdleLoad();
        } else {
          window.addEventListener('load', scheduleIdleLoad);
        }
      })();
    </script>

    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Amr Mousa" />
    {seoKeywords.length > 0 && <meta name="keywords" content={seoKeywords.join(', ')} />}
    
    {finalNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={cleanCanonicalUrl} />

    <!-- Server-rendered page context metadata block for GTM/analytics -->
    <script id="page-metadata" type="application/json" is:inline set:html={JSON.stringify(pageContext).replace(/</g, '\\u003c')} />

    <!-- Global Structured Data (Organization, Person, WebSite) (T005 & T006) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph).replace(/</g, '\\u003c')} />

    <!-- Breadcrumbs Structured Data (T007) -->
    {breadcrumbSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')} />
    )}

    <!-- Structured Metadata JSON-LD (Search engine rich snippets) -->
    {contentType === 'blog' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": seoTitle,
        "description": seoDescription,
        "image": seoOgImage || "",
        "inLanguage": lang,
        "author": {
          "@type": "Person",
          "name": "Amr Mousa",
          "@id": new URL(`${lang}/#person`, Astro.site).href
        },
        "publisher": {
          "@type": "Organization",
          "@id": new URL(`${lang}/#organization`, Astro.site).href
        }
      })} />
    )}
    {contentType === 'service' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "name": seoTitle,
        "description": seoDescription,
        "provider": {
          "@type": "Person",
          "@id": new URL(`${lang}/#person`, Astro.site).href
        }
      })} />
    )}
    
    <!-- Alternate hreflang tags for multilingual SEO (T004) -->
    {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
    {hreflangAr && <link rel="alternate" hreflang="ar" href={hreflangAr} />}
    {hreflangDefault && <link rel="alternate" hreflang="x-default" href={hreflangDefault} />}
    
    <!-- Open Graph Metadata -->
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={cleanCanonicalUrl} />
    <meta property="og:type" content="website" />
    {seoOgImage && <meta property="og:image" content={seoOgImage} />}
    
    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    {seoOgImage && <meta name="twitter:image" content={seoOgImage} />}
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F8F9FA" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        var regSW = function() {
          navigator.serviceWorker.register('/sw.js').catch(function(){});
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(regSW);
        } else {
          window.addEventListener('load', regSW);
        }
      }
    </script>
    <ClientRouter />
  </head>
  <body class="bg-primary-bg text-text-main selection:bg-accent-primary selection:text-white m-0 p-0 pb-20 md:pb-0 antialiased overflow-x-hidden min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->
    <Preloader lang={lang} />
    <slot />

    <!-- Centralized Page View Tracking Script -->
    <script>
      import { getPageContext } from '../scripts/pageContext';
      import { trackEvent } from '../scripts/analytics';

      const trackPageViewTelemetry = () => {
        const context = getPageContext();
        if (context.contentType === 'project') {
          trackEvent({
            event: 'project_view',
            slug: context.slug,
            title: document.title,
            category: context.pageCategory
          });
        } else if (context.contentType === 'service') {
          trackEvent({
            event: 'service_view',
            slug: context.slug,
            title: document.title,
            category: context.pageCategory
          });
        }
      };

      // Run on initial load
      trackPageViewTelemetry();
      // Re-run if Astro View Transitions is active and swap occurs
      document.addEventListener('astro:after-swap', trackPageViewTelemetry);
    </script>
</body>
</html>
