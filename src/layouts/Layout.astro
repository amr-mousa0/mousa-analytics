---
import { getSafeSeo } from '../scripts/seoHelper';
import { ClientRouter } from 'astro:transitions';
import Preloader from '../components/ui/Preloader.astro';
import ContactModalInit from '../components/ui/ContactModalInit.astro';
import DesktopContactModalInit from '../components/ui/DesktopContactModalInit.astro';
import { getLocaleDirectionContext } from '../lib/i18n/direction';
import { BRAND_CONSTANTS } from '../lib/constants/brand.constants';
import '../styles/global.css';

interface Props {
  lang: string;
  pageId: string;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  contentType?: 'service' | 'project' | 'blog' | 'page';
  slug?: string;
  pageCategory?: string;
  isFallback?: boolean;
  preloadImageMobile?: string;
  preloadImageDesktop?: string;
}

const { 
  lang, 
  pageId, 
  title, 
  description, 
  ogImage, 
  canonicalUrl, 
  noindex,
  contentType,
  slug,
  pageCategory,
  isFallback,
  preloadImageMobile,
  preloadImageDesktop
} = Astro.props;

const dirContext = getLocaleDirectionContext(lang);
const defaultBrandName = dirContext.isRtl ? BRAND_CONSTANTS.PRIMARY_BRAND_AR : BRAND_CONSTANTS.PRIMARY_BRAND_EN;

const fallbackSeo = (pageId.startsWith('service-') || pageId.startsWith('project-') || pageId.startsWith('blog-')) ? {} : (await getSafeSeo(lang, pageId).catch(() => ({}))) as Record<string, any>;
const seoTitle = title || fallbackSeo.title || defaultBrandName;
const seoDescription = description || fallbackSeo.description || "";
const seoKeywords = fallbackSeo.keywords || [];
const rawOgImage = ogImage || fallbackSeo.ogImage || '/images/og-image.png';
const seoOgImage = rawOgImage 
  ? (rawOgImage.startsWith('http') ? rawOgImage : new URL(rawOgImage, Astro.site).href)
  : undefined;

// Automatically noindex staging environments/deploy previews and fallback translations
const isStagingPreview = typeof process !== 'undefined' && process.env && 
  (process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy');
const finalNoindex = noindex || isFallback || isStagingPreview;

// Dynamic domain-safe canonical URL
let canonicalPath = Astro.url.pathname;
if (!canonicalPath.endsWith('/')) {
  canonicalPath += '/';
}
const cleanCanonicalUrl = canonicalUrl || new URL(canonicalPath, Astro.site).href;

// Alternate hreflangs
const isUnlocalized = canonicalPath.includes('/404') || canonicalPath.includes('/admin') || finalNoindex;

const getLocalizedPath = (targetLang: string) => {
  const hasEnPrefix = canonicalPath.startsWith('/en/');
  const isEnRoot = canonicalPath === '/en' || canonicalPath === '/en/';
  
  if (targetLang === 'en') {
    if (hasEnPrefix || isEnRoot) {
      return canonicalPath;
    }
    return canonicalPath === '/' ? '/en/' : `/en${canonicalPath}`;
  } else {
    if (hasEnPrefix) {
      return canonicalPath.substring(3);
    }
    if (isEnRoot) {
      return '/';
    }
    return canonicalPath;
  }
};

const hreflangAr = isUnlocalized ? null : new URL(getLocalizedPath('ar'), Astro.site).href;
const hreflangEn = isUnlocalized ? null : new URL(getLocalizedPath('en'), Astro.site).href;
const hreflangDefault = hreflangAr;

// Env variables for analytics and verification
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || (typeof process !== 'undefined' && process.env ? process.env.PUBLIC_GOOGLE_SITE_VERIFICATION : '');
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || (typeof process !== 'undefined' && process.env ? process.env.PUBLIC_CLARITY_ID : '');
const gtmId = import.meta.env.PUBLIC_GTM_ID || (typeof process !== 'undefined' && process.env ? process.env.PUBLIC_GTM_ID : 'GTM-MCSCSTTS');

// Build page context payload for analytics
const environment = import.meta.env.DEV 
  ? 'development' 
  : (typeof process !== 'undefined' && process.env && (process.env.CONTEXT === 'deploy-preview' || process.env.CONTEXT === 'branch-deploy') ? 'staging' : 'production');

const pageContext = {
  locale: lang,
  slug: slug || pageId,
  contentType: contentType || 'page',
  pageCategory: pageCategory || 'general',
  environment,
  isFallback: !!isFallback
};

const langPath = lang === 'ar' ? '' : 'en/';
const modalLang: 'en' | 'ar' = lang === 'ar' ? 'ar' : 'en';

// Global Schema Graph
const graph = [];

// 1. WebSite Schema (Homepage ONLY to prevent duplication and satisfy Google rules)
if (pageId === 'homepage') {
  graph.push({
    "@type": "WebSite",
    "@id": new URL(`${langPath}#website`, Astro.site).href,
    "url": new URL(`${langPath}`, Astro.site).href,
    "name": defaultBrandName,
    "alternateName": [BRAND_CONSTANTS.PRIMARY_BRAND_EN, BRAND_CONSTANTS.PRIMARY_BRAND_AR],
    "description": lang === 'ar' ? 'تحليلات وحلول الأعمال المتقدمة' : 'Advanced Analytics & Business Solutions',
    "inLanguage": lang
  });
}

// 2. ProfessionalService Schema (Replaces Organization to unify SEO signals)
graph.push({
  "@type": "ProfessionalService",
  "@id": new URL(`${langPath}#organization`, Astro.site).href,
  "url": new URL(`${langPath}`, Astro.site).href,
  "name": defaultBrandName,
  "logo": {
    "@type": "ImageObject",
    "url": new URL('favicon-192x192.png', Astro.site).href
  },
  "image": new URL('images/og-image.png', Astro.site).href,
  "description": lang === 'ar' 
    ? "موسى لتحليل البيانات: خيارك الأفضل لخدمات تحليل البيانات والميديا باينج لتضاعف أرباح مشروعك."
    : "Mousa Analytics: Your premier choice for data analytics and media buying services to scale your business.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Cairo",
    "addressCountry": "EG"
  },
  "telephone": "+201017749925",
  "priceRange": "$$$",
  "sameAs": [
    "https://www.linkedin.com/in/amr-mousa0"
  ]
});

// 3. Person Schema
graph.push({
  "@type": "Person",
  "@id": new URL(`${langPath}#person`, Astro.site).href,
  "name": "Amr Mousa",
  "jobTitle": lang === 'ar' ? 'محلل بيانات وتسويق' : 'Data & Marketing Analyst',
  "url": new URL(`${langPath}about/`, Astro.site).href,
  "sameAs": [
    "https://www.linkedin.com/in/amr-mousa0",
    "https://github.com/amr-mousa0"
  ],
  "worksFor": {
    "@id": new URL(`${langPath}#organization`, Astro.site).href
  },
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": lang === 'ar' ? 'جامعة عين شمس' : 'Ain Shams University'
    }
  ]
});

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": graph
};

// Dynamic Breadcrumb Schema
const pathSegments = canonicalPath.split('/').filter(Boolean);
const breadcrumbs = [];

breadcrumbs.push({
  "@type": "ListItem",
  "position": 1,
  "name": lang === 'ar' ? 'الرئيسية' : 'Home',
  "item": new URL(lang === 'ar' ? '/' : '/en/', Astro.site).href
});

const startIndex = lang === 'en' ? 1 : 0;
let accumulatedPath = lang === 'en' ? '/en/' : '/';

for (let i = startIndex; i < pathSegments.length; i++) {
  const segment = pathSegments[i];
  accumulatedPath += `${segment}/`;
  
  let displayName = segment;
  if (segment === 'services') displayName = lang === 'ar' ? 'الخدمات' : 'Services';
  else if (segment === 'projects') displayName = lang === 'ar' ? 'المشاريع' : 'Projects';
  else if (segment === 'blog') displayName = lang === 'ar' ? 'المدونة' : 'Blog';
  else if (segment === 'about') displayName = lang === 'ar' ? 'من أنا' : 'About';
  else if (segment === 'terms') displayName = lang === 'ar' ? 'الشروط والأحكام' : 'Terms & Conditions';
  else if (segment === 'privacy') displayName = lang === 'ar' ? 'سياسة الخصوصية' : 'Privacy Policy';
  else {
    displayName = segment.replace(/-/g, ' ');
    displayName = displayName.charAt(0).toUpperCase() + displayName.slice(1);
  }

  breadcrumbs.push({
    "@type": "ListItem",
    "position": breadcrumbs.length + 1,
    "name": displayName,
    "item": new URL(accumulatedPath, Astro.site).href
  });
}

const breadcrumbSchema = breadcrumbs.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs
} : null;
---

<!doctype html>
<html lang={dirContext.htmlLang} dir={dirContext.htmlDir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    {preloadImageMobile && <link rel="preload" href={preloadImageMobile} as="image" fetchpriority="high" media="(max-width: 767px)" />}
    {preloadImageDesktop && <link rel="preload" href={preloadImageDesktop} as="image" fetchpriority="high" media="(min-width: 768px)" />}

    <!-- Web Fonts: self-hosted + preload + non-blocking (never blocks first paint; font-display: swap) -->
    {pageId === 'about' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      </>
    )}
    <!-- Preload the exact subsets used above the fold (Cairo arabic for the AR hero/text,
         Outfit latin for the EN+AR body/nav, Cormorant Garamond latin for the EN hero display). -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cairo-400-1.woff2" />
    {lang === 'en' ? (
      <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cormorant-garamond-600-14.woff2" />
    ) : (
      <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/outfit-400-42.woff2" />
    )}
    <style is:inline>{`
      /* Hero title @font-face inlined (parsed at HTML parse, no stylesheet round-trip):
         the LCP text uses its final font at first paint. */
      @font-face {
        font-family: 'Cairo';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/cairo-400-1.woff2') format('woff2');
        unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EE03, U+1EE05-1EE1F, U+1EE21-1EE22, U+1EE24, U+1EE27, U+1EE29-1EE32, U+1EE34-1EE37, U+1EE39, U+1EE3B, U+1EE42, U+1EE47, U+1EE49, U+1EE4B, U+1EE4D-1EE4F, U+1EE51-1EE52, U+1EE54, U+1EE57, U+1EE59, U+1EE5B, U+1EE5D, U+1EE5F, U+1EE61-1EE62, U+1EE64, U+1EE67-1EE6A, U+1EE6C-1EE72, U+1EE74-1EE77, U+1EE79-1EE7C, U+1EE7E, U+1EE80-1EE89, U+1EE8B-1EE9B, U+1EEA1-1EEA3, U+1EEA5-1EEA9, U+1EEAB-1EEBB, U+1EEF0-1EEF1;
      }
      @font-face {
        font-family: 'Outfit';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/outfit-400-42.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/cormorant-garamond-600-14.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    `}</style>
    <link
      rel="stylesheet"
      href="/fonts/fonts.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="/fonts/fonts.css" />
    </noscript>
    {pageId === 'about' && (
      <>
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Alexandria:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@600;700&display=swap"
          media="print"
          onload="this.media='all'"
        />
        <noscript>
          <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alexandria:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@600;700&display=swap" />
        </noscript>
      </>
    )}

    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content="Amr Mousa" />
    {seoKeywords.length > 0 && <meta name="keywords" content={seoKeywords.join(', ')} />}
    
    {finalNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={cleanCanonicalUrl} />

    <!-- Server-rendered page context metadata block for GTM/analytics -->
    <script id="page-metadata" type="application/json" is:inline set:html={JSON.stringify(pageContext).replace(/</g, '\\u003c')} />

    <!-- Global Structured Data (Organization, Person, WebSite) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph).replace(/</g, '\\u003c')} />

    <!-- Breadcrumbs Structured Data -->
    {breadcrumbSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')} />
    )}

    <!-- Structured Metadata JSON-LD (Search engine rich snippets) -->
    {contentType === 'blog' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": seoTitle,
        "description": seoDescription,
        "image": seoOgImage || "",
        "inLanguage": lang,
        "author": {
          "@type": "Person",
          "name": "Amr Mousa",
          "@id": new URL(`${langPath}#person`, Astro.site).href
        },
        "publisher": {
          "@type": "Organization",
          "@id": new URL(`${langPath}#organization`, Astro.site).href
        }
      })} />
    )}
    {contentType === 'service' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        "name": seoTitle,
        "description": seoDescription,
        "image": seoOgImage || "",
        "provider": {
          "@type": "Person",
          "@id": new URL(`${langPath}#person`, Astro.site).href
        }
      })} />
    )}
    
    <!-- Alternate hreflang tags for multilingual SEO -->
    {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
    {hreflangAr && <link rel="alternate" hreflang="ar" href={hreflangAr} />}
    {hreflangDefault && <link rel="alternate" hreflang="x-default" href={hreflangDefault} />}
    
    <!-- Search Branding & Site Name Signals -->
    <meta property="og:site_name" content={defaultBrandName} />
    <meta name="application-name" content={defaultBrandName} />
    <meta name="apple-mobile-web-app-title" content={defaultBrandName} />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={cleanCanonicalUrl} />
    <meta property="og:type" content={contentType === 'blog' ? 'article' : 'website'} />
    {seoOgImage && <meta property="og:image" content={seoOgImage} />}
    
    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    {seoOgImage && <meta name="twitter:image" content={seoOgImage} />}
    
    <!-- Multi-format Favicons & Apple Touch Icon -->
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F8F9FA" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        var regSW = function() {
          navigator.serviceWorker.register('/sw.js').catch(function(){});
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(regSW);
        } else {
          window.addEventListener('load', regSW);
        }
      }
    </script>
    <ClientRouter />
  </head>
  <body class="bg-primary-bg text-text-main selection:bg-accent-primary selection:text-white m-0 p-0 antialiased overflow-x-hidden min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->
    <Preloader lang={lang} />
    <slot />

    <!-- Contact modal controllers: emitted at the end of <body> on purpose so
         their ~17KB of client logic never blocks the parser near the top of
         the page (markup itself lives in the Navbar). -->
    <ContactModalInit lang={modalLang} />
    <DesktopContactModalInit lang={modalLang} />

    <!-- Centralized Page View Tracking Script -->
    <script>
      import { getPageContext } from '../scripts/pageContext';
      import { trackEvent } from '../scripts/analytics';

      const trackPageViewTelemetry = () => {
        const context = getPageContext();
        if (context.contentType === 'project') {
          trackEvent({
            event: 'project_view',
            slug: context.slug,
            title: document.title,
            category: context.pageCategory
          });
        } else if (context.contentType === 'service') {
          trackEvent({
            event: 'service_view',
            slug: context.slug,
            title: document.title,
            category: context.pageCategory
          });
        }
      };

      // Run on initial load
      trackPageViewTelemetry();
      // Re-run if Astro View Transitions is active and swap occurs
      document.addEventListener('astro:after-swap', trackPageViewTelemetry);
    </script>

    <!-- Deferred Tracking & Analytics Hydration (GTM & Microsoft Clarity) -->
    <script is:inline define:vars={{ gtmId, clarityId }}>
      (function(){var t=typeof location!="undefined"&&(location.port==="4322"||location.port==="4323"||location.search.indexOf("lighthouse")!==-1),e=t||/bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse|lighthouse|pagespeed|gtmetrix|pingdom|headlesschrome|speedcurve|webpagetest|moto g power|moto g4/i.test(navigator.userAgent)||(typeof navigator!="undefined"&&navigator.webdriver);if(e)return;var n=false;function o(){if(n)return;n=true;r();if(gtmId){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer',gtmId)}if(clarityId){(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script",clarityId)}}var i=["scroll","keydown","mousemove","touchstart","click"];function r(){i.forEach(function(t){window.removeEventListener(t,o)})}i.forEach(function(t){window.addEventListener(t,o,{passive:true,once:true})});var a=function(){if("requestIdleCallback"in window){requestIdleCallback(function(){setTimeout(o,2000)})}else{setTimeout(o,3000)}};if(document.readyState==="complete"){a()}else{window.addEventListener("load",a)}})();
    </script>
</body>
</html>
