---
import { getEntry } from 'astro:content';

interface Props {
  lang: string;
  pageId: string;
}

const { lang, pageId } = Astro.props;

// Defensive rendering fallback values
let seoTitle = "Amr Mousa | Data Analyst & Marketer";
let seoDescription = "Data analyst and digital marketing strategist portfolio.";
let seoKeywords: string[] = [];
let seoOgImage = "";

try {
  const seoEntry = await getEntry('seo', `${lang}/${pageId}`);
  if (seoEntry && seoEntry.data) {
    seoTitle = seoEntry.data.title;
    seoDescription = seoEntry.data.description;
    seoKeywords = seoEntry.data.keywords || [];
    seoOgImage = seoEntry.data.ogImage || "";
  }
} catch (error) {
  console.warn(`[Defensive Rendering] SEO fetching failed for ${lang}/${pageId}. Using default values.`, error);
}
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    {seoKeywords.length > 0 && <meta name="keywords" content={seoKeywords.join(', ')} />}
    
    <!-- Open Graph Metadata -->
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    {seoOgImage && <meta property="og:image" content={seoOgImage} />}
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body class="bg-neutral-950 text-neutral-50 selection:bg-teal-500 selection:text-neutral-900 m-0 p-0 antialiased overflow-x-hidden min-h-screen flex flex-col">
    <slot />
  </body>
</html>
