---
import powerBiImg from '../../assets/images/power bi.webp';
import mediaBuyingImg from '../../assets/images/media-buying.webp';
import crmImg from '../../assets/images/Crm.webp';
import portfolioImg from '../../assets/images/Portfolio.webp';
import amrMousaAvatar from '../../assets/images/amr-mousa.webp';
import Icon from '../ui/Icon.astro';
import { useTranslations } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="visual-collage" class="visual-collage-section w-full relative overflow-hidden bg-primary-bg py-10 sm:py-18 md:py-28 border-b border-text-main/5 select-none min-h-[500px] sm:min-h-[640px] md:min-h-[850px] flex items-center justify-center">
  <!-- Background Ambient Radial Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.06)_0%,transparent_70%)] pointer-events-none" aria-hidden="true"></div>

  <!-- Central Anchor Title -->
  <div class="absolute inset-0 z-[1] flex flex-col items-center justify-center text-center px-4 pointer-events-none">
    <h2 class="collage-title opacity-0 text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-text-main tracking-tighter leading-[1.12] drop-shadow-sm whitespace-pre-line select-none max-w-4xl mx-auto">
      {t.hero.collageTitle}
    </h2>
  </div>

  <!-- Perfectly Balanced Floating Canvas Layout -->
  <div class="relative z-10 w-full max-w-[1400px] mx-auto min-h-[480px] sm:min-h-[620px] md:min-h-[830px]">
    
    <!-- 1. Top-Left: Image Card with CAPI Glass Overlay -->
    <div class="collage-card-left opacity-0 absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="left: 4.5%; top: 4%; width: clamp(130px, 24vw, 340px); height: clamp(95px, 17vw, 250px); z-index: 5;">
      <img src={powerBiImg.src} alt="" class="w-full h-full object-cover opacity-90" />
      <div class="absolute bottom-2 left-2 right-2 sm:bottom-3 sm:left-3 sm:right-3 bg-hero-card/90 backdrop-blur-2xl border border-text-main/15 rounded-xl sm:rounded-2xl p-1.5 sm:p-3 shadow-lg">
        <div class="flex justify-between items-center mb-1">
          <span class="font-mono text-[7px] sm:text-[9px] text-text-main font-bold uppercase tracking-wider truncate">{t.hero.collageTagCapi}</span>
          <span class="font-mono text-[7px] sm:text-[9px] text-accent-primary font-bold shrink-0">99.4%</span>
        </div>
        <div class="w-full bg-text-main/10 rounded-full h-1 sm:h-1.5 overflow-hidden">
          <div class="bg-accent-primary w-[99.4%] h-full rounded-full"></div>
        </div>
      </div>
    </div>

    <!-- 2. Top-Right: Image Card with Chart Icon -->
    <div class="collage-card-right opacity-0 absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="right: 4.5%; top: 5%; width: clamp(125px, 22vw, 310px); height: clamp(125px, 23vw, 330px); z-index: 5;">
      <img src={mediaBuyingImg.src} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-90" />
      <div class="absolute top-2 right-2 sm:top-3 sm:right-3 w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-hero-card/80 backdrop-blur-md border border-text-main/20 flex items-center justify-center shadow-sm text-accent-primary">
        <Icon name="chart-line" class="w-3 h-3 sm:w-4 sm:h-4" />
      </div>
      <div class="absolute bottom-2 left-2 right-2 sm:bottom-3 sm:left-3 sm:right-3 bg-hero-card/90 backdrop-blur-xl border border-text-main/15 px-2 py-1 sm:px-3 sm:py-1.5 rounded-full shadow-sm text-center">
        <span class="font-mono text-[7px] sm:text-[9px] font-bold text-text-main uppercase tracking-wider truncate block">{t.hero.collageTagRoas}</span>
      </div>
    </div>

    <!-- 3. Mid-Left: Floating Glass Auto-Sync Switch -->
    <div class="collage-card-left opacity-0 absolute rounded-xl sm:rounded-2xl overflow-hidden bg-hero-card/90 backdrop-blur-2xl border border-text-main/20 shadow-xl p-2 sm:p-3.5 flex flex-col gap-1 sm:gap-2.5 transition-transform duration-500 hover:scale-105" 
         style="left: 2.5%; top: 44%; width: clamp(125px, 20vw, 275px); z-index: 30;">
      <div class="flex items-center justify-between">
        <span class="font-sans text-[8px] sm:text-xs font-bold text-text-main truncate max-w-[75%]">{t.hero.collageAutoSyncTitle}</span>
        <div class="w-5 h-3 sm:w-8 sm:h-4.5 bg-accent-primary rounded-full relative shadow-inner shrink-0">
          <div class="absolute right-0.5 top-0.5 w-2 h-2 sm:w-3.5 sm:h-3.5 bg-white rounded-full shadow-sm"></div>
        </div>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <div class="w-5 h-5 sm:w-8 sm:h-8 rounded-full bg-accent-primary/10 text-accent-primary flex items-center justify-center shrink-0">
          <Icon name="rotate" class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5" />
        </div>
        <div class="flex flex-col overflow-hidden">
          <span class="font-mono text-[7px] sm:text-[10px] font-bold text-text-main truncate">Meta CAPI & GA4</span>
          <span class="font-sans text-[6px] sm:text-[9px] text-text-main/70 truncate">{t.hero.collageAutoSyncStatus}</span>
        </div>
      </div>
    </div>

    <!-- 4. Mid-Right: Image Card with CRM Badge -->
    <div class="collage-card-right opacity-0 absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="right: 3%; top: 48%; width: clamp(130px, 23vw, 330px); height: clamp(90px, 16vw, 230px); z-index: 30;">
      <img src={crmImg.src} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-90" />
      <div class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-hero-card/90 backdrop-blur-xl px-2 py-1 sm:px-3 sm:py-1.5 rounded-full border border-text-main/15 shadow-sm flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-success-primary animate-pulse"></span>
        <span class="font-mono text-[7px] sm:text-[9px] font-bold text-text-main uppercase tracking-wider truncate">{t.hero.collageTagCrm}</span>
      </div>
    </div>

    <!-- 5. Bottom-Left: Conversion Funnel Image Card -->
    <div class="collage-card-left opacity-0 absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="left: 8.5%; top: 72%; width: clamp(135px, 24vw, 370px); height: clamp(95px, 17vw, 250px); z-index: 5;">
      <img src={portfolioImg.src} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-90" />
      <div class="absolute bottom-2 left-2 sm:bottom-3 sm:left-3 bg-hero-card/90 backdrop-blur-xl px-2 py-1 sm:px-3 sm:py-1.5 rounded-full border border-text-main/15 shadow-sm flex items-center gap-1 text-accent-primary">
        <Icon name="sliders" class="w-2.5 h-2.5 sm:w-3 sm:h-3" />
        <span class="font-mono text-[7px] sm:text-[9px] font-bold text-text-main uppercase tracking-wider truncate">{t.hero.collageTagFunnel}</span>
      </div>
    </div>

    <!-- 6. Bottom-Right: Wide Preview Card -->
    <div class="collage-card-right opacity-0 absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="right: 8.5%; top: 76%; width: clamp(130px, 23vw, 350px); height: clamp(90px, 16vw, 230px); z-index: 5;">
      <img src={powerBiImg.src} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-90" />
    </div>

    <!-- 7. Bottom Center: Floating Profile Pill Badge (Top Layer z-40) -->
    <div class="collage-card-bottom opacity-0 absolute bg-hero-card/95 backdrop-blur-2xl rounded-full flex items-center gap-2 sm:gap-3 px-3 py-1.5 sm:px-4 sm:py-2 shadow-2xl border border-text-main/20 z-40 transition-transform duration-500 hover:scale-105" 
         style="left: 50%; top: 90%; transform: translateX(-50%); width: max-content;">
      <div class="w-6 h-6 sm:w-9 sm:h-9 rounded-full overflow-hidden shadow-sm border border-accent-primary/40 shrink-0">
        <img src={amrMousaAvatar.src} alt="Amr Mousa" class="w-full h-full object-cover" />
      </div>
      <div class="flex flex-col pr-1.5 sm:pr-2.5 text-start">
        <span class="font-sans text-[9px] sm:text-[11px] text-text-main font-bold">{t.hero.collageProfileName}</span>
        <span class="font-sans text-[8px] sm:text-[11px] text-accent-primary font-semibold leading-tight">{t.hero.collageProfileQuote}</span>
      </div>
    </div>

  </div>
</section>

<script>
  const initCollageAnimation = async () => {
    const section = document.querySelector('.visual-collage-section');
    if (!section || !document.documentElement.contains(section)) return;

    // GSAP is fetched only when the collage actually approaches the viewport;
    // the section's cards/title are hidden by their SSR opacity-0 classes, so
    // nothing is ever visible before this engine takes over.
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);
    if (!document.documentElement.contains(section)) return;

    const leftCards = section.querySelectorAll('.collage-card-left');
    const rightCards = section.querySelectorAll('.collage-card-right');
    const bottomCard = section.querySelector('.collage-card-bottom');
    const title = section.querySelector('.collage-title');

    // Scroll-Driven Scrub Animation (Links animation 1:1 to Scroll Position in BOTH directions)
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 85%',
        end: 'center 45%',
        scrub: 1, // Smooth 1-second scrub response on scroll down AND scroll back up
      }
    });

    // 1. Left cards entrance tied to scroll
    tl.fromTo(leftCards, 
      { opacity: 0, y: -60, scale: 0.75, rotationZ: -4 },
      { opacity: 1, y: 0, scale: 1, rotationZ: 0, stagger: 0.08, ease: 'power2.out' },
      0
    )
    // 2. Right cards entrance tied to scroll
    .fromTo(rightCards, 
      { opacity: 0, y: 60, scale: 0.75, rotationZ: 4 },
      { opacity: 1, y: 0, scale: 1, rotationZ: 0, stagger: 0.08, ease: 'power2.out' },
      0.05
    )
    // 3. Bottom profile badge entrance tied to scroll
    .fromTo(bottomCard,
      { opacity: 0, y: 50, scale: 0.7 },
      { opacity: 1, y: 0, scale: 1, ease: 'power2.out' },
      0.2
    )
    // 4. Central title reveal tied to scroll
    .fromTo(title,
      { opacity: 0, scale: 0.85, y: 25, filter: 'blur(10px)' },
      { opacity: 1, scale: 1, y: 0, filter: 'blur(0px)', ease: 'power2.out' },
      0.25
    );
  };

  // The collage lives below the fold; build its scroll animation only when the
  // section nears the viewport (with an always-run safety fallback).
  let started = false;
  let observer: IntersectionObserver | null = null;

  const init = async () => {
    if (started) return;
    started = true;
    const section = document.getElementById('visual-collage');
    if (!section || !document.documentElement.contains(section)) {
      started = false;
      return;
    }
    try {
      await initCollageAnimation();
    } catch {
      started = false;
    }
  };

  const armObserver = () => {
    if (observer) return;
    if (!('IntersectionObserver' in window)) {
      init();
      return;
    }
    const section = document.getElementById('visual-collage');
    if (!section) return;
    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer?.disconnect();
          observer = null;
          init();
        }
      },
      { rootMargin: '50% 0px 0px 0px' }
    );
    observer.observe(section);
  };

  document.addEventListener('astro:page-load', armObserver);
  document.addEventListener('astro:before-swap', () => {
    started = false;
    observer?.disconnect();
    observer = null;
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', armObserver);
  } else {
    armObserver();
  }

  // Safety: never leave the collage un-enhanced, even if the observer never fires
  window.addEventListener('load', () => setTimeout(init, 12000), { once: true });
</script>
