          </button>

          <!-- Option 3 -->
          <button 
            type="button" 
            data-pain-index="2"
            class="pain-point-card group relative p-5 rounded-2xl border text-start transition-all duration-300 cursor-pointer select-none bg-hero-card border-text-main/10 hover:border-accent-primary/30 hover:shadow-[0_4px_20px_var(--color-hero-glow)] active:scale-98"
          >
            <div class="absolute top-4 end-4 w-2 h-2 rounded-full bg-accent-primary/40 group-hover:bg-accent-primary transition-colors"></div>
            <div class="space-y-3">
              <span class="w-8 h-8 rounded-xl bg-accent-primary/10 text-accent-highlight flex items-center justify-center text-sm font-bold font-mono">03</span>
              <p class="text-text-main/90 text-xs sm:text-[13px] font-semibold font-sans leading-relaxed">
                {isAr ? "العملاء بيكلمونا وبيتوهوا من السيلز ومتابعة المناديب صعبة" : "Customers are getting lost and managing sales reps is too hard."}
              </p>
            </div>
          </button>

          <!-- Option 4 -->
          <button 
            type="button" 
            data-pain-index="3"
            class="pain-point-card group relative p-5 rounded-2xl border text-start transition-all duration-300 cursor-pointer select-none bg-hero-card border-text-main/10 hover:border-accent-primary/30 hover:shadow-[0_4px_20px_var(--color-hero-glow)] active:scale-98"
          >
            <div class="absolute top-4 end-4 w-2 h-2 rounded-full bg-accent-primary/40 group-hover:bg-accent-primary transition-colors"></div>
            <div class="space-y-3">
              <span class="w-8 h-8 rounded-xl bg-accent-primary/10 text-accent-highlight flex items-center justify-center text-sm font-bold font-mono">04</span>
              <p class="text-text-main/90 text-xs sm:text-[13px] font-semibold font-sans leading-relaxed">
                {isAr ? "عايز أعمل موقع احترافي لشركتي يظهر شغلي ويجيبلي عملاء" : "I want a professional website that represents my brand and brings leads."}
              </p>
            </div>
          </button>
        </div>

        <!-- Suggested Solution Panel (Dynamically shown and loaded) -->
        <div id="solution-panel" class="hidden transition-all duration-500 transform opacity-0 translate-y-4">
          <div class="p-6 sm:p-8 rounded-2xl border border-accent-primary/20 bg-accent-primary/5 space-y-6 relative">
            <!-- Suggested Solution Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-text-main/10 pb-4">
              <div class="space-y-1">
                <span class="text-[10px] font-bold text-accent-primary uppercase tracking-widest font-mono">
                  {isAr ? "الحل المقترح لشركتك:" : "Suggested Solution:"}
                </span>
                <h4 id="solution-title" class="text-lg sm:text-xl font-bold text-text-main font-serif">
                  <!-- Set dynamically -->
                </h4>
              </div>
              <!-- Recommended Badge -->
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-success-primary/20 bg-success-primary/5 text-success-primary text-[10px] font-bold font-mono shrink-0 w-fit">
                <Icon name="circle-check" class="w-3.5 h-3.5" />
                <span>{isAr ? "موصى به بالكامل" : "RECOMMENDED"}</span>
              </div>
            </div>

            <!-- Description and Before/After Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
              <!-- Left: Description and actions -->
              <div class="flex flex-col justify-between space-y-4">
                <p id="solution-desc" class="text-text-main/70 text-sm leading-relaxed font-sans font-light">
                  <!-- Set dynamically -->
                </p>

                <!-- CTA Area -->
                <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
                  <button 
                    id="solution-whatsapp-btn"
                    class="h-12 px-6 rounded-full bg-success-primary hover:bg-success-hover text-white font-semibold text-xs tracking-wider flex items-center justify-center gap-2 shadow-success hover:shadow-success-hover active:scale-95 transition-all duration-300 w-full sm:w-auto text-center border-none cursor-pointer"
                  >
                    <Icon name="whatsapp" class="w-4 h-4" />
                    <span>{isAr ? "ابدأ حل مشكلتك على واتساب" : "Start Solving on WhatsApp"}</span>
                  </button>
                  
                  <a 
                    id="solution-details-btn"
                    href="#"
                    class="h-12 px-6 rounded-full bg-transparent hover:bg-accent-primary/5 text-accent-primary border border-accent-primary font-semibold text-xs tracking-wider flex items-center justify-center gap-1.5 transition-all duration-300 w-full sm:w-auto text-center"
                  >
