---
import { getSafeServices } from '../../scripts/servicesHelper';
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';

// Import service images
import crmImg from '../../assets/images/Crm.png';
import excelImg from '../../assets/images/Excel.jpg';
import portfolioImg from '../../assets/images/Portfolio.jpeg';
import mediaBuyingImg from '../../assets/images/media-buying.jpg';
import powerBiImg from '../../assets/images/power bi.png';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

const services = await getSafeServices(lang);

// Helper to get service URL dynamically based on slug
const getServiceUrl = (slug: string) => {
  const cleanSlug = slug.split('/').pop();
  return lang === 'ar' ? `/services/${cleanSlug}/` : `/en/services/${cleanSlug}/`;
};

// Helper to get service image dynamically from frontmatter with local fallbacks
const getServiceImage = (service: any) => {
  if (service.data.coverImage) {
    return service.data.coverImage;
  }
  const cleanSlug = service.slug.split('/').pop();
  switch (cleanSlug) {
    case 'data-analytics': return powerBiImg;
    case 'marketing-strategy': return mediaBuyingImg;
    case 'advanced-excel': return excelImg;
    case 'custom-crm': return crmImg;
    case 'web-portfolios': return portfolioImg;
    default: return powerBiImg;
  }
};
---

<section id="services" aria-labelledby="services-title" class="py-24 px-6 relative bg-transparent overflow-hidden scroll-mt-20">
  <!-- Subtle tech light flare -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(37,99,235,0.015),transparent_50%)] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto space-y-16">
    <!-- Header Area -->
    <div class="space-y-3 text-start">
      <!-- Subtitle Badge / Eyebrow -->
      <div class="text-xs font-bold tracking-widest text-accent-primary uppercase font-sans">
        {isAr ? "استكشف الخدمات" : "SERVICES & GIGS"}
      </div>
      
      <!-- Section Title -->
      <h2 id="services-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-text-main font-serif">
        {isAr ? "الخدمات والمشاريع المخصصة" : "Services & Gigs"}
      </h2>
      
      <!-- Section Description -->
      <p class="text-text-main/70 text-base leading-relaxed font-sans max-w-xl">
        {isAr ? "حلول عملية مصممة لحل الاختناقات، وإلغاء الإنفاق الضائع، وتحقيق نمو ملموس." : "Actionable solutions designed to solve bottlenecks, eliminate wasted spend, and drive measurable growth."}
      </p>
    </div>

    <!-- Cards Container: Horizontal swipeable deck on mobile (<768px), Custom grid spans on desktop (>=768px) -->
    <div class="flex md:grid md:grid-cols-12 gap-5 md:gap-8 overflow-x-auto overflow-y-hidden touch-auto md:overflow-visible snap-x snap-mandatory md:snap-none no-scrollbar pb-6 md:pb-0 px-6 md:px-0 -mx-6 md:mx-0">
      {services.map((service, index) => {
        const isSolid = false;
        
        let spanClass = '';
        if (index === 0) {
          spanClass = 'md:col-span-6 lg:col-span-7'; // ~60% width
        } else if (index === 1) {
          spanClass = 'md:col-span-6 lg:col-span-5'; // ~40% width
        } else if (index === 2 || index === 3) {
          spanClass = 'md:col-span-6 lg:col-span-4'; // 1/3 width
        } else {
          spanClass = 'md:col-span-12 lg:col-span-4'; // 1/3 width on desktop
        }

        return (
          <div class={`premium-card-global group !p-0 overflow-hidden flex flex-col h-[470px] md:h-full flex-shrink-0 w-[78vw] md:w-auto snap-center md:snap-align-none relative ${spanClass}`}>
            
            <!-- Clickable Card Body -->
            <a href={getServiceUrl(service.slug)} class="flex flex-col h-full flex-grow hover:no-underline group/body">
              <!-- Top Half: Service Image -->
              <div class="h-44 relative border-b border-text-main/10 overflow-hidden bg-primary-bg">
                <Image 
                  src={getServiceImage(service)} 
                  alt={isAr ? `خدمة ${service.data.title}` : `Service cover for ${service.data.title}`}
                  class="w-full h-full object-cover group-hover/body:scale-105 transition-transform duration-500"
                  width={500}
                  quality={75}
                  loading="lazy"
                />
                <!-- Service Pill Tag -->
                <span class="absolute top-4 start-4 text-[9px] font-bold tracking-wider text-text-main/60 uppercase border border-text-main/10 px-2 py-0.5 rounded bg-hero-card/90 font-mono z-10">
                  {isAr ? "خدمة" : "SERVICE"}
                </span>
                
                {service.isFallback && (
                  <span class="absolute top-4 end-4 text-[8px] font-bold tracking-wider text-white uppercase px-2 py-0.5 rounded bg-amber-800 font-sans z-10">
                    {isAr ? "غير مترجم" : "NOT TRANSLATED"}
                  </span>
                )}
              </div>

              <!-- Bottom Half: Details -->
              <div class="p-6 pb-28 bg-hero-card flex-grow flex flex-col justify-between">
                <div class="space-y-3">
                  <h3 class="text-lg font-bold text-text-main font-serif leading-snug group-hover/body:text-accent-primary transition-colors">
                    {service.data.title}
                  </h3>
                  
                  {service.isFallback && (
                    <div class="text-[10px] text-amber-800 bg-amber-900/5 px-2.5 py-1.5 rounded border border-amber-800/20 font-sans leading-tight">
                      {isAr 
                        ? "⚠️ هذه الخدمة غير متوفرة بالعربية بعد، يتم عرض النسخة الإنجليزية." 
                        : "⚠️ Arabic version unavailable, English details shown."}
                    </div>
                  )}

                  <p class="text-text-main/70 text-sm leading-relaxed font-sans min-h-[4.2rem]">
                    {service.data.description}
                  </p>
                </div>
              </div>
            </a>

            <!-- Action Area Wrapper (Default Explore button - Desktop only) -->
            <div class="absolute inset-x-0 bottom-0 p-6 bg-hero-card pointer-events-none md:block hidden md:group-hover:opacity-0 transition-opacity duration-200">
              <hr class="border-text-main/10 mb-4" />
              <div class="flex justify-end pointer-events-auto">
                <a 
                  href={getServiceUrl(service.slug)}
                  tabindex="-1"
                  aria-hidden="true"
                  class:list={[
                    "h-11 px-5 rounded-full font-semibold text-xs transition-all duration-200 active:scale-95 inline-flex items-center justify-center gap-1.5 cursor-pointer",
                    isSolid 
                      ? "bg-accent-primary hover:bg-accent-highlight text-white shadow-sm" 
                      : "bg-transparent hover:bg-accent-primary/5 text-accent-primary border border-accent-primary"
                  ]}
                >
                  {service.slug.includes('web-portfolios') ? (isAr ? "طلب استشارة" : "Request Consultation") : (isAr ? "استكشف التفاصيل" : "Explore Details")}
                </a>
              </div>
            </div>

            <!-- Hover Overlay (Desktop slide-up, mobile always visible) -->
            <div class="absolute inset-x-0 bottom-0 bg-hero-card p-5 border-t border-text-main/10 flex items-center justify-between gap-2 z-20 shadow-[0_-8px_24px_rgba(10,25,47,0.06)] opacity-100 translate-y-0 pointer-events-auto visible md:translate-y-full md:opacity-0 md:pointer-events-none md:invisible md:transition-all md:duration-300 md:ease-out md:group-hover:translate-y-0 md:group-hover:opacity-100 md:group-hover:pointer-events-auto md:group-hover:visible">
              <!-- Quick Connect Actions -->
              <div class="flex items-center gap-2 w-full">
                <!-- Call Button (Circular) -->
                <a 
                  href="tel:+201017749925" 
                  class="w-11 h-11 rounded-full bg-primary-bg hover:bg-text-main/10 text-text-main flex items-center justify-center transition-all duration-200 active:scale-95 shrink-0 border border-text-main/10"
                  aria-label={isAr ? "اتصال هاتفي" : "Call now"}
                >
                  <Icon name="phone" class="w-4 h-4" />
                </a>

                <!-- WhatsApp Button -->
                <a 
                  href={`https://wa.me/201017749925?text=${encodeURIComponent(
                    service.data.whatsappMessage || (isAr ? `مرحباً عمرو، أود الاستفسار عن خدمة: ${service.data.title}` : `Hi Amr, I would like to inquire about: ${service.data.title}`)
                  )}`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="h-11 flex-grow rounded-full bg-success-primary hover:bg-success-hover text-white font-bold text-xs tracking-wider flex items-center justify-center gap-2 shadow-md active:scale-95 transition-all duration-200 border-none service-whatsapp-cta"
                  data-service-title={service.data.title}
                  data-service-slug={service.slug}
                >
                  <Icon name="whatsapp" class="w-4 h-4" />
                  <span>{isAr ? "واتس اب" : "WhatsApp"}</span>
                </a>
              </div>
            </div>

          </div>
        );
      })}
