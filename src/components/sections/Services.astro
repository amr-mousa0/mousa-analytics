---
import { useTranslations } from '../../i18n/index.js';
import { ContentFacade } from '../../lib/content/facade.js';
import FlowingRibbons from '../ui/FlowingRibbons.astro';
import ServiceCard from '../ui/ServiceCard.astro';


interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = await ContentFacade.getServices({ lang: lang as 'en' | 'ar' });
---

<section id="services" aria-labelledby="services-title" class="py-24 px-6 relative bg-[#080807] text-white overflow-hidden scroll-mt-20">
  <!-- ─── Flowing 3D Ribbons Dynamic Background from Hero ─── -->
  <FlowingRibbons opacity={0.45} />
  <div class="max-w-6xl mx-auto space-y-16 relative z-10">
    <!-- Header Area -->
    <div class="space-y-3 text-start">
      <!-- Subtitle Badge / Eyebrow -->
      <div data-entrance="eyebrow" class="text-xs font-bold tracking-widest text-blue-400 uppercase font-sans">
        {t.services.eyebrow}
      </div>
      
      <!-- Section Title -->
      <h2 id="services-title" data-entrance="title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        {t.services.title}
      </h2>
      
      <!-- Section Description -->
      <p data-entrance="subtitle" class="text-gray-300 text-base leading-relaxed font-sans max-w-xl">
        {t.services.subtitle}
      </p>
    </div>

    <!-- Cards Container: Horizontal swipeable deck on mobile (<768px), Custom grid spans on desktop (>=768px) -->
    <div class="service-grid flex md:grid md:grid-cols-12 gap-5 md:gap-8 overflow-x-auto overflow-y-hidden touch-auto md:overflow-visible snap-x snap-mandatory md:snap-none no-scrollbar pb-6 md:pb-0 px-6 md:px-0 -mx-6 md:mx-0" data-services-grid>
      {services.map((service, index) => {
        let spanClass = '';
        if (index === 0) {
          spanClass = 'md:col-span-6 lg:col-span-7'; // ~60% width
        } else if (index === 1) {
          spanClass = 'md:col-span-6 lg:col-span-5'; // ~40% width
        } else if (index === 2 || index === 3) {
          spanClass = 'md:col-span-6 lg:col-span-4'; // 1/3 width
        } else {
          spanClass = 'md:col-span-12 lg:col-span-4'; // 1/3 width on desktop
        }

        return (
          <ServiceCard
            service={service}
            lang={lang}
            spanClass={spanClass}
            index={index}
          />
        );
      })}
    </div>
  </div>
</section>

<script>
  import { loadMotion } from '../../scripts/motionLoader';

  // Kickoff: warm the shared GSAP module as soon as this page script runs
  // (right after HTML parse), so the engine below is ready long before the
  // user scrolls the services grid into view on mobile.
  loadMotion();

  // The services grid engine (and the GSAP chunk it pulls in) is built when
  // the section actually approaches the viewport, never during the first
  // paint. The grid's entrance is CSS-only and driven by a lightweight
  // IntersectionObserver below (no GSAP); the gate itself is exposed eagerly
  // so consumers (e2e tests, analytics) can read it long before engine boot.
  if (typeof window !== 'undefined') {
    window.__servicesEngineActive = Boolean(
      typeof window.matchMedia === 'function' &&
        window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    );
    // JS-presence signal gating the CSS hidden state (no-JS users see the
    // grid instantly).
    document.documentElement.classList.add('services-js');
  }

  let started = false;
  let gridApi: typeof import('../../lib/services-grid/index') | null = null;
  let observer: IntersectionObserver | null = null;
  let revealIo: IntersectionObserver | null = null;

  const armReveal = () => {
    const section = document.getElementById('services');
    if (!section || revealIo) return;
    const grid = section.querySelector<HTMLElement>('[data-services-grid]');
    if (!grid) return;
    if (grid.classList.contains('services-revealed')) return;
    if (!('IntersectionObserver' in window)) {
      grid.classList.add('services-revealed');
      return;
    }
    // Mirrors the previous ScrollTrigger 'top 75%' line.
    revealIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && grid) {
            grid.classList.add('services-revealed');
            revealIo?.disconnect();
            revealIo = null;
          }
        });
      },
      { rootMargin: '0px 0px -25% 0px' }
    );
    revealIo.observe(section);
  };

  const init = async () => {
    if (started) return;
    started = true;
    const section = document.getElementById('services');
    if (!section || !document.documentElement.contains(section)) {
      started = false;
      return;
    }
    try {
      const grid = await import('../../lib/services-grid/index');
      if (!document.documentElement.contains(section)) {
        started = false;
        return;
      }
      gridApi = grid;
      grid.servicesGridLifecycle.init();
    } catch {
      started = false;
    }
  };

  const dispose = () => {
    if (gridApi) {
      gridApi.servicesGridLifecycle.dispose();
      gridApi = null;
    }
  };

  const armObserver = () => {
    if (observer) return;
    if (!('IntersectionObserver' in window)) {
      init();
      return;
    }
    const section = document.getElementById('services');
    if (!section) return;
    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer?.disconnect();
          observer = null;
          init();
        }
      },
      { rootMargin: '50% 0px 0px 0px' }
    );
    observer.observe(section);
  };

  document.addEventListener('astro:page-load', armObserver);
  document.addEventListener('astro:page-load', armReveal);
  document.addEventListener('astro:before-swap', () => {
    started = false;
    dispose();
    observer?.disconnect();
    observer = null;
    revealIo?.disconnect();
    revealIo = null;
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      armObserver();
      armReveal();
    });
  } else {
    armObserver();
    armReveal();
  }

  // Safety: never leave the grid un-enhanced, even if the observer never fires
  // (tabs, printers, odd viewports) — behavior unchanged from before.
  window.addEventListener('load', () => setTimeout(init, 12000), { once: true });
</script>

