  function initPainPointSelector() {
    const cards = document.querySelectorAll('.pain-point-card');
    const panel = document.getElementById('solution-panel');
    const titleEl = document.getElementById('solution-title');
    const descEl = document.getElementById('solution-desc');
    const beforeEl = document.getElementById('before-text');
    const afterEl = document.getElementById('after-text');
    const whatsappBtn = document.getElementById('solution-whatsapp-btn');
    const detailsBtn = document.getElementById('solution-details-btn');

    if (!panel || !titleEl || !descEl || !beforeEl || !afterEl || !whatsappBtn || !detailsBtn) return;

    // Detect language from HTML lang attribute
    const isArabic = document.documentElement.lang === 'ar';

    cards.forEach(card => {
      card.addEventListener('click', () => {
        // Remove active class from all
        cards.forEach(c => c.classList.remove('active'));
        
        // Add active class to current
        card.classList.add('active');

        // Get data index
        const index = parseInt(card.getAttribute('data-pain-index') || '0', 10);
        const data = painPointsData[index];

        // Update elements dynamically
        titleEl.textContent = isArabic ? data.titleAr : data.titleEn;
        descEl.textContent = isArabic ? data.descAr : data.descEn;
        beforeEl.textContent = isArabic ? data.beforeAr : data.beforeEn;
        afterEl.textContent = isArabic ? data.afterAr : data.afterEn;

        // WhatsApp redirect click handler mapping
        const message = isArabic ? data.whatsappAr : data.whatsappEn;
        whatsappBtn.onclick = () => {
          const domainParts = ['wa', 'me'];
          const targetDomain = domainParts.join('.');
          const recipientNum = '201017749925';
          const redirectUrl = `https://${targetDomain}/${recipientNum}?text=${encodeURIComponent(message)}`;
          window.open(redirectUrl, '_blank', 'noopener,noreferrer');
        };

        // Details button href mapping
        detailsBtn.setAttribute('href', isArabic ? `/services/${data.slug}/` : `/en/services/${data.slug}/`);

        // Show panel with smooth transition
        panel.classList.remove('hidden');
        // Force reflow
        panel.offsetHeight;
        panel.classList.add('opacity-100', 'translate-y-0');

        // Smooth scroll to solution panel if not fully in view
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  // Run on page load and after view transitions
  initPainPointSelector();
  document.addEventListener('astro:after-swap', initPainPointSelector);
</script>

<script>
  import { lifecycle } from '../../scripts/lifecycle';
  import { trackEvent } from '../../scripts/analytics';

  const setupServicesTracking = () => {
    const whatsappBtns = document.querySelectorAll('.service-whatsapp-cta');
    whatsappBtns.forEach(btn => {
      if (btn.hasAttribute('data-tracking-bound')) return;
      btn.setAttribute('data-tracking-bound', 'true');

      lifecycle.addListener(btn, 'click', () => {
        const slug = btn.getAttribute('data-service-slug') || '';
        const cleanSlug = slug.split('/').pop() || '';
        trackEvent({
          event: 'cta_click',
          cta_text: 'WhatsApp',
          cta_type: 'whatsapp',
          context_slug: cleanSlug || undefined
        });
      });
    });

    const solutionWhatsappBtn = document.getElementById('solution-whatsapp-btn');
    if (solutionWhatsappBtn && !solutionWhatsappBtn.hasAttribute('data-tracking-bound')) {
      solutionWhatsappBtn.setAttribute('data-tracking-bound', 'true');
      lifecycle.addListener(solutionWhatsappBtn, 'click', () => {
        const activeCard = document.querySelector('.pain-point-card.active');
        const activeIndex = activeCard ? activeCard.getAttribute('data-pain-index') : 'unknown';
        trackEvent({
          event: 'cta_click',
          cta_text: 'Pain-Point WhatsApp Solver',
          cta_type: 'whatsapp',
          context_slug: `pain-point-selector-index-${activeIndex}`
        });
      });
    }
  };

  setupServicesTracking();
  document.addEventListener('astro:after-swap', setupServicesTracking);
</script>

