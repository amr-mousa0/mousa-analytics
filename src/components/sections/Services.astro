        <!-- Glow effects inside -->
        <div class="absolute -right-20 -top-20 w-48 h-48 rounded-full bg-accent-primary/5 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="absolute -left-20 -bottom-20 w-48 h-48 rounded-full bg-success-primary/5 blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="space-y-2 text-center">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-accent-primary/20 bg-accent-primary/5 text-accent-primary text-[10px] font-bold tracking-wider uppercase font-mono">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-primary animate-pulse"></span>
            {isAr ? "حل المشاكل المعقدة" : "PROBLEM SOLVER"}
          </span>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-text-main font-serif">
            {isAr ? "إيه أكتر مشكلة معطلاك ومضايقاك في شغلك حالياً؟" : "What is your biggest business bottleneck right now?"}
          </h3>
          <p class="text-text-main/60 text-xs sm:text-sm font-sans">
            {isAr ? "اختر التحدي اللي بيواجهك عشان تشوف الحل والنتيجة المقترحة فوراً" : "Select the challenge you face to see the suggested solution and outcome instantly."}
          </p>
        </div>

        <!-- Grid of 4 Pain Point cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Option 1 -->
          <button 
            type="button" 
            data-pain-index="0"
            class="pain-point-card group relative p-5 rounded-2xl border text-start transition-all duration-300 cursor-pointer select-none bg-hero-card border-text-main/10 hover:border-accent-primary/30 hover:shadow-[0_4px_20px_var(--color-hero-glow)] active:scale-98"
