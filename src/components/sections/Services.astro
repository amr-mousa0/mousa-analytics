                  </a>
                </div>
              </div>

              <!-- Right: Before/After Comparison cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-stretch">
                <!-- Before Card -->
                <div class="p-5 rounded-xl border border-amber-500/15 bg-amber-500/5 flex flex-col justify-between space-y-4 relative overflow-hidden group">
                  <div class="absolute -right-6 -bottom-6 w-12 h-12 bg-amber-500/5 rounded-full pointer-events-none"></div>
                  <div class="space-y-2">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full border border-amber-500/20 bg-amber-500/10 text-amber-700 text-[9px] font-bold font-mono">
                      {isAr ? "الوضع الحالي العشوائي 📉" : "Before (Random & Messy) 📉"}
                    </span>
                    <p id="before-text" class="text-text-main/80 text-xs sm:text-[13px] leading-relaxed font-sans font-light">
                      <!-- Set dynamically -->
                    </p>
                  </div>
                </div>

                <!-- After Card -->
                <div class="p-5 rounded-xl border border-success-primary/20 bg-success-primary/5 flex flex-col justify-between space-y-4 relative overflow-hidden group shadow-[inset_0_1px_2px_rgba(22,163,74,0.01)] glowing-border-success">
                  <div class="absolute -right-6 -bottom-6 w-12 h-12 bg-success-primary/5 rounded-full pointer-events-none"></div>
                  <div class="space-y-2">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full border border-success-primary/30 bg-success-primary/10 text-success-primary text-[9px] font-bold font-mono">
                      {isAr ? "الوضع مع موسى لتحليل البيانات 📈" : "After (Organized & Optimized) 📈"}
                    </span>
                    <p id="after-text" class="text-text-main/90 text-xs sm:text-[13px] leading-relaxed font-sans font-medium">
                      <!-- Set dynamically -->
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pain points data - deferred as module script to avoid blocking main thread (TBT optimization)
  const painPointsData = [
    {
      titleAr: "تصميم شيتات إكسيل محاسبية احترافية",
      titleEn: "Advanced Excel & Data Structuring",
      descAr: "شيتات الإكسيل بتبوظ منك كل شوية والمعادلات بتضرب؟ هنسهلك الدنيا ونصمملك شيت إكسيل محاسبي احترافي متفصل بالملي على قد حجم شغلك، يمنع الأخطاء البشرية ويخلص الحسابات في ثواني.",
