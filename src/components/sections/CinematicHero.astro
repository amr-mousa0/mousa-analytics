---
import BrandMark from '../brand/BrandMark.astro';
import FlowingRibbons from '../ui/FlowingRibbons.astro';
import { useTranslations } from '../../i18n/index.ts';
import { BRAND_CONSTANTS } from '../../lib/constants/brand.constants';

interface Props {
  lang: 'en' | 'ar';
}

const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const t = useTranslations(lang);

// Using high-quality transparent renders
const laptopSrc = isAr ? '/dashboard-hero-right.png' : '/dashboard-hero-left.png';
const brandTagline = isAr ? BRAND_CONSTANTS.TAGLINE_AR : BRAND_CONSTANTS.TAGLINE_EN;

// 7 Minimalist High-End Agency Totem Cards (Lowered further for optimal section framing)
const galleryCards = [
  {
    id: 1,
    kind: 'graphic' as const,
    alt: 'Verified Growth Metric',
    label: t.hero.stat1Val || '+182%',
    subLabel: t.hero.totem.verifiedGrowth,
    depth: 0.4,
    aspect: 'aspect-[16/10]',
    rotation: -14,
    leftPct: 9,
    topPct: 46,
    widthClamp: 'clamp(170px, 17vw, 280px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/12 shadow-2xl',
    bg: 'bg-[#0d0e14] text-white',
    zIndex: 35,
  },
  {
    id: 2,
    kind: 'image' as const,
    src: '/images/gallery/pic1.png',
    alt: 'Café & Bar Sales Performance',
    label: t.hero.totem.salesAnalytics,
    tag: 'Sales Performance',
    depth: 0.6,
    aspect: 'aspect-[16/10]',
    rotation: -9,
    leftPct: 21,
    topPct: 56,
    widthClamp: 'clamp(195px, 19vw, 320px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/10 shadow-2xl',
    bg: 'bg-[#0d0e12]',
    zIndex: 25,
  },
  {
    id: 3,
    kind: 'image' as const,
    src: '/images/gallery/pic2.png',
    alt: 'Net Profit Breakdown',
    label: t.hero.totem.netProfit,
    tag: 'Profit Analytics',
    depth: 0.85,
    aspect: 'aspect-[16/10]',
    rotation: -4,
    leftPct: 34,
    topPct: 42,
    widthClamp: 'clamp(215px, 21vw, 360px)',
    borderRadius: 'rounded-[22px]',
    borderStyle: 'border border-white/12 shadow-2xl',
    bg: 'bg-[#0e0f14]',
    zIndex: 35,
  },
  {
    id: 4,
    kind: 'image' as const,
    src: '/images/gallery/pic4.png',
    alt: 'Marketing ROI Overview',
    label: t.hero.totem.marketingOverview,
    tag: 'Marketing ROI',
    depth: 1.1,
    aspect: 'aspect-[16/10]',
    rotation: 0,
    leftPct: 48,
    topPct: 34,
    widthClamp: 'clamp(240px, 24vw, 410px)',
    borderRadius: 'rounded-[24px]',
    borderStyle: 'border border-white/20 shadow-[0_25px_60px_rgba(0,0,0,0.95)]',
    bg: 'bg-[#0a0b0f]',
    zIndex: 45,
    isCenterAnchor: true,
  },
  {
    id: 5,
    kind: 'image' as const,
    src: '/images/gallery/pic5.png',
    alt: 'Conversion Rate Funnel',
    label: t.hero.totem.conversionFunnel,
    tag: 'Funnel Analytics',
    depth: 0.85,
    aspect: 'aspect-[16/10]',
    rotation: 4,
    leftPct: 61,
    topPct: 44,
    widthClamp: 'clamp(215px, 21vw, 360px)',
    borderRadius: 'rounded-[22px]',
    borderStyle: 'border border-white/12 shadow-2xl',
    bg: 'bg-[#0e0f14]',
    zIndex: 35,
  },
  {
    id: 6,
    kind: 'image' as const,
    src: '/images/gallery/pic3.png',
    alt: 'Customer Acquisition Matrix',
    label: t.hero.totem.acquisitionMatrix,
    tag: 'Customer Growth',
    depth: 0.6,
    aspect: 'aspect-[16/10]',
    rotation: 9,
    leftPct: 73,
    topPct: 54,
    widthClamp: 'clamp(195px, 19vw, 320px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/10 shadow-2xl',
    bg: 'bg-[#0d0e12]',
    zIndex: 25,
  },
  {
    id: 7,
    kind: 'image' as const,
    src: '/images/gallery/pic1.png',
    alt: 'Executive BI Dashboard',
    label: t.hero.totem.executiveBi,
    tag: 'Executive Dashboard',
    depth: 0.4,
    aspect: 'aspect-[16/10]',
    rotation: 14,
    leftPct: 85,
    topPct: 60,
    widthClamp: 'clamp(170px, 17vw, 280px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/10 shadow-2xl',
    bg: 'bg-[#0c0d10]',
    zIndex: 20,
  },
];
---

<section id="hero" class="cinematic-hero bg-[#080807]">

  <!-- ─── Flowing 3D Ribbons Dynamic Background ─── -->
  <FlowingRibbons opacity={0.45} />

  <!-- ─── Brand Name Stage (Split Layout) ─── -->
  <div class="brand-stage" id="brand-stage" aria-hidden="false" dir={isAr ? 'rtl' : 'ltr'}>

    <div class="brand-content-wrap" id="brand-content">
      <!-- Giant cinematic brand name -->
      <h1
        class={`brand-name ${isAr ? 'brand-name--ar' : 'brand-name--en'}`}
        dir={isAr ? 'rtl' : 'ltr'}
      >
        {isAr ? (
          ['موسى', 'لتحليل البيانات'].map((line, li) => (
            <span class="brand-line" role="text" aria-label={line}>
              <span
                class="brand-char brand-char--word"
                style={`--char-index: ${li}`}
                aria-hidden="true"
              >{line}</span>
            </span>
          ))
        ) : (
          ['MOUSA', 'DATA ANALYTICS'].map((line, li) => (
            <span class="brand-line" role="text" aria-label={line}>
              {line.split('').map((char, ci) => (
                <span
                  class="brand-char"
                  style={`--char-index: ${li * 10 + ci}`}
                  aria-hidden="true"
                >{char === ' ' ? '\u00A0' : char}</span>
              ))}
            </span>
          ))
        )}
      </h1>

      <!-- Tagline -->
      <p class="brand-tagline" dir={isAr ? 'rtl' : 'ltr'}>{brandTagline}</p>

      <!-- Premium CTA (Button-in-Button) -->
      <div class="brand-cta-wrap" dir={isAr ? 'rtl' : 'ltr'}>
        <button class="hero-cta group" onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))">
          <span class="hero-cta__text">{t.aboutPage.startProject}</span>
          <div class="hero-cta__icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-cta__icon">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </button>
      </div>
    </div>

    <!-- ─── Hero Laptop Side ─── -->
    <div class="brand-laptop-wrap">
      <div class="hero-laptop" aria-hidden="true">
        <div class="hero-laptop__inner" id="hero-laptop-inner">
          <img src={laptopSrc} alt="Dashboard Analysis" class="hero-laptop__img" />
        </div>
      </div>
    </div>

  </div>

  <!-- ─── Gallery Parallax Stage (Overlapping Cascading Totem 7 Cards) ─── -->
  <div class="gallery-stage" id="gallery-stage">

    <div class="gallery-grid" id="gallery-grid">
      {galleryCards.map((card, i) => (
        <div
          class={`gallery-card gallery-card--totem ${card.aspect} p-1 sm:p-1.5 bg-white/[0.04] backdrop-blur-xl border border-white/12 shadow-[0_25px_60px_rgba(0,0,0,0.85)] ${card.borderRadius} transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:!z-50 hover:scale-[1.03] hover:-translate-y-3 hover:border-white/35 hover:shadow-[0_40px_90px_rgba(0,0,0,0.95)] cursor-pointer group`}
          data-depth={card.depth}
          data-left={card.leftPct}
          data-top={card.topPct}
          data-rotation={card.rotation}
          data-center={card.isCenterAnchor ? 'true' : 'false'}
          style={`left: ${card.leftPct}%; top: ${card.topPct}%; width: ${card.widthClamp}; transform: translate(-50%, 0) rotate(${card.rotation}deg); z-index: ${card.zIndex};`}
        >
          <div class="gallery-card__inner relative w-full h-full rounded-[calc(20px-0.375rem)] overflow-hidden bg-[#06070a] ring-1 ring-white/10 shadow-inner">
            {card.kind === 'graphic' ? (
              <figure class="gallery-figure gallery-figure--graphic w-full h-full p-5 sm:p-6 flex flex-col items-center justify-center text-center gap-3 relative bg-[#0c0d12] text-white">
                <BrandMark size={36} class="graphic-mark w-8 h-8 sm:w-9 sm:h-9 text-white/80 mb-1" />
                <span class="graphic-stat font-serif text-3xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-white leading-none">{card.label}</span>
                <span class="graphic-label font-mono text-[8px] sm:text-[10px] font-medium uppercase tracking-[0.2em] text-white/60 mt-1">{card.subLabel}</span>
              </figure>
            ) : (
              <figure class="gallery-figure relative w-full h-full overflow-hidden bg-[#06070a]">
                <img
                  src={card.src}
                  alt={card.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="gallery-img w-full h-full object-cover object-center opacity-95 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]"
                />
              </figure>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Fade into next section -->
    <div class="gallery-fade-out" aria-hidden="true"></div>
  </div>

</section>

<!-- ─── Cinematic Scroll Engine ─── -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCinematicEngine() {
    const hero = document.getElementById('hero');
    if (!hero) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const chars = hero.querySelectorAll<HTMLElement>('.brand-char');
    const tagline = hero.querySelector<HTMLElement>('.brand-tagline');
    const brandStage = hero.querySelector<HTMLElement>('#brand-stage');
    const galleryStage = hero.querySelector<HTMLElement>('#gallery-stage');
    const galleryCards = hero.querySelectorAll<HTMLElement>('.gallery-card');

    // ══════════════════════════════════════════
    // ENTRANCE — Staggered reveal on page load
    // ══════════════════════════════════════════
    if (!reduceMotion) {
      requestAnimationFrame(() => {
        let maxDelay = 0;

        chars.forEach((char) => {
          const idx = parseInt(char.style.getPropertyValue('--char-index')) || 0;
          const isWord = char.classList.contains('brand-char--word');
          const step = isWord ? 140 : 50;
          const delay = 150 + idx * step;
          if (delay > maxDelay) maxDelay = delay;
          setTimeout(() => char.classList.add('is-visible'), delay);
        });

        const totalDelay = maxDelay + 200;
        setTimeout(() => tagline?.classList.add('is-visible'), totalDelay);

        const ctaWrap = hero.querySelector<HTMLElement>('.brand-cta-wrap');
        setTimeout(() => ctaWrap?.classList.add('is-visible'), totalDelay + 200);

        const laptopInner = hero.querySelector<HTMLElement>('#hero-laptop-inner');
        if (laptopInner) {
          setTimeout(() => laptopInner.classList.add('is-visible'), 400);
        }
      });
    } else {
      // Reduced motion: show everything instantly
      chars.forEach((c) => c.classList.add('is-visible'));
      tagline?.classList.add('is-visible');
      hero.querySelector<HTMLElement>('.brand-cta-wrap')?.classList.add('is-visible');
      hero.querySelector<HTMLElement>('#hero-laptop-inner')?.classList.add('is-visible');
      galleryCards.forEach((c) => c.classList.add('is-visible'));
      return;
    }

    // ══════════════════════════════════════════
    // SCROLL — Single timeline, single ScrollTrigger
    // ══════════════════════════════════════════

    // Gallery starts hidden — GSAP will reveal it
    gsap.set(galleryStage, { opacity: 0, scale: 0.95 });

    // Initial state: Totem cards stacked together at lowered center stack
    galleryCards.forEach((card) => {
      gsap.set(card, {
        left: '50%',
        top: '65%',
        xPercent: -50,
        yPercent: -50,
        rotation: 0,
        scale: 0.65,
        opacity: 0,
        filter: 'blur(6px)',
      });
    });

    const ctx = gsap.context(() => {

      const master = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: '+=180%',
          scrub: 1,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      // ── Scene 1 exits: brand-stage fades out ──
      if (brandStage) {
        master.to(brandStage, {
          opacity: 0,
          scale: 0.92,
          y: -40,
          filter: 'blur(8px)',
          duration: 3,
          ease: 'power2.inOut',
        }, 0);
      }

      // ── Scene 2 enters: gallery-stage fades in ──
      if (galleryStage) {
        master.to(galleryStage, {
          opacity: 1,
          scale: 1,
          duration: 3,
          ease: 'power2.out',
        }, 2.5);
      }

      // ── Totem Entrance: cards fan out into lowered overlapping dynamic positions ──
      if (galleryCards.length) {
        galleryCards.forEach((card, index) => {
          const targetLeft = parseFloat(card.getAttribute('data-left') || '50');
          const targetTop = parseFloat(card.getAttribute('data-top') || '40');
          const targetRotation = parseFloat(card.getAttribute('data-rotation') || '0');
          const depth = parseFloat(card.getAttribute('data-depth') || '0.5');

          master.to(
            card,
            {
              left: `${targetLeft}%`,
              top: `${targetTop}%`,
              rotation: targetRotation,
              scale: 1,
              opacity: 1,
              filter: 'blur(0px)',
              duration: 2.5,
              ease: 'power3.out',
            },
            2.8 + index * 0.1
          );

          // Parallax depth scrub as user continues scrolling
          master.to(
            card,
            {
              y: `${(1 - depth) * -90}px`,
              ease: 'none',
              duration: 4,
            },
            3.8
          );
        });
      }

    }, hero);

    // Refresh after images load
    const imgs = Array.from(document.images);
    if (imgs.every((img) => img.complete)) {
      ScrollTrigger.refresh();
    } else {
      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
    }

    // Cleanup
    document.addEventListener(
      'astro:before-swap',
      () => { ctx.revert(); },
      { once: true }
    );
  }

  initCinematicEngine();
  document.addEventListener('astro:after-swap', initCinematicEngine);
</script>

<style>
  .cinematic-hero {
    position: relative;
    width: 100%;
    background-color: #080807;
    overflow: clip;
  }

  .brand-stage {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(6rem, 15dvh, 12rem) clamp(1.5rem, 5vw, 5rem);
    z-index: 2;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .brand-stage {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
  }

  .brand-content-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform, opacity;
    flex: 1;
    max-width: 100%;
  }

  @media (min-width: 1024px) {
    .brand-content-wrap {
      align-items: flex-start;
      text-align: start;
    }
  }

  .brand-name {
    position: relative;
    z-index: 2;
    margin: 0;
    line-height: 0.92;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  @media (min-width: 1024px) {
    .brand-name {
      text-align: start;
      align-items: flex-start;
    }
  }

  .brand-line {
    display: flex;
    flex-wrap: nowrap;
    justify-content: inherit;
  }

  .brand-name--en {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 5.2vw, 5.8rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #ffffff;
    word-break: normal;
  }
  .brand-name--ar {
    font-family: var(--font-arabic, serif);
    font-size: clamp(2rem, 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 0;
    color: #ffffff;
    line-height: 1.3;
    padding-bottom: 0.2em;
  }

  .brand-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em) rotateX(-20deg) scale(0.95);
    transform-origin: bottom center;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }
  .brand-char--word {
    transform: translateY(0) rotateX(0deg) scale(1);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .brand-char.is-visible {
    opacity: 1;
    transform: translateY(0) rotateX(0deg) scale(1);
  }

  .brand-tagline {
    margin-top: clamp(2rem, 3.5vw, 3rem);
    font-family: var(--font-sans, 'Outfit', sans-serif);
    font-size: clamp(0.75rem, 1.2vw, 1rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    max-width: 52ch;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @media (min-width: 1024px) {
    .brand-tagline {
      text-align: start;
    }
  }

  .brand-tagline.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .brand-cta-wrap {
    margin-top: 3rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .brand-cta-wrap.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0.75rem 0.75rem 0.75rem 1.75rem;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [dir="rtl"] .hero-cta {
    padding: 0.75rem 1.75rem 0.75rem 0.75rem;
  }

  .hero-cta:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    transform: scale(0.98);
  }

  .hero-cta__text {
    font-family: var(--font-sans, 'Outfit', sans-serif);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-transform: uppercase;
  }

  .hero-cta__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: #ffffff;
    color: #000000;
    border-radius: 50%;
    transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .hero-cta:hover .hero-cta__icon-wrapper {
    transform: translateX(4px) scale(1.05);
  }

  [dir="rtl"] .hero-cta:hover .hero-cta__icon-wrapper {
    transform: translateX(-4px) scale(1.05);
  }

  /* ─── LAPTOP SIDE ─── */
  .brand-laptop-wrap {
    flex: 1.5;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    position: relative;
    min-height: 420px;
    z-index: 3;
    will-change: transform, opacity;
  }

  @media (min-width: 1024px) {
    .brand-laptop-wrap {
      justify-content: flex-end;
    }
  }

  .hero-laptop {
    position: relative;
    width: 160%;
    max-width: 1500px;
    aspect-ratio: 16 / 9;
    pointer-events: none;
    perspective: 1200px;
  }
  
  @media (min-width: 1024px) {
    .hero-laptop {
      width: 200%;
      margin-inline-start: -15%;
    }

    [dir="rtl"] .hero-laptop,
    html[dir="rtl"] .hero-laptop {
      margin-inline-start: 0;
      margin-inline-end: -28%;
    }
  }
  
  .hero-laptop__inner {
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: perspective(1200px) translateY(80px) rotateX(15deg) rotateZ(-5deg) scale(0.85);
    filter: blur(14px);
    will-change: transform, opacity, filter;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 70%, rgba(0, 0, 0, 0) 100%);
  }

  .hero-laptop__inner.is-visible {
    animation: laptopCinematicReveal 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  [dir="rtl"] .hero-laptop__inner {
    transform: perspective(1200px) translateY(80px) rotateX(15deg) rotateZ(5deg) scale(0.85);
  }

  [dir="rtl"] .hero-laptop__inner.is-visible {
    animation: laptopCinematicRevealRtl 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .hero-laptop__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 35px 50px rgba(0, 0, 0, 0.98)) drop-shadow(0 15px 30px rgba(37, 99, 235, 0.3));
  }

  @keyframes laptopCinematicReveal {
    0% {
      opacity: 0;
      transform: perspective(1200px) translateY(80px) rotateX(15deg) rotateZ(-5deg) scale(0.85);
      filter: blur(14px);
    }
    100% {
      opacity: 1;
      transform: perspective(1200px) translateY(0) rotateX(4deg) rotateZ(-3.5deg) scale(1);
      filter: blur(0px);
    }
  }

  @keyframes laptopCinematicRevealRtl {
    0% {
      opacity: 0;
      transform: perspective(1200px) translateY(80px) rotateX(15deg) rotateZ(5deg) scale(0.85);
      filter: blur(14px);
    }
