---
import { Image } from 'astro:assets';
import profileImg from '../../assets/images/profile.png';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

const methodologyPath = `/${lang}/methodology/`;
---

<section class="w-full min-h-[90vh] md:min-h-screen relative overflow-hidden bg-primary-bg flex items-center py-16 md:py-24 border-b border-text-main/5">
  <!-- Fine Grid Backdrop Overlay (smaller squares - 2rem, soft grey tint) -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.035)_1px,transparent_1px)] bg-[size:2rem_2rem] opacity-100 pointer-events-none" aria-hidden="true"></div>
  
  <!-- Premium soft lighting overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(15,23,42,0.02),transparent_70%)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 grid grid-cols-1 md:grid-cols-[55%_45%] gap-12 md:gap-16 items-center">
    
    <!-- Left Column: Content (Appears at bottom on mobile, left on desktop) -->
    <div class="space-y-8 order-2 md:order-1 flex flex-col justify-center">
      
      <div class="space-y-4 max-w-xl">
        <!-- Subtitle Badge with dynamic pulsing dot -->
        <div class="text-[10px] sm:text-xs font-bold tracking-widest text-accent-primary uppercase font-sans flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse" aria-hidden="true"></span>
          {isAr ? "تحليل البيانات والتسويق الرقمي" : "DATA-DRIVEN SYSTEMS"}
        </div>

        <!-- H1 Identity Title using luxury Serif Font -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text-main leading-none font-serif">
          {isAr ? "عمرو موسى" : "Amr Mousa"}
        </h1>

        <!-- Large Value Proposition / Core Belief Statement -->
        <p class="text-xl sm:text-2xl font-bold tracking-tight text-text-main/90 leading-tight font-serif pt-2">
          {isAr ? (
            <>
              تحليل البيانات <span class="text-accent-primary italic font-medium">لكشف الثغرات</span>.<br />والتسويق لمعالجتها.
            </>
          ) : (
            <>
              Data analysis to <span class="text-accent-primary italic font-medium">find leaks</span>.<br />Marketing to solve them.
            </>
          )}
        </p>

        <!-- Core Belief Statement Description -->
        <p class="text-base sm:text-lg text-text-main/70 leading-relaxed pt-2 font-sans">
          {isAr ? (
            "أساعد الشركات على سد فجوات قنوات البيع وتحويل الميزانيات التسويقية المهدرة إلى أرباح حقيقية بقرارات مدعومة بالأرقام."
          ) : (
            "I plug conversion leaks in your sales funnel. I help businesses turn unoptimized ad spend and messy tracking into predictable commercial growth."
          )}
        </p>
      </div>

      <!-- Action Buttons with custom tech-themed styling -->
      <div class="flex flex-col sm:flex-row items-center gap-6 pt-2 font-sans">
        <a 
          href={methodologyPath} 
          class="w-full sm:w-auto px-8 h-12 rounded-full bg-accent-primary hover:bg-accent-highlight text-white font-semibold text-sm transition-all flex items-center justify-center shadow-lg shadow-accent-primary/15 focus-visible:ring-2"
        >
          {isAr ? "استكشف الخدمات" : "Explore Services"}
        </a>
        <a 
          href="#contact" 
          class="w-full sm:w-auto px-6 h-12 text-text-main hover:bg-text-main/5 border border-transparent hover:border-text-main/10 rounded-full font-bold text-sm transition-all flex items-center justify-center focus-visible:ring-2"
        >
          {isAr ? "تعرف عليّ" : "Get to Know Me"}
        </a>
      </div>

    </div>

    <!-- Right Column: Profile Image (Appears at top on mobile, right on desktop) -->
    <div class="order-1 md:order-2 flex justify-center md:justify-end">
      <!-- Glow behind portrait -->
      <div class="relative w-full max-w-[280px] sm:max-w-[320px]">
        <div class="absolute inset-0 bg-accent-primary/5 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
        
        <!-- Luxury Portrait Frame (Chic Vertical Rectangular Frame aspect-3/4 with classic white border) -->
        <div class="relative w-full aspect-[3/4] rounded-[2rem] p-2 bg-white border border-text-main/8 shadow-2xl shadow-text-main/3">
          <div class="w-full h-full rounded-[1.75rem] overflow-hidden">
            <Image 
              src={profileImg} 
              alt={isAr ? "عمرو موسى" : "Amr Mousa"} 
              class="w-full h-full object-cover object-center"
              width={640}
              height={853}
              loading="eager"
            />
          </div>
          
          <!-- Mock Analytics Widget 1 (Top-Right overlay) -->
          <div class="absolute -top-3 -end-4 bg-white border border-text-main/8 rounded-2xl px-4 py-2.5 shadow-xl flex items-center gap-2 z-30 font-sans text-xs font-bold text-text-main whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>{isAr ? "العائد: +182.4%" : "ROI: +182.4%"}</span>
          </div>

          <!-- Mock Analytics Widget 2 (Bottom-Left overlay) -->
          <div class="absolute -bottom-3 -start-4 bg-white border border-text-main/8 rounded-2xl px-4 py-2.5 shadow-xl flex items-center gap-2 z-30 font-sans text-xs font-bold text-text-main whitespace-nowrap">
            <i class="fa-solid fa-chart-pie text-accent-primary text-sm"></i>
            <span>{isAr ? "التتبع: مفعل" : "Tracking: GA4"}</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
