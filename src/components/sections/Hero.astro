---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import analyticsBgImgDesktop from '../../assets/images/analyst-side-bg-desktop.png';
import analyticsBgImgMobile from '../../assets/images/analyst-side-bg-mobile.png';
import { getSafeSocials } from '../../scripts/socialsHelper';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

const socials = await getSafeSocials(lang);

// Fetch localized hero data dynamically without hardcoding
const heroEntry = await getEntry('hero', lang);
const heroData = heroEntry?.data || {
  title: isAr ? "بياناتك وتسويقك... بسطناها" : "Your Data & Marketing... Simplified.",
  eyebrow: isAr ? "وظّف عقلاً تحليلياً" : "HIRE AN ANALYTICAL MIND",
  bio: isAr ? "المنظومة الموحدة لتتبع البيانات وإدارة الحملات لتحقيق نمو قابل للتنبؤ." : "The unified analytics system to track metrics and scale ad campaigns for predictable business growth.",
  primaryBtn: isAr ? "ناقش استراتيجيتك" : "Discuss Your Strategy",
  secondaryBtn: isAr ? "استكشف الخدمات" : "Explore Services",
  floatingBadge: isAr ? "البيانات + شراء الإعلانات" : "Data + Media Buying",
  statLeftTitle: isAr ? "محرك المبيعات" : "SALES ENGINE",
  statLeftVal: "+182%",
  statRightTitle: isAr ? "تكامل النظام" : "SYSTEM INTEGRATION",
  statRightVal: isAr ? "بيانات + إعلانات" : "Data + Ads",
  trendingLabel: isAr ? "الخدمات الأكثر طلباً:" : "Trending Services:",
  trendingItems: isAr ? "تتبع البيانات • الحملات الإعلانية • تهيئة التحويل" : "Data Tracking • Ad Scaling • Conversion Optimization"
};

// Parse trending items into individual pills
const trendingPills = heroData.trendingItems.split('•').map((s: string) => s.trim()).filter(Boolean);

// Icons for each trending service pill (mapped by index)
const pillIcons = ['fa-solid fa-chart-line', 'fa-solid fa-bullhorn', 'fa-solid fa-arrow-trend-up'];

// Dynamically highlight key terms for title B2B aesthetics
const highlightTitle = (text: string) => {
  let highlighted = text
    .replace(/\bSimplified\.\b/gi, '<span class="text-accent-primary italic font-medium">Simplified.</span>')
    .replace(/بسطناها/g, '<span class="text-accent-primary italic font-medium">بسطناها</span>');

  return highlighted;
};

// Dynamically highlight key terms for B2B aesthetics
const highlightText = (text: string) => {
  // If the language is Arabic (contains Arabic characters), return unmodified to keep it clean and natural
  const hasArabic = /[\u0600-\u06FF]/.test(text);
  if (hasArabic) {
    return text;
  }

  let highlighted = text
    .replace(/\bsmart decisions\b/gi, '<span class="font-serif italic font-medium text-accent-primary">smart decisions</span>')
    .replace(/\breal profit\b/gi, '<span class="text-text-main font-medium underline decoration-accent-primary/50 decoration-2 underline-offset-4">real profit</span>');

  return highlighted;
};
---

<section class="w-full min-h-screen relative overflow-hidden bg-primary-bg flex items-center py-20 md:py-28 border-b border-text-main/5">
  
  <!-- Parallax background wrapper covering 100% of the section -->
  <div class="scroll-bg-image absolute inset-0 z-0 pointer-events-none select-none transition-transform duration-100 ease-out origin-center">
    <!-- Desktop background image (16:9 ratio, aligned to bottom to show the desk) -->
    <Image 
      src={analyticsBgImgDesktop} 
      alt="" 
      class:list={[
        "hidden md:block w-full h-full object-cover object-bottom opacity-90 md:opacity-95",
        isAr && "scale-x-[-1]"
      ]}
      loading="eager"
      fetchpriority="high"
    />
    <!-- Mobile background image (9:16 ratio, aligned to bottom to show the desk) -->
    <Image 
      src={analyticsBgImgMobile} 
      alt="" 
      class:list={[
        "block md:hidden w-full h-full object-cover object-bottom opacity-90",
        isAr && "scale-x-[-1]"
      ]}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Ambient overlays for high text contrast and edge blending -->
  <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-primary-bg to-transparent pointer-events-none z-1" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-primary-bg to-transparent pointer-events-none z-1" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-primary-bg/25 pointer-events-none z-1" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col items-center justify-center my-auto">
    
    <div class="w-full max-w-2xl flex flex-col items-center text-center gap-3 z-10 transform translate-y-0">
      <div class="hidden" aria-hidden="true"></div>

      <!-- Small elegant minimalist monogram -->
      <div class="w-7 h-7 rounded-full bg-text-main/5 border border-text-main/10 flex items-center justify-center text-text-main font-serif text-[10px] font-bold select-none animate-fade-in mb-1.5" aria-hidden="true">
        A
      </div>

      <h1 
        class:list={[
          "text-[clamp(1.7rem,4.2vw,2.65rem)] leading-[1.2] font-serif text-text-main max-w-xl drop-shadow-sm",
          isAr ? "font-medium tracking-normal" : "font-semibold tracking-tight"
        ]}
        set:html={highlightTitle(heroData.title)}
      />

      <p 
        class:list={[
          "text-[13px] md:text-[15px] text-text-main/70 leading-relaxed font-sans max-w-lg font-light",
          isAr ? "tracking-normal" : "tracking-wide"
        ]}
        set:html={highlightText(heroData.bio)}
      />

      <div class="flex flex-row items-center justify-center gap-3 w-full pt-2 font-sans">
        <a 
          href={`/${lang}/#contact`} 
          class="h-11 px-6 rounded-full bg-text-main hover:bg-text-main/90 text-white text-[11px] font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 min-w-[140px]"
        >
          <span>{heroData.primaryBtn}</span>
        </a>
        <a 
          href={`/${lang}/#services`} 
          class="h-11 px-6 rounded-full bg-white border border-text-main/15 hover:bg-text-main/5 text-text-main text-[11px] font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 min-w-[140px]"
        >
          <span>{heroData.secondaryBtn}</span>
        </a>
      </div>

      <div class="flex items-center justify-center gap-2 pt-3.5 mt-1 w-full max-w-[200px] border-t border-text-main/5">
        {socials.map((item) => (
          <a 
            href={item.data.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-text-main/35 hover:text-accent-primary transition-all duration-300 text-[13px] p-2 inline-flex items-center justify-center"
            aria-label={item.data.name}
            title={item.data.name}
          >
            <i class={item.data.icon} aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </div>

  </div>

  <!-- Trending Services Bar -->
  <div class="absolute bottom-4 sm:bottom-6 md:bottom-8 inset-x-0 z-20 w-full max-w-3xl mx-auto px-6 flex flex-col items-center gap-2.5 select-none">
    <!-- Label -->
    <span class:list={[
      "text-[9px] md:text-[10px] font-semibold uppercase text-text-main/40 font-sans",
      isAr ? "tracking-normal" : "tracking-[0.16em]"
    ]}>
      {heroData.trendingLabel}
    </span>
    <!-- Pills Row -->
    <div class="flex flex-wrap items-center justify-center gap-2 md:gap-2.5">
      {trendingPills.map((pill: string, i: number) => (
        <div class="trending-pill group flex items-center gap-1.5 px-3 py-1.5 md:px-4 md:py-2 rounded-full bg-white/60 backdrop-blur-sm border border-text-main/8 transition-all duration-300 hover:bg-white/90 hover:border-accent-primary/20 hover:shadow-[0_2px_12px_rgba(37,99,235,0.08)] cursor-default" style={`animation-delay: ${i * 120}ms`}>
          <i class={`${pillIcons[i] || 'fa-solid fa-circle-check'} text-[9px] md:text-[10px] text-accent-primary/60 group-hover:text-accent-primary transition-colors duration-300`} aria-hidden="true"></i>
          <span class="text-[10px] md:text-[11px] font-semibold text-text-main/75 group-hover:text-text-main tracking-wide font-sans transition-colors duration-300 whitespace-nowrap">
            {pill}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // High-performance background image scroll parallax
  function initScrollParallax() {
    const bgImg = document.querySelector('.scroll-bg-image') as HTMLElement | null;
    if (!bgImg) return;

    const onScroll = () => {
      // Respect prefers-reduced-motion setting
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        bgImg.style.transform = '';
        return;
      }
      const scrolled = window.scrollY;
      const speed = window.innerWidth < 768 ? 0.05 : 0.12;
      bgImg.style.transform = `translate3d(0, ${scrolled * speed}px, 0)`;
    };

    let ticked = false;
    const handleScroll = () => {
      if (!ticked) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticked = false;
        });
        ticked = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', handleScroll);
    }, { once: true });
  }

  // Initial load binding
  initScrollParallax();
  
  // Re-bind to Astro view transition swap lifecycle hooks
  document.addEventListener('astro:after-swap', () => {
    initScrollParallax();
  });
</script>

<style>
  .trending-pill {
    animation: fadeInUp 0.5s ease-out both;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Accessible user-preference fallback */
  @media (prefers-reduced-motion: reduce) {
    .trending-pill {
      animation: fadeIn 0.1ms both !important;
    }
    .scroll-bg-image {
      transform: none !important;
      transition: none !important;
    }
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
