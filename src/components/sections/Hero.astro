---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import analyticsBgImgDesktop from '../../assets/images/analyst-side-bg-desktop.png';
import analyticsBgImgMobile from '../../assets/images/analyst-side-bg-mobile.png';
import { getSafeSocials } from '../../scripts/socialsHelper';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

const socials = await getSafeSocials(lang);

// Fetch localized hero data dynamically without hardcoding
const heroEntry = await getEntry('hero', lang);
const heroData = heroEntry?.data || {
  title: isAr ? "بياناتك وتسويقك... بسطناها" : "Your Data & Marketing... Simplified.",
  eyebrow: isAr ? "وظّف عقلاً تحليلياً" : "HIRE AN ANALYTICAL MIND",
  bio: isAr ? "المنظومة الموحدة لتتبع البيانات وإدارة الحملات لتحقيق نمو قابل للتنبؤ." : "The unified analytics system to track metrics and scale ad campaigns for predictable business growth.",
  primaryBtn: isAr ? "ناقش استراتيجيتك" : "Discuss Your Strategy",
  secondaryBtn: isAr ? "استكشف الخدمات" : "Explore Services",
  floatingBadge: isAr ? "البيانات + شراء الإعلانات" : "Data + Media Buying",
  statLeftTitle: isAr ? "محرك المبيعات" : "SALES ENGINE",
  statLeftVal: "+182%",
  statRightTitle: isAr ? "تكامل النظام" : "SYSTEM INTEGRATION",
  statRightVal: isAr ? "بيانات + إعلانات" : "Data + Ads",
  trendingLabel: isAr ? "الخدمات الأكثر طلباً:" : "Trending Services:",
  trendingItems: isAr ? "تتبع البيانات • الحملات الإعلانية • تهيئة التحويل" : "Data Tracking • Ad Scaling • Conversion Optimization"
};

// Dynamically highlight key terms for title B2B aesthetics
const highlightTitle = (text: string) => {
  let highlighted = text
    .replace(/\bSimplified\.\b/gi, '<span class="text-accent-primary italic font-medium">Simplified.</span>')
    .replace(/بسطناها/g, '<span class="text-accent-primary italic font-medium">بسطناها</span>');

  return highlighted;
};

// Dynamically highlight key terms for B2B aesthetics
const highlightText = (text: string) => {
  let highlighted = text
    .replace(/\banalytics system\b/gi, '<span class="font-serif italic font-medium text-accent-primary">analytics system</span>')
    .replace(/\bmetrics\b/gi, '<span class="text-text-main font-medium underline decoration-accent-primary/50 decoration-2 underline-offset-4">metrics</span>')
    .replace(/\bpredictable business growth\b/gi, '<span class="font-serif italic font-medium text-accent-primary">predictable business growth</span>');

  highlighted = highlighted
    .replace(/المنظومة الموحدة/g, '<span class="font-serif italic font-medium text-accent-primary">المنظومة الموحدة</span>')
    .replace(/تتبع البيانات/g, '<span class="text-text-main font-medium underline decoration-accent-primary/50 decoration-2 underline-offset-4">تتبع البيانات</span>')
    .replace(/نمو قابل للتنبؤ/g, '<span class="font-serif italic font-medium text-accent-primary">نمو قابل للتنبؤ</span>');

  return highlighted;
};
---

<section class="w-full min-h-screen relative overflow-hidden bg-primary-bg flex items-center py-20 md:py-28 border-b border-text-main/5">
  
  <!-- Parallax background wrapper covering 100% of the section -->
  <div class="scroll-bg-image absolute inset-0 z-0 pointer-events-none select-none transition-transform duration-100 ease-out origin-center">
    <!-- Desktop background image (16:9 ratio, aligned to bottom to show the desk) -->
    <Image 
      src={analyticsBgImgDesktop} 
      alt="" 
      class:list={[
        "hidden md:block w-full h-full object-cover object-bottom opacity-90 md:opacity-95",
        isAr && "scale-x-[-1]"
      ]}
      loading="eager"
      fetchpriority="high"
    />
    <!-- Mobile background image (9:16 ratio, aligned to bottom to show the desk) -->
    <Image 
      src={analyticsBgImgMobile} 
      alt="" 
      class:list={[
        "block md:hidden w-full h-full object-cover object-bottom opacity-90",
        isAr && "scale-x-[-1]"
      ]}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Ambient overlays for high text contrast and edge blending -->
  <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-primary-bg to-transparent pointer-events-none z-1" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-primary-bg to-transparent pointer-events-none z-1" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-primary-bg/25 pointer-events-none z-1" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col items-center justify-center my-auto">
    
    <!-- Text Content Column aligned to the center -->
    <div class="w-full max-w-3xl flex flex-col items-center text-center space-y-8 z-10">
      
      <!-- Brand Logo & Eyebrow -->
      <div class="flex flex-col items-center gap-2 select-none animate-fade-in">
        <div class="flex items-center gap-3">
          <!-- Circular emblem with a dark background and clean serif letter inside -->
          <span class="w-9 h-9 rounded-full bg-text-main flex items-center justify-center text-white font-serif text-sm font-bold shadow-md shadow-text-main/10 select-none" aria-hidden="true">
            A
          </span>
          <!-- Brand name: regular serif + colored italic serif -->
          <span class="font-serif text-base md:text-lg font-bold text-text-main tracking-tight">
            {isAr ? "موسى" : "Mousa"} <span class="text-accent-primary italic font-medium">{isAr ? "للتحليلات" : "Analytics"}</span>
          </span>
        </div>
        <span class="text-[9px] sm:text-xs font-bold tracking-[0.25em] text-accent-primary uppercase font-sans">
          {heroData.eyebrow}
        </span>
      </div>

      <!-- H1 Outcome Headline -->
      <h1 
        class="text-[clamp(1.8rem,4.8vw,3.3rem)] font-bold tracking-tight leading-[1.2] font-serif text-text-main max-w-2xl drop-shadow-sm"
        set:html={highlightTitle(heroData.title)}
      />

      <!-- Systems Bio Description -->
      <p 
        class="text-sm sm:text-base md:text-lg text-text-main/80 leading-relaxed font-sans max-w-xl font-light tracking-wide pt-1"
        set:html={highlightText(heroData.bio)}
      />

      <!-- Call to Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full pt-4 font-sans z-20">
        <!-- Primary Action: Discuss Your Strategy -->
        <a 
          href={`/${lang}/#contact`} 
          class="h-12 px-8 rounded-full bg-text-main hover:bg-text-main/90 text-white text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 shadow-md hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto"
        >
          <i class="fa-solid fa-comments text-sm text-white/80"></i>
          <span>{heroData.primaryBtn}</span>
        </a>

        <!-- Secondary Action: Explore Services -->
        <a 
          href={`/${lang}/#services`} 
          class="h-12 px-8 rounded-full bg-white border border-text-main/15 hover:bg-text-main/5 text-text-main text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 shadow-md hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto"
        >
          <i class="fa-solid fa-layer-group text-sm text-text-main/70"></i>
          <span>{heroData.secondaryBtn}</span>
        </a>
      </div>

      <!-- Trending services list -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-[11px] sm:text-xs text-text-main/60 animate-fade-in select-none pt-2">
        <span>{heroData.trendingLabel}</span>
        {heroData.trendingItems.split(' • ').map((item: string) => (
          <span class="text-text-main bg-white hover:bg-text-main/5 border border-text-main/8 rounded-full px-3 py-1 transition-all duration-300">
            {item}
          </span>
        ))}
      </div>

      <!-- Social Links -->
      {socials.length > 0 && (
        <div class="pt-8 flex items-center justify-center gap-6 w-full max-w-xs z-10 select-none border-t border-text-main/5">
          {socials.map((item) => (
            <a 
              href={item.data.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-text-main/40 hover:text-accent-primary transition-all duration-300 text-sm hover:-translate-y-0.5 hover:scale-110 inline-block"
              aria-label={item.data.name}
              title={item.data.name}
            >
              <i class={item.data.icon} aria-hidden="true"></i>
            </a>
          ))}
        </div>
      )}

    </div>

  </div>
</section>

<script>
  // High-performance background image scroll parallax
  function initScrollParallax() {
    const bgImg = document.querySelector('.scroll-bg-image') as HTMLElement | null;
    if (!bgImg) return;

    const onScroll = () => {
      const scrolled = window.scrollY;
      const speed = window.innerWidth < 768 ? 0.05 : 0.12;
      bgImg.style.transform = `translate3d(0, ${scrolled * speed}px, 0)`;
    };

    let ticked = false;
    const handleScroll = () => {
      if (!ticked) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticked = false;
        });
        ticked = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', handleScroll);
    }, { once: true });
  }

  // Initial load binding
  initScrollParallax();
  
  // Re-bind to Astro view transition swap lifecycle hooks
  document.addEventListener('astro:after-swap', () => {
    initScrollParallax();
  });
</script>
