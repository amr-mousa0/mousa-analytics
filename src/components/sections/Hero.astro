---
import { getImage } from 'astro:assets';
import analyticsBgImgDesktop from '../../assets/images/analyst-side-bg-desktop.png';
import analyticsBgImgMobile from '../../assets/images/analyst-side-bg-mobile.png';
import powerBiImg from '../../assets/images/power bi.webp';
import mediaBuyingImg from '../../assets/images/media-buying.webp';
import crmImg from '../../assets/images/Crm.webp';
import portfolioImg from '../../assets/images/Portfolio.webp';
import amrMousaAvatar from '../../assets/images/amr-mousa.webp';
import Icon from '../ui/Icon.astro';
import { useTranslations } from '../../i18n/index.js';
import { ContentFacade } from '../../lib/content/facade.js';

interface Props {
  lang: string;
  desktopImg?: any;
  mobileImg?: any;
}

const { lang, desktopImg: propDesktopImg, mobileImg: propMobileImg } = Astro.props;
const isAr = lang === 'ar';
const t = useTranslations(lang);

const socials = await ContentFacade.getSocials(lang as 'en' | 'ar');

// Fetch localized hero data dynamically via ContentFacade (Single Source of Truth)
const heroEntry = await ContentFacade.getHeroEntry(lang as 'en' | 'ar');
const heroData = heroEntry?.data || {
  title: t.hero.headline,
  bio: t.hero.subheadline,
  primaryBtn: t.hero.primaryCta,
  secondaryBtn: t.hero.secondaryCta,
  trendingLabel: t.hero.guaranteesLabel,
  trendingItems: `${t.hero.trustCard0} • ${t.hero.trustCard1} • ${t.hero.trustCard2}`
};

// Fallback to build-time optimization if not passed as props (defensive design)
const desktopImg = propDesktopImg || (await getImage({ src: analyticsBgImgDesktop, quality: 85, format: 'webp' }));
const mobileImg = propMobileImg || (await getImage({ src: analyticsBgImgMobile, quality: 80, format: 'webp' }));

// Dynamically highlight key terms for title B2B aesthetics
const highlightTitle = (text: string) => {
  let highlighted = text
    .replace(/\bSimplified\.\b/gi, '<span class="text-accent-primary italic font-medium">Simplified.</span>')
    .replace(/بسطناها/g, '<span class="text-accent-primary font-medium">بسطناها</span>');

  return highlighted;
};

// Dynamically highlight key terms for B2B aesthetics
const highlightText = (text: string) => {
  // If the language is Arabic (contains Arabic characters), return unmodified to keep it clean and natural
  const hasArabic = /[\u0600-\u06FF]/.test(text);
  if (hasArabic) {
    return text;
  }

  let highlighted = text
    .replace(/\bsmart decisions\b/gi, '<span class="italic font-medium text-accent-primary">smart decisions</span>')
    .replace(/\breal profit\b/gi, '<span class="text-text-main font-medium underline decoration-accent-primary/50 decoration-2 underline-offset-4">real profit</span>');

  return highlighted;
};
---

<section id="hero" class="w-full min-h-[100dvh] relative overflow-hidden bg-primary-bg flex flex-col items-center justify-center pt-16 pb-12 md:py-28">
  
  <!-- Parallax background wrapper covering 100% of the section -->
  <div class="scroll-bg-image absolute inset-0 z-0 pointer-events-none select-none transition-transform duration-100 ease-out origin-center">
    <!-- Single <picture> element: browser downloads ONLY the matching source per viewport -->
    <picture>
      <source media="(min-width: 768px)" srcset={desktopImg.src} type="image/webp" />
      <img 
        src={mobileImg.src} 
        alt="" 
        class="w-full h-full object-cover object-center-bottom opacity-90 md:opacity-95"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={mobileImg.attributes.width || 750}
        height={mobileImg.attributes.height || 1334}
      />
    </picture>
  </div>

  <!-- Ambient overlays for high text contrast and edge blending -->
  <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-primary-bg to-transparent pointer-events-none z-1" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-primary-bg to-transparent pointer-events-none z-1" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-primary-bg/25 pointer-events-none z-1" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col items-center justify-center my-auto">
    
    <div class="w-full max-w-2xl flex flex-col items-center text-center gap-3 z-10 transform translate-y-0">

      <!-- Small elegant minimalist monogram -->
      <div class="w-7 h-7 flex items-center justify-center text-text-main select-none animate-fade-in mb-1.5" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="w-full h-full text-text-main" fill="none">
          <defs>
            <linearGradient id="logo-grad-hero" x1="20" y1="10" x2="90" y2="60" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#0F4C5C" />
              <stop offset="100%" stop-color="var(--color-accent-primary)" />
            </linearGradient>
            <linearGradient id="logo-accent-grad-hero" x1="10" y1="35" x2="30" y2="60" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#38BDF8" />
              <stop offset="100%" stop-color="#64FFDA" />
            </linearGradient>
          </defs>
          <g transform="translate(2.5, 12.5) scale(0.95)">
            <path
              d="M 21.5,59.5 C 16.5,59.5 13.0,55.0 12.0,49.0 C 11.0,43.0 14.0,37.0 18.0,37.5 C 22.0,38.0 25.0,44.0 27.5,48.0 C 30.0,52.0 26.5,59.5 21.5,59.5 Z"
              fill="url(#logo-accent-grad-hero)" />
            <path
              d="M 52.38,59.37 C 48.00,59.37 45.00,57.50 44.50,55.95 L 28.44,22.34 C 26.80,21.00 24.72,21.00 23.09,21.75 C 26.00,14.50 29.50,10.00 32.16,10.00 C 34.83,10.00 37.00,11.00 38.85,12.23 L 56.10,47.32 C 58.00,48.36 60.00,48.36 61.15,47.62 C 58.00,56.00 55.00,59.37 52.38,59.37 Z M 45.62,26.00 Q 47.67,30.16 52.79,26.00 L 52.79,35.00 L 45.62,35.00 Z"
              fill="url(#logo-grad-hero)" />
            <path
              d="M 81.22,59.37 C 76.84,59.37 73.84,57.50 73.34,55.95 L 64.28,37.00 Q 62.31,32.87 57.26,37.00 L 52.82,40.63 L 50.00,59.37 L 36.52,39.28 L 57.28,22.34 C 55.64,21.00 53.56,21.00 51.93,21.75 C 54.84,14.50 58.34,10.00 61.00,10.00 C 63.67,10.00 65.84,11.00 67.69,12.23 L 84.94,47.32 C 86.84,48.36 88.84,48.36 89.99,47.62 C 86.84,56.00 83.84,59.37 81.22,59.37 Z"
              fill="url(#logo-grad-hero)" />
            <path d="M 19.80,48.50 L 53.98,43.00 L 82.82,43.00" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="1" />
            <circle cx="19.80" cy="48.50" r="3" fill="#38BDF8" />
            <circle cx="53.98" cy="43.00" r="3" fill="#38BDF8" />
            <circle cx="82.82" cy="43.00" r="3" fill="#38BDF8" />
          </g>
        </svg>
      </div>

      <h1 
        class:list={[
          "text-[clamp(1.7rem,4.2vw,2.65rem)] leading-snug text-text-main max-w-xl drop-shadow-sm",
          isAr ? "font-medium tracking-normal" : "font-semibold tracking-tight"
        ]}
        set:html={highlightTitle(heroData.title)}
      />

      <p 
        class:list={[
          "w-full text-[13px] md:text-[15px] text-text-main/70 leading-relaxed font-sans font-light text-center",
          isAr ? "tracking-normal" : "tracking-wide"
        ]}
        set:html={highlightText(heroData.bio)}
      />

      <div class="flex flex-row items-center justify-center gap-3 w-full pt-2 font-sans">
        <a 
          href={lang === 'ar' ? '/#contact' : '/en/#contact'} 
          class="h-11 px-6 rounded-full bg-text-main hover:bg-text-main/90 text-white text-[11px] font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 min-w-[140px]"
        >
          <span>{heroData.primaryBtn}</span>
        </a>
        <a 
          href={lang === 'ar' ? '/#services' : '/en/#services'} 
          class="h-11 px-6 rounded-full bg-transparent border border-text-main/15 hover:bg-text-main/5 text-text-main text-[11px] font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 min-w-[140px]"
        >
          <span>{heroData.secondaryBtn}</span>
        </a>
      </div>

      <div class="flex items-center justify-center gap-2 pt-3.5 mt-1 w-full max-w-[200px] border-t border-text-main/5">
        {socials.map((item) => (
          <a 
            href={item.data.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-text-main/35 hover:text-accent-primary transition-all duration-300 text-[13px] p-2 inline-flex items-center justify-center"
            aria-label={item.data.name}
            title={item.data.name}
          >
            <Icon name={item.data.icon} class="w-4 h-4" />
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- 2. Floating Visual Collage (Replaces old trust cards section) -->
<section class="w-full relative overflow-hidden bg-primary-bg py-10 sm:py-18 md:py-28 border-b border-text-main/5 select-none min-h-[500px] sm:min-h-[640px] md:min-h-[850px] flex items-center justify-center">
  <!-- Background Ambient Radial Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.06)_0%,transparent_70%)] pointer-events-none" aria-hidden="true"></div>

  <!-- Central Anchor Title -->
  <div class="absolute inset-0 z-20 flex flex-col items-center justify-center text-center px-4 pointer-events-none">
    <h2 class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-bold text-text-main tracking-tighter leading-tight drop-shadow-md whitespace-pre-line select-none">
      {t.hero.collageTitle}
    </h2>
  </div>

  <!-- Perfectly Balanced Floating Canvas Layout -->
  <div class="relative z-10 w-full max-w-[1400px] mx-auto min-h-[480px] sm:min-h-[620px] md:min-h-[830px]">
    
    <!-- 1. Top-Left: Image Card with CAPI Glass Overlay -->
    <div class="absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="left: 4.5%; top: 4%; width: clamp(130px, 24vw, 340px); height: clamp(95px, 17vw, 250px); z-index: 5;">
      <img src={powerBiImg.src} alt="" class="w-full h-full object-cover opacity-90" />
      <div class="absolute bottom-2 left-2 right-2 sm:bottom-3 sm:left-3 sm:right-3 bg-hero-card/90 backdrop-blur-2xl border border-text-main/15 rounded-xl sm:rounded-2xl p-1.5 sm:p-3 shadow-lg">
        <div class="flex justify-between items-center mb-1">
          <span class="font-mono text-[7px] sm:text-[9px] text-text-main font-bold uppercase tracking-wider truncate">{t.hero.collageTagCapi}</span>
          <span class="font-mono text-[7px] sm:text-[9px] text-accent-primary font-bold shrink-0">99.4%</span>
        </div>
        <div class="w-full bg-text-main/10 rounded-full h-1 sm:h-1.5 overflow-hidden">
          <div class="bg-accent-primary w-[99.4%] h-full rounded-full"></div>
        </div>
      </div>
    </div>

    <!-- 2. Top-Right: Image Card with Chart Icon -->
    <div class="absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="right: 4.5%; top: 5%; width: clamp(125px, 22vw, 310px); height: clamp(125px, 23vw, 330px); z-index: 5;">
      <img src={mediaBuyingImg.src} alt="" class="w-full h-full object-cover opacity-90" />
      <div class="absolute top-2 right-2 sm:top-3 sm:right-3 w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-hero-card/80 backdrop-blur-md border border-text-main/20 flex items-center justify-center shadow-sm text-accent-primary">
        <Icon name="chart-line" class="w-3 h-3 sm:w-4 sm:h-4" />
      </div>
      <div class="absolute bottom-2 left-2 right-2 sm:bottom-3 sm:left-3 sm:right-3 bg-hero-card/90 backdrop-blur-xl border border-text-main/15 px-2 py-1 sm:px-3 sm:py-1.5 rounded-full shadow-sm text-center">
        <span class="font-mono text-[7px] sm:text-[9px] font-bold text-text-main uppercase tracking-wider truncate block">{t.hero.collageTagRoas}</span>
      </div>
    </div>

    <!-- 3. Mid-Left: Floating Glass Auto-Sync Switch -->
    <div class="absolute rounded-xl sm:rounded-2xl overflow-hidden bg-hero-card/90 backdrop-blur-2xl border border-text-main/20 shadow-xl p-2 sm:p-3.5 flex flex-col gap-1 sm:gap-2.5 transition-transform duration-500 hover:scale-105" 
         style="left: 2.5%; top: 44%; width: clamp(125px, 20vw, 275px); z-index: 30;">
      <div class="flex items-center justify-between">
        <span class="font-sans text-[8px] sm:text-xs font-bold text-text-main truncate max-w-[75%]">{t.hero.collageAutoSyncTitle}</span>
        <div class="w-5 h-3 sm:w-8 sm:h-4.5 bg-accent-primary rounded-full relative shadow-inner shrink-0">
          <div class="absolute right-0.5 top-0.5 w-2 h-2 sm:w-3.5 sm:h-3.5 bg-white rounded-full shadow-sm"></div>
        </div>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <div class="w-5 h-5 sm:w-8 sm:h-8 rounded-full bg-accent-primary/10 text-accent-primary flex items-center justify-center shrink-0">
          <Icon name="rotate" class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5" />
        </div>
        <div class="flex flex-col overflow-hidden">
          <span class="font-mono text-[7px] sm:text-[10px] font-bold text-text-main truncate">Meta CAPI & GA4</span>
          <span class="font-sans text-[6px] sm:text-[9px] text-text-main/70 truncate">{t.hero.collageAutoSyncStatus}</span>
        </div>
      </div>
    </div>

    <!-- 4. Mid-Right: Image Card with CRM Badge -->
    <div class="absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="right: 3%; top: 48%; width: clamp(130px, 23vw, 330px); height: clamp(90px, 16vw, 230px); z-index: 30;">
      <img src={crmImg.src} alt="" class="w-full h-full object-cover opacity-90" />
      <div class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-hero-card/90 backdrop-blur-xl px-2 py-1 sm:px-3 sm:py-1.5 rounded-full border border-text-main/15 shadow-sm flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-success-primary animate-pulse"></span>
        <span class="font-mono text-[7px] sm:text-[9px] font-bold text-text-main uppercase tracking-wider truncate">{t.hero.collageTagCrm}</span>
      </div>
    </div>

    <!-- 5. Bottom-Left: Conversion Funnel Image Card -->
    <div class="absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="left: 8.5%; top: 72%; width: clamp(135px, 24vw, 370px); height: clamp(95px, 17vw, 250px); z-index: 5;">
      <img src={portfolioImg.src} alt="" class="w-full h-full object-cover opacity-90" />
      <div class="absolute bottom-2 left-2 sm:bottom-3 sm:left-3 bg-hero-card/90 backdrop-blur-xl px-2 py-1 sm:px-3 sm:py-1.5 rounded-full border border-text-main/15 shadow-sm flex items-center gap-1 text-accent-primary">
        <Icon name="sliders" class="w-2.5 h-2.5 sm:w-3 sm:h-3" />
        <span class="font-mono text-[7px] sm:text-[9px] font-bold text-text-main uppercase tracking-wider truncate">{t.hero.collageTagFunnel}</span>
      </div>
    </div>

    <!-- 6. Bottom-Right: Wide Preview Card -->
    <div class="absolute rounded-2xl sm:rounded-3xl overflow-hidden bg-hero-card/85 backdrop-blur-xl border border-text-main/15 shadow-xl sm:shadow-2xl transition-transform duration-500 hover:scale-105" 
         style="right: 8.5%; top: 76%; width: clamp(130px, 23vw, 350px); height: clamp(90px, 16vw, 230px); z-index: 5;">
      <img src={powerBiImg.src} alt="" class="w-full h-full object-cover opacity-90" />
    </div>

    <!-- 7. Bottom Center: Floating Profile Pill Badge (Top Layer z-40) -->
    <div class="absolute bg-hero-card/95 backdrop-blur-2xl rounded-full flex items-center gap-2 sm:gap-3 px-3 py-1.5 sm:px-4 sm:py-2 shadow-2xl border border-text-main/20 z-40 transition-transform duration-500 hover:scale-105" 
         style="left: 50%; top: 90%; transform: translateX(-50%); width: max-content;">
      <div class="w-6 h-6 sm:w-9 sm:h-9 rounded-full overflow-hidden shadow-sm border border-accent-primary/40 shrink-0">
        <img src={amrMousaAvatar.src} alt="Amr Mousa" class="w-full h-full object-cover" />
      </div>
      <div class="flex flex-col pr-1.5 sm:pr-2.5 text-start">
        <span class="font-sans text-[9px] sm:text-[11px] text-text-main font-bold">{t.hero.collageProfileName}</span>
        <span class="font-sans text-[8px] sm:text-[11px] text-accent-primary font-semibold leading-tight">{t.hero.collageProfileQuote}</span>
      </div>
    </div>

  </div>
</section>

<script>
  // High-performance background image scroll parallax (desktop only)
  function initScrollParallax() {
    const bgImg = document.querySelector('.scroll-bg-image') as HTMLElement | null;
    if (!bgImg) return;
    
    // Skip parallax on mobile - the 0.05 speed is barely visible but wastes scroll performance
    const isMobile = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    if (isMobile) {
      bgImg.style.transform = '';
      return;
    }

    const onScroll = () => {
      // Respect prefers-reduced-motion setting
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        bgImg.style.transform = '';
        return;
      }
      const scrolled = window.scrollY;
      bgImg.style.transform = `translate3d(0, ${scrolled * 0.12}px, 0)`;
    };

    let ticked = false;
    const handleScroll = () => {
      if (!ticked) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticked = false;
        });
        ticked = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', handleScroll);
    }, { once: true });
  }

  // Initial load binding
  initScrollParallax();
  
  // Re-bind to Astro view transition swap lifecycle hooks
  document.addEventListener('astro:after-swap', () => {
    initScrollParallax();
  });
</script>

<style>
  .trust-card {
    animation: fadeInUp 0.5s ease-out both;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Accessible user-preference fallback */
  @media (prefers-reduced-motion: reduce) {
    .trust-card {
      animation: fadeIn 0.1ms both !important;
    }
    .scroll-bg-image {
      transform: none !important;
      transition: none !important;
    }
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
