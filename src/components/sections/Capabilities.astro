---
import { useTranslations } from '../../i18n/index.js';
import { ContentFacade } from '../../lib/content/facade.js';
import CircularCarousel from '../ui/carousels/circular/circular-carousel';
import type { CarouselItem } from '../ui/carousels/base/carousel.types';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang || 'ar') as 'en' | 'ar';
const t = useTranslations(currentLang);

const rawCapabilities = await ContentFacade.getCapabilities({ lang: currentLang });

const items: CarouselItem[] = rawCapabilities.map((cap) => ({
  id: cap.slug || cap.id,
  title: cap.data.title,
  description: cap.data.description,
  tag: cap.data.tag,
  icon: cap.data.icon,
}));
---

<section
  id="capabilities"
  aria-labelledby="capabilities-title"
  class="py-24 px-6 relative bg-transparent overflow-hidden scroll-mt-20 border-t border-text-main/5"
>
  <div class="max-w-6xl mx-auto space-y-12 sm:space-y-16">
    <!-- Header Area -->
    <div class="space-y-3 text-start">
      <!-- Eyebrow Badge -->
      <div class="text-xs font-bold tracking-widest text-accent-primary uppercase font-sans">
        {t.capabilities.eyebrow}
      </div>

      <!-- Section Title -->
      <h2 id="capabilities-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-text-main">
        {t.capabilities.title}
      </h2>

      <!-- Section Subtitle -->
      <p class="text-text-main/70 text-base leading-relaxed font-sans max-w-xl">
        {t.capabilities.subtitle}
      </p>
    </div>

    <!-- Circular Carousel Interactive React Island -->
    <div class="w-full flex justify-center">
      <CircularCarousel
        client:visible
        items={items}
        ariaLabel={t.capabilities.ariaLabel}
        prevLabel={t.capabilities.prevLabel}
        nextLabel={t.capabilities.nextLabel}
      />
    </div>
  </div>
</section>
