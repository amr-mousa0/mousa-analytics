---
import { Image } from 'astro:assets';
import profileImg from '../../assets/images/amr-hazem.png';
import { useTranslations } from '../../i18n/index.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
const t = useTranslations(lang);
const aboutPath = isAr ? '/about/' : '/en/about/';
---

<section id="about" aria-labelledby="about-title" class="py-24 px-6 border-t border-text-main/5 relative bg-transparent overflow-hidden scroll-mt-20">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Profile Photo Column (5 cols on desktop) -->
    <div class="col-span-1 md:col-span-5 relative flex justify-center md:justify-start">
      <!-- Luxury Portrait Frame -->
      <div class="group relative w-full max-w-[280px] aspect-[4/5] rounded-2xl p-1 bg-card-bg border border-accent-primary/20 shadow-ambient hover:border-accent-primary/50 transition-colors duration-300 overflow-hidden">
        <div class="w-full h-full rounded-xl overflow-hidden relative bg-card-bg">
          <!-- Subtle hover overlay -->
          <div class="absolute inset-0 bg-text-main/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
          <Image 
            src={profileImg} 
            alt={t.nav.authorName} 
            class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            style="mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%);"
            width={560}
            height={700}
            quality={90}
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- About Text Column (7 cols on desktop) -->
    <div class="col-span-1 md:col-span-7 space-y-6">
      <div class="space-y-3">
        <!-- Subtitle Badge -->
        <div class="text-[10px] sm:text-xs font-bold tracking-widest text-accent-primary uppercase font-sans">
          {t.about.aboutFirm}
        </div>
        
        <!-- Large Luxury Serif Heading -->
        <h2 id="about-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-main">
          {t.about.whatIsMousa}
        </h2>
      </div>
      
      <!-- Body Text -->
      <p class="text-text-main/70 text-base leading-relaxed font-sans max-w-xl">
        {t.about.firmBio}
      </p>

      <!-- Highlights blueprint grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-8 border-t border-text-main/10 font-sans max-w-xl">
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-widest text-text-main flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
            {t.about.analyticsTitle}
          </div>
          <p class="text-text-main/60 text-xs sm:text-sm leading-relaxed">
            {t.about.analyticsDesc}
          </p>
        </div>
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-widest text-text-main flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
            {t.about.roiTitle}
          </div>
          <p class="text-text-main/60 text-xs sm:text-sm leading-relaxed">
            {t.about.roiDesc}
          </p>
        </div>
      </div>

      <!-- Learn More Link -->
      <div class="pt-4 font-sans">
        <a 
          href={aboutPath} 
          class="inline-flex items-center gap-1.5 text-xs font-bold text-accent-primary hover:text-accent-highlight tracking-widest uppercase transition-colors duration-300 group"
        >
          <span>{t.about.learnJourney}</span>
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 rtl:group-hover:-translate-x-1">{isAr ? "←" : "→"}</span>
        </a>
      </div>

    </div>

  </div>
</section>
