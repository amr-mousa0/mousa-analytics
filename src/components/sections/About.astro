---
import { Image } from 'astro:assets';
import profileImg from '../../assets/images/amr-hazem.png';


interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
---

<section id="about" aria-labelledby="about-title" class="py-24 px-6 border-t border-text-main/5 relative bg-transparent overflow-hidden scroll-mt-20">
  <!-- Subtle background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_80%,rgba(37,99,235,0.02),transparent_50%)] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Profile Photo Column (5 cols on desktop) -->
    <div class="col-span-1 md:col-span-5 relative flex justify-center md:justify-start">
      <!-- Luxury Portrait Frame -->
      <div class="group relative w-full max-w-[280px] aspect-[4/5] rounded-2xl p-1 bg-white border border-hero-ice-blue/20 shadow-[0_4px_20px_rgba(10,25,47,0.05)] hover:border-hero-ice-blue/50 transition-colors duration-300 overflow-hidden">
        <div class="w-full h-full rounded-xl overflow-hidden relative bg-white bg-[linear-gradient(to_right,rgba(10,25,47,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(10,25,47,0.035)_1px,transparent_1px)] bg-[size:1.75rem_1.75rem]">
          <!-- Subtle hover overlay -->
          <div class="absolute inset-0 bg-text-main/[0.03] opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
          <Image 
            src={profileImg} 
            alt={isAr ? "عمرو موسى" : "Amr Mousa"} 
            class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            style="mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%);"
            width={560}
            height={700}
            quality={90}
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- About Text Column (7 cols on desktop) -->
    <div class="col-span-1 md:col-span-7 space-y-6">
      <div class="space-y-3">
        <!-- Subtitle Badge -->
        <div class="text-[10px] sm:text-xs font-bold tracking-widest text-accent-primary uppercase font-sans">
          {isAr ? "عن المؤسسة" : "ABOUT THE FIRM"}
        </div>
        
        <!-- Large Luxury Serif Heading -->
        <h2 id="about-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-main font-serif">
          {isAr ? "ما هي موسى للتحليلات؟" : "What is Mousa Analytics?"}
        </h2>
      </div>
      
      <!-- Body Text -->
      <p class="text-text-main/70 text-base leading-relaxed font-sans max-w-xl">
        {isAr ? (
          "تأسست موسى للتحليلات كعلامة متخصصة لحل الاختناقات المعقدة وتتبع البيانات بقيادة المؤسس عمرو موسى. نحن لا نكتفي بإنشاء التقارير الفنية، بل نربط كل عملية تتبع وحملة إعلانية بهدف تجاري واضح: زيادة أرباحك وتخفيض تكاليفك المهدرة."
        ) : (
          "Mousa Analytics is a specialized data-to-profit agency captained by founder Amr Mousa. We treat every data event tag, analytics dashboard, and PPC campaign as a calculated mechanism to plug leaks in your sales funnel and drive predictable B2B growth."
        )}
      </p>

      <!-- Highlights blueprint grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-8 border-t border-text-main/10 font-sans max-w-xl">
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-widest text-text-main flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
            {isAr ? "التحليلات وحل المشكلات" : "Data Analytics"}
          </div>
          <p class="text-text-main/60 text-xs sm:text-sm leading-relaxed">
            {isAr ? "تحليل قنوات المبيعات لكشف الاختناقات وتصميم تتبع متقدم خالي من الأخطاء." : "Analyzing funnel metrics to find drop-offs and designing clean GA4 implementation."}
          </p>
        </div>
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-widest text-text-main flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
            {isAr ? "التسويق المستند إلى العائد" : "ROI Marketing"}
          </div>
          <p class="text-text-main/60 text-xs sm:text-sm leading-relaxed">
            {isAr ? "إدارة وتعديل الحملات المدفوعة بميزانيات حقيقية وأرقام تتبع واضحة." : "Running conversions-optimized ad campaigns mapped to real-time sales indicators."}
          </p>
        </div>
      </div>

      <!-- Learn More Link -->
      <div class="pt-4 font-sans">
        <a 
          href={lang === 'ar' ? '/about/' : '/en/about/'} 
          class="inline-flex items-center gap-1.5 text-xs font-bold text-accent-primary hover:text-accent-highlight tracking-widest uppercase transition-colors duration-300 group"
        >
          <span>{isAr ? "تعرف على رحلتنا وخبراتنا" : "Learn more about our journey"}</span>
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 rtl:group-hover:-translate-x-1">{isAr ? "←" : "→"}</span>
        </a>
      </div>

    </div>

  </div>
</section>
