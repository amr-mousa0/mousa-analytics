---
import Icon from './Icon.astro';
import { useTranslations } from '../../i18n/index.js';
import { getWhatsAppUrl, getContactHref } from '../../lib/contact/cta.js';
import crmImg from '../../assets/images/services/custom-crm.png';
import excelImg from '../../assets/images/services/advanced-excel.jpg';
import portfolioImg from '../../assets/images/services/web-portfolios.png';
import mediaBuyingImg from '../../assets/images/services/marketing-strategy.png';
import powerBiImg from '../../assets/images/services/data-analytics.png';

interface Props {
  service: any;
  lang: string;
  spanClass?: string;
  index: number;
}

const { service, lang, spanClass = '', index } = Astro.props;
const t = useTranslations(lang);

const getServiceUrl = (slug: string) => {
  const cleanSlug = slug.split('/').pop();
  return lang === 'ar' ? `/services/${cleanSlug}/` : `/en/services/${cleanSlug}/`;
};

const getServiceImage = (srv: any): string => {
  const cleanSlug = srv.slug ? srv.slug.split('/').pop() : '';
  switch (cleanSlug) {
    case 'data-analytics': return powerBiImg.src;
    case 'marketing-strategy': return mediaBuyingImg.src;
    case 'advanced-excel': return excelImg.src;
    case 'custom-crm': return crmImg.src;
    case 'web-portfolios': return portfolioImg.src;
    default:
      if (srv.data?.coverImage) {
        const img = srv.data.coverImage;
        return typeof img === 'object' && img !== null ? img.src : img;
      }
      return powerBiImg.src;
  }
};

const loadingPolicy = index === 0 ? 'eager' : 'lazy';
---

<div
  class={`premium-card-global group !p-0 overflow-hidden flex flex-col h-[470px] md:h-full flex-shrink-0 w-[78vw] md:w-auto snap-center md:snap-align-none relative ${spanClass}`}
  data-card-index={index}
  data-card-theme={service.data.theme ?? 'default'}
>
  <!-- Clickable Card Body -->
  <a href={getServiceUrl(service.slug)} class="card-link flex flex-col h-full flex-grow hover:no-underline group/body">
    <!-- Top Half: Service Image -->
    <div class="h-44 relative border-b border-text-main/10 overflow-hidden bg-primary-bg">
      <img 
        src={getServiceImage(service)} 
        alt={`${t.services.serviceTag}: ${service.data.title}`}
        class="card-image w-full h-full object-cover group-hover/body:scale-105 transition-transform duration-500"
        width="500"
        height="300"
        loading={loadingPolicy}
        decoding="async"
      />
      <!-- Service Pill Tag -->
      <span class="absolute top-4 start-4 text-[9px] font-bold tracking-wider text-text-main/60 uppercase border border-text-main/10 px-2 py-0.5 rounded bg-hero-card/90 font-mono z-10">
        {t.services.serviceTag}
      </span>
      
      {(service as any).isFallback && (
        <span class="absolute top-4 end-4 text-[8px] font-bold tracking-wider text-white uppercase px-2 py-0.5 rounded bg-amber-800 font-sans z-10">
          {t.services.notTranslated}
        </span>
      )}
    </div>

    <!-- Bottom Half: Details -->
    <div class="p-6 pb-28 bg-hero-card flex-grow flex flex-col justify-between">
      <div class="space-y-3">
        <h3 class="card-title text-lg font-bold text-text-main leading-snug group-hover/body:text-accent-primary transition-colors">
          {service.data.title}
        </h3>
        
        {(service as any).isFallback && (
          <div class="text-[10px] text-amber-800 bg-amber-900/5 px-2.5 py-1.5 rounded border border-amber-800/20 font-sans leading-tight">
            {t.services.fallbackNotice}
          </div>
        )}

        <p class="card-description text-text-main/70 text-sm leading-relaxed font-sans min-h-[4.2rem]">
          {service.data.description}
        </p>
      </div>
    </div>
  </a>

  <!-- Action Area Wrapper (Default Explore button - Desktop fine-pointer only) -->
  <div class="card-actions absolute inset-x-0 bottom-0 p-6 bg-hero-card pointer-events-none hidden [@media(hover:hover)]:md:block md:group-hover:opacity-0 transition-opacity duration-200">
    <hr class="border-text-main/10 mb-4" />
    <div class="flex justify-end pointer-events-auto">
      <a 
        href={getServiceUrl(service.slug)}
        tabindex="-1"
        aria-hidden="true"
        class="h-11 px-5 rounded-full font-semibold text-xs transition-all duration-200 active:scale-95 inline-flex items-center justify-center gap-1.5 cursor-pointer bg-transparent hover:bg-accent-primary/5 text-accent-primary border border-accent-primary"
      >
        {service.slug.includes('web-portfolios') ? t.services.requestConsultation : t.services.exploreDetails}
      </a>
    </div>
  </div>

  <!-- Action Overlay (Always visible on mobile & touch devices, hover slide-up on desktop fine-pointer) -->
  <div class="card-overlay absolute inset-x-0 bottom-0 bg-hero-card p-5 border-t border-text-main/10 flex items-center justify-between gap-2 z-20 shadow-[0_-8px_24px_rgba(10,25,47,0.06)] opacity-100 translate-y-0 pointer-events-auto visible [@media(hover:hover)]:md:translate-y-full [@media(hover:hover)]:md:opacity-0 [@media(hover:hover)]:md:pointer-events-none [@media(hover:hover)]:md:invisible [@media(hover:hover)]:md:transition-all [@media(hover:hover)]:md:duration-300 [@media(hover:hover)]:md:ease-out md:group-hover:translate-y-0 md:group-hover:opacity-100 md:group-hover:pointer-events-auto md:group-hover:visible">
    <!-- Quick Connect Actions -->
    <div class="flex items-center gap-2 w-full">
      <!-- Call Button (Circular) -->
      <a 
        href={getContactHref('phone', lang as 'en' | 'ar')} 
        class="w-11 h-11 rounded-full bg-primary-bg hover:bg-text-main/10 text-text-main flex items-center justify-center transition-all duration-200 active:scale-95 shrink-0 border border-text-main/10"
        aria-label={t.footer.callNow}
      >
        <Icon name="phone" class="w-4 h-4" />
      </a>

      <!-- WhatsApp Button -->
      <a 
        href={getWhatsAppUrl({ message: service.data.whatsappMessage || `${t.services.inquireMessagePrefix}${service.data.title}`, lang: lang as 'en' | 'ar' })}
        target="_blank" 
        rel="noopener noreferrer" 
        class="h-11 flex-grow rounded-full bg-success-primary hover:bg-success-hover text-white font-bold text-xs tracking-wider flex items-center justify-center gap-2 shadow-md active:scale-95 transition-all duration-200 border-none service-whatsapp-cta"
        data-service-title={service.data.title}
        data-service-slug={service.slug}
      >
        <Icon name="whatsapp" class="w-4 h-4" />
        <span>{t.footer.whatsappNow}</span>
      </a>
    </div>
  </div>
</div>
