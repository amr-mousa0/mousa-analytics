---
interface Props {
  lang: string;
  activePage: 'home' | 'about' | 'services' | 'projects';
  backUrl?: string;
  backText?: string;
  actionUrl?: string;
  actionText?: string;
  actionIcon?: string;
}

const { lang, activePage, backUrl, backText, actionUrl, actionText, actionIcon } = Astro.props;
const isAr = lang === 'ar';

// Localized Navigation Links
const homePath = `/${lang}/`;
const aboutPath = `/${lang}/about/`;
const servicesPath = `/${lang}/#services`;
const projectsPath = `/${lang}/#projects`;
const contactPath = `/${lang}/#contact`;

const targetLang = isAr ? 'en' : 'ar';

// Dynamically resolve target language switch URL based on current path
const pathname = Astro.url.pathname;
const langTogglePath = pathname.replace(/^\/(en|ar)\/?/, `/${targetLang}/`);
---

<header class="fixed top-0 inset-x-0 w-full h-16 md:h-20 bg-hero-surface/75 backdrop-blur-md border-b border-text-main/8 z-50 transition-all duration-300">
  <div class="w-full h-full max-w-6xl mx-auto flex items-center justify-between px-6 sm:px-8 lg:px-12">
    
    <!-- Left Column: Elegant Logo OR Back Button -->
    <div class="flex items-center justify-start">
      {backUrl ? (
        <a 
          href={backUrl} 
          class="inline-flex items-center gap-2 px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-text-main/10 bg-white/80 hover:bg-white text-text-main/75 hover:text-text-main text-[10px] md:text-xs font-semibold shadow-sm transition-all duration-300 cursor-pointer hover:border-text-main/20 hover:shadow-md"
        >
          <span class="text-sm font-sans">{isAr ? "→" : "←"}</span>
          <span class="hidden sm:inline">{backText}</span>
          <span class="inline sm:hidden">{isAr ? "العودة" : "Back"}</span>
        </a>
      ) : (
        <a href={homePath} class="flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-offset-2">
          <!-- Circular emblem with a dark background and clean serif letter inside -->
          <span class="w-9 h-9 rounded-full bg-text-main flex items-center justify-center text-white font-serif text-sm font-bold shadow-md shadow-text-main/10 select-none" aria-hidden="true">
            A
          </span>
          <!-- Brand name: regular serif + colored italic serif -->
          <span class="font-serif text-base md:text-lg font-bold text-text-main tracking-tight">
            {isAr ? "موسى" : "Mousa"} <span class="text-hero-accent italic font-medium">{isAr ? "للتحليلات" : "Analytics"}</span>
          </span>
        </a>
      )}
    </div>

    <!-- Center Column: Centered uppercase navigation links matching reference -->
    <nav class="hidden md:flex items-center gap-8 text-[10px] font-bold tracking-[0.25em] uppercase font-sans text-text-main/60">
      <a 
        href={homePath} 
        class={`transition-all hover:text-hero-accent ${activePage === 'home' ? 'text-hero-accent' : 'text-text-main/70'}`}
      >
        {isAr ? "الرئيسية" : "Home"}
      </a>
      <a 
        href={aboutPath} 
        class={`transition-all hover:text-hero-accent ${activePage === 'about' ? 'text-hero-accent' : 'text-text-main/70'}`}
      >
        {isAr ? "من أنا" : "About"}
      </a>
      <a 
        href={servicesPath} 
        class={`transition-all hover:text-hero-accent ${activePage === 'services' ? 'text-hero-accent' : 'text-text-main/70'}`}
      >
        {isAr ? "الخدمات" : "Services"}
      </a>
      <a 
        href={projectsPath} 
        class="transition-all hover:text-hero-accent text-text-main/70"
      >
        {isAr ? "المشاريع" : "Portfolio"}
      </a>
      <a 
        href={contactPath} 
        class="transition-all hover:text-hero-accent text-text-main/70"
      >
        {isAr ? "اتصل بي" : "Contact"}
      </a>
    </nav>

    <!-- Right Column: Language Switcher pill & Drawer Menu Icon -->
    <div class="flex items-center justify-end gap-3.5">
      {actionUrl && (
        <a 
          href={actionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-text-main/10 bg-white/80 hover:bg-white text-text-main/75 hover:text-text-main text-[9px] font-extrabold uppercase tracking-wider shadow-sm transition-all duration-300"
          aria-label={actionText}
        >
          {actionIcon && <i class={`${actionIcon} text-[11px]`}></i>}
          <span class="hidden sm:inline">{actionText}</span>
        </a>
      )}

      <!-- EN / AR rounded border switcher pill -->
      <a 
        href={langTogglePath} 
        class="px-4 py-1.5 rounded-full border border-text-main/10 bg-hero-card text-[9px] font-extrabold uppercase tracking-[0.15em] shadow-sm flex items-center gap-1.5 focus-visible:ring-2"
        aria-label={isAr ? "Switch to English" : "تغيير للغة العربية"}
      >
        {isAr ? (
          <>
            <span class="text-text-main/40 hover:text-hero-accent transition-all">EN</span>
            <span class="text-text-main/10">/</span>
            <span class="text-hero-accent">AR</span>
          </>
        ) : (
          <>
            <span class="text-hero-accent">EN</span>
            <span class="text-text-main/10">/</span>
            <span class="text-text-main/40 hover:text-hero-accent transition-all">AR</span>
          </>
        )}
      </a>

      <!-- Mobile Controls (Drawer Menu Icon) -->
      <label for="menu-toggle" class="md:hidden cursor-pointer p-1.5 text-text-main/70 hover:text-hero-accent select-none z-50 focus-visible:ring-2" aria-label="Toggle Menu">
        <i class="fa-solid fa-bars text-base"></i>
      </label>
    </div>

  </div>
</header>

<input type="checkbox" id="menu-toggle" class="peer hidden" />

<!-- Side Drawer Overlay -->
<label for="menu-toggle" class="fixed inset-0 bg-text-main/40 backdrop-blur-sm z-40 hidden peer-checked:block md:hidden! transition-all duration-300"></label>

<!-- Mobile Side Drawer -->
<div class="fixed top-0 bottom-0 end-0 w-80 bg-primary-bg border-s border-text-main/10 p-4 z-50 transform translate-x-full rtl:-translate-x-full transition-transform duration-300 peer-checked:translate-x-0 md:hidden! flex flex-col gap-4 shadow-2xl overflow-y-auto">
  <div class="flex justify-end items-center">
    <label for="menu-toggle" class="w-9 h-9 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/70 hover:bg-text-main/10 hover:text-text-main transition-all cursor-pointer select-none">
      <i class="fa-solid fa-xmark text-base"></i>
    </label>
  </div>

  <nav class="flex flex-col gap-2 text-xs font-semibold">
    <!-- Home Link -->
    <a href={homePath} class="mobile-drawer-link flex items-center gap-3 p-2 rounded-xl border border-text-main/6 bg-white shadow-sm hover:border-hero-accent/30 transition-all duration-300">
      <div class="w-8.5 h-8.5 rounded-lg bg-hero-accent/8 flex items-center justify-center text-hero-accent shrink-0">
        <i class="fa-solid fa-house text-base"></i>
      </div>
      <span class="font-sans text-sm font-semibold text-text-main">{isAr ? "الرئيسية" : "Home"}</span>
    </a>

    <!-- About Link -->
    <a href={aboutPath} class="mobile-drawer-link flex items-center gap-3 p-2 rounded-xl border border-text-main/6 bg-white shadow-sm hover:border-hero-accent/30 transition-all duration-300">
      <div class="w-8.5 h-8.5 rounded-lg bg-hero-accent/8 flex items-center justify-center text-hero-accent shrink-0">
        <i class="fa-solid fa-user text-base"></i>
      </div>
      <span class="font-sans text-sm font-semibold text-text-main">{isAr ? "من أنا" : "Who I Am"}</span>
    </a>


    <!-- Services Link -->
    <a href={servicesPath} class="mobile-drawer-link flex items-center gap-3 p-2 rounded-xl border border-text-main/6 bg-white shadow-sm hover:border-hero-accent/30 transition-all duration-300">
      <div class="w-8.5 h-8.5 rounded-lg bg-hero-accent/8 flex items-center justify-center text-hero-accent shrink-0">
        <i class="fa-solid fa-gears text-base"></i>
      </div>
      <span class="font-sans text-sm font-semibold text-text-main">{isAr ? "الخدمات" : "Services"}</span>
    </a>

    <!-- Portfolio Link -->
    <a href={projectsPath} class="mobile-drawer-link flex items-center gap-3 p-2 rounded-xl border border-text-main/6 bg-white shadow-sm hover:border-hero-accent/30 transition-all duration-300">
      <div class="w-8.5 h-8.5 rounded-lg bg-hero-accent/8 flex items-center justify-center text-hero-accent shrink-0">
        <i class="fa-solid fa-briefcase text-base"></i>
      </div>
      <span class="font-sans text-sm font-semibold text-text-main">{isAr ? "المشاريع" : "Projects"}</span>
    </a>

    <!-- Contact Link -->
    <a href={contactPath} class="mobile-drawer-link flex items-center gap-3 p-2 rounded-xl border border-text-main/6 bg-white shadow-sm hover:border-hero-accent/30 transition-all duration-300">
      <div class="w-8.5 h-8.5 rounded-lg bg-hero-accent/8 flex items-center justify-center text-hero-accent shrink-0">
        <i class="fa-solid fa-envelope text-base"></i>
      </div>
      <span class="font-sans text-sm font-semibold text-text-main">{isAr ? "اتصل بي" : "Contact"}</span>
    </a>
  </nav>
</div>

<!-- Mobile Bottom Navigation Bar -->
<nav class="fixed bottom-0 inset-x-0 h-[56px] bg-white/85 backdrop-blur-lg border-t border-text-main/5 md:hidden z-50 flex items-center justify-around px-4 pb-safe-bottom shadow-[0_-4px_24px_rgba(10,25,47,0.04)]">
  <!-- Home Tab -->
  <a 
    href={homePath} 
    class={`flex flex-col items-center justify-center flex-1 h-full transition-colors group focus-visible:outline-none ${activePage === 'home' ? 'text-hero-accent' : 'text-text-main/60 hover:text-hero-accent'}`}
  >
    <i class="fa-solid fa-house text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "الرئيسية" : "Home"}</span>
  </a>


  <!-- Center Tab (Contact) Placeholder & Elevated Button -->
  <div class="flex-grow flex-1 flex flex-col items-center justify-end pb-1 h-full relative">
    <a 
      href={contactPath} 
      class="absolute -top-4 flex flex-col items-center justify-center group focus-visible:outline-none"
    >
      <div class="w-[48px] h-[48px] rounded-full bg-white shadow-[0_4px_16px_rgba(10,25,47,0.12)] border border-text-main/5 flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-active:scale-95 group-focus-visible:ring-2 group-focus-visible:ring-offset-2 group-focus-visible:ring-hero-accent">
        <span class="w-[32px] h-[32px] rounded-full bg-text-main flex items-center justify-center text-white font-serif text-sm font-bold shadow-md shadow-text-main/10 select-none" aria-hidden="true">
          A
        </span>
      </div>
      <span class="text-[8px] font-extrabold text-text-main/60 mt-0.5 uppercase tracking-wider font-sans transition-colors group-hover:text-hero-accent">{isAr ? "اتصل بي" : "Contact"}</span>
    </a>
  </div>

  <!-- Portfolio Tab -->
  <a 
    href={projectsPath} 
    class="flex flex-col items-center justify-center flex-1 h-full text-text-main/60 hover:text-hero-accent transition-colors group focus-visible:outline-none"
  >
    <i class="fa-solid fa-briefcase text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "المشاريع" : "Portfolio"}</span>
  </a>

  <!-- About Tab -->
  <a 
    href={aboutPath} 
    class={`flex flex-col items-center justify-center flex-1 h-full transition-colors group focus-visible:outline-none ${activePage === 'about' ? 'text-hero-accent' : 'text-text-main/60 hover:text-hero-accent'}`}
  >
    <i class="fa-solid fa-user text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "من أنا" : "About"}</span>
  </a>
</nav>

<!-- App Install Banner Container (Floating Card) -->
<div 
  id="app-install-banner" 
  class="fixed bottom-[72px] inset-x-4 bg-white/95 backdrop-blur-md border border-text-main/5 rounded-2xl shadow-[0_8px_32px_rgba(10,25,47,0.08)] z-40 p-4 transform translate-y-[150%] opacity-0 pointer-events-none transition-all duration-500 ease-out md:hidden flex items-start gap-3"
>
  <!-- Close Button -->
  <button 
    id="close-app-banner" 
    class="absolute top-2.5 end-2.5 w-6 h-6 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/60 hover:bg-text-main/10 hover:text-text-main transition-colors"
    aria-label={isAr ? "إغلاق" : "Close"}
  >
    <i class="fa-solid fa-xmark text-xs"></i>
  </button>

  <!-- Brand Logo Icon -->
  <div class="w-11 h-11 rounded-xl bg-text-main flex items-center justify-center text-white font-serif text-base font-bold shadow-md shadow-text-main/10 select-none shrink-0">
    A
  </div>

  <!-- Content -->
  <div class="flex-grow font-sans pe-6">
    <h4 class="text-[13px] font-bold text-text-main leading-tight">
      {isAr ? "ثبّت تطبيق موسى للتحليلات" : "Install Mousa Analytics App"}
    </h4>
    <p class="text-[10px] text-text-main/60 mt-0.5 leading-snug">
      {isAr ? "احصل على تجربة أسرع وأجمل على جهازك." : "Get a faster and more beautiful experience on your device."}
    </p>

    <!-- Action Button -->
    <button 
      id="install-app-btn" 
      class="mt-2.5 px-3.5 py-1.5 rounded-lg bg-text-main text-white hover:bg-hero-accent transition-colors text-[10px] font-bold flex items-center gap-1.5 shadow-sm active:scale-95 duration-200"
    >
      <i class="fa-solid fa-download text-[9px]"></i>
      <span>{isAr ? "تثبيت التطبيق الآن" : "Install App Now"}</span>
    </button>
  </div>
</div>

<!-- Instructions Modal / Bottom Sheet -->
<div 
  id="install-instructions" 
  class="fixed inset-0 bg-text-main/40 backdrop-blur-sm z-50 hidden items-end justify-center md:hidden"
>
  <!-- Bottom Sheet Card -->
  <div class="w-full bg-white rounded-t-3xl p-6 shadow-2xl space-y-4 max-w-md transform translate-y-full transition-transform duration-300">
    <div class="flex justify-between items-center pb-2 border-b border-text-main/5">
      <h3 class="text-sm font-bold text-text-main font-sans">
        {isAr ? "خطوات التثبيت على الهاتف" : "How to Install on Mobile"}
      </h3>
      <button 
        id="close-instructions-btn" 
        class="w-8 h-8 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/70 hover:bg-text-main/10"
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Steps content based on OS -->
    <div class="space-y-4 text-xs text-text-main/80 font-sans leading-relaxed">
      <!-- iOS Section -->
      <div id="ios-instructions" class="hidden space-y-3">
        <p>{isAr ? "بسبب قيود نظام iOS، يرجى اتباع الآتي للتثبيت:" : "Due to iOS constraints, please follow these steps to install:"}</p>
        <ol class="list-decimal list-inside space-y-2">
          <li>{isAr ? "اضغط على زر المشاركة في شريط المتصفح السفلي" : "Tap the Share button in the browser's bottom bar"} <i class="fa-solid fa-share-from-square text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "اسحب لأسفل واختر 'إضافة إلى الشاشة الرئيسية'" : "Scroll down and select 'Add to Home Screen'"} <i class="fa-solid fa-plus-square text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "اضغط على 'إضافة' في أعلى اليمين لتأكيد التثبيت" : "Tap 'Add' in the top right corner to confirm"}.</li>
        </ol>
      </div>

      <!-- Android Section -->
      <div id="android-instructions" class="hidden space-y-3">
        <p>{isAr ? "لتثبيت التطبيق على جهاز الأندرويد الخاص بك:" : "To install the app on your Android device:"}</p>
        <ol class="list-decimal list-inside space-y-2">
          <li>{isAr ? "اضغط على زر خيارات المتصفح (الثلاث نقاط)" : "Tap the browser options button (three dots)"} <i class="fa-solid fa-ellipsis-vertical text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "اختر 'إضافة إلى الشاشة الرئيسية' أو 'تثبيت التطبيق'" : "Select 'Add to Home Screen' or 'Install App'"} <i class="fa-solid fa-plus-square text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "أكد التثبيت لتظهر الأيقونة على جهازك" : "Confirm the installation to place the icon on your device"}.</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<script>
  import { lifecycle } from '../../scripts/lifecycle';

  // Mobile drawer scroll lock
  const menuToggle = document.getElementById('menu-toggle') as HTMLInputElement | null;
  const drawerLinks = document.querySelectorAll('.mobile-drawer-link');

  if (menuToggle) {
    const updateBodyScroll = () => {
      if (menuToggle.checked) {
        document.body.classList.add('overflow-hidden');
      } else {
        document.body.classList.remove('overflow-hidden');
      }
    };

    lifecycle.addListener(menuToggle, 'change', updateBodyScroll);

    if (drawerLinks.length > 0) {
      drawerLinks.forEach((link) => {
        lifecycle.addListener(link, 'click', () => {
          const href = link.getAttribute('href');
          if (href && href.includes('#')) {
            if (menuToggle) {
              menuToggle.checked = false;
              updateBodyScroll();
            }
          }
        });
      });
    }

    lifecycle.onCleanup(() => {
      document.body.classList.remove('overflow-hidden');
    });
  }

  // App Install Banner Logic
  let deferredPrompt: any = null;

  if (typeof window !== 'undefined') {
    lifecycle.addListener(window, 'beforeinstallprompt', (e: any) => {
      e.preventDefault();
      deferredPrompt = e;
    });
  }

  const initAppBanner = () => {
    const banner = document.getElementById('app-install-banner');
    const closeBtn = document.getElementById('close-app-banner');
    const installBtn = document.getElementById('install-app-btn');
    const instructionsModal = document.getElementById('install-instructions');
    const instructionsCard = instructionsModal?.querySelector('div');
    const closeInstructionsBtn = document.getElementById('close-instructions-btn');
    
    const iosInstructions = document.getElementById('ios-instructions');
    const androidInstructions = document.getElementById('android-instructions');

    if (!banner || !closeBtn || !installBtn) return;

    if (localStorage.getItem('mousa_app_banner_dismissed') === 'true') {
      return;
    }

    // Show after 4 seconds (Optimized for SEO/Performance and prevents CLS)
    const showTimeout = setTimeout(() => {
      banner.classList.remove('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }, 4000);

    lifecycle.onCleanup(() => clearTimeout(showTimeout));

    const dismissBanner = () => {
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
      localStorage.setItem('mousa_app_banner_dismissed', 'true');
    };

    lifecycle.addListener(closeBtn, 'click', dismissBanner);

    lifecycle.addListener(installBtn, 'click', () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then((choiceResult: any) => {
          if (choiceResult.outcome === 'accepted') {
            dismissBanner();
          }
          deferredPrompt = null;
        });
      } else {
        if (instructionsModal && instructionsCard) {
          const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
          if (isIOS) {
            iosInstructions?.classList.remove('hidden');
            androidInstructions?.classList.add('hidden');
          } else {
            androidInstructions?.classList.remove('hidden');
            iosInstructions?.classList.add('hidden');
          }

          instructionsModal.classList.remove('hidden');
          instructionsModal.classList.add('flex');
          setTimeout(() => {
            instructionsCard.classList.remove('translate-y-full');
            instructionsCard.classList.add('translate-y-0');
          }, 10);
        }
      }
    });

    const closeInstructions = () => {
      if (instructionsModal && instructionsCard) {
        instructionsCard.classList.remove('translate-y-0');
        instructionsCard.classList.add('translate-y-full');
        setTimeout(() => {
          instructionsModal.classList.remove('flex');
          instructionsModal.classList.add('hidden');
        }, 300);
      }
    };

    if (closeInstructionsBtn) {
      lifecycle.addListener(closeInstructionsBtn, 'click', closeInstructions);
    }
    if (instructionsModal) {
      lifecycle.addListener(instructionsModal, 'click', (e: Event) => {
        if (e.target === instructionsModal) {
          closeInstructions();
        }
      });
    }
  };

  // Run on page load and view transitions swaps
  if (document.readyState === 'loading') {
    lifecycle.addListener(document, 'DOMContentLoaded', initAppBanner);
  } else {
    initAppBanner();
  }

  lifecycle.addListener(document, 'astro:page-load', initAppBanner);
</script>
