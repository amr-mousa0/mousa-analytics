---
interface Props {
  lang: string;
  activePage?: 'home' | 'about' | 'services' | 'projects' | 'blog' | '';
  backUrl?: string;
  backText?: string;
  actionUrl?: string;
  actionText?: string;
  actionIcon?: string;
}

const { lang, activePage, backUrl, backText, actionUrl, actionText, actionIcon } = Astro.props;
const isAr = lang === 'ar';

// Localized Navigation Links
const homePath = `/${lang}/`;
const aboutPath = `/${lang}/about/`;
const servicesPath = `/${lang}/#services`;
const projectsPath = `/${lang}/#projects`;
const contactPath = `/${lang}/#contact`;

const targetLang = isAr ? 'en' : 'ar';

// Dynamically resolve target language switch URL based on current path
const pathname = Astro.url.pathname;
const langTogglePath = pathname.replace(/^\/(en|ar)\/?/, `/${targetLang}/`);
---

<header class="fixed top-0 inset-x-0 w-full h-16 md:h-20 bg-hero-surface/75 backdrop-blur-md border-b border-text-main/8 z-50 transition-all duration-300">
  <div class="w-full h-full max-w-6xl mx-auto flex items-center justify-between px-6 sm:px-8 lg:px-12">
    
    <!-- Left Column: Elegant Logo OR Back Button -->
    <div class="flex items-center justify-start">
      {backUrl ? (
        <a 
          href={backUrl} 
          class="inline-flex items-center gap-2 px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-text-main/10 bg-white/80 hover:bg-white text-text-main/75 hover:text-text-main text-[10px] md:text-xs font-semibold shadow-sm transition-all duration-300 cursor-pointer hover:border-text-main/20 hover:shadow-md"
        >
          <span class="text-sm font-sans">{isAr ? "→" : "←"}</span>
          <span class="hidden sm:inline">{backText}</span>
          <span class="inline sm:hidden">{isAr ? "العودة" : "Back"}</span>
        </a>
      ) : (
        <a href={homePath} class="flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-offset-2">
          <!-- Circular emblem with a dark background and custom geometric M logo inside -->
          <span class="w-9 h-9 rounded-full bg-text-main flex items-center justify-center text-white p-2 shadow-md shadow-text-main/10 border border-white/5 select-none shrink-0" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-full h-full text-white" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <defs>
                <linearGradient id="logo-grad-header" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FFFFFF" />
                  <stop offset="60%" stop-color="#93C5FD" />
                  <stop offset="100%" stop-color="#2563EB" />
                </linearGradient>
              </defs>
              <path d="M4 18V6L11 12L18 6V18" stroke="url(#logo-grad-header)" stroke-width="2" />
              <path d="M6 16V4L13 10L20 4V16" stroke="#2563EB" class="opacity-45" stroke-width="1.2" />
              <path d="M4 6L6 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M11 12L13 10" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M18 6L20 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M4 18L6 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M18 18L20 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            </svg>
          </span>
          <!-- Brand name: regular serif + colored italic serif -->
          <span class="font-serif text-base md:text-lg font-bold text-text-main tracking-tight">
            {isAr ? "موسى" : "Mousa"} <span class="text-hero-accent italic font-medium">{isAr ? "للتحليلات" : "Analytics"}</span>
          </span>
        </a>
      )}
    </div>

    <!-- Center Column: Centered uppercase navigation links matching reference -->
    <nav class="hidden md:flex items-center gap-8 text-[10px] font-bold tracking-[0.25em] uppercase font-sans text-text-main/60">
      <a 
        href={homePath} 
        class={`transition-all hover:text-hero-accent ${activePage === 'home' ? 'text-hero-accent' : 'text-text-main/70'}`}
      >
        {isAr ? "الرئيسية" : "Home"}
      </a>
      <a 
        href={aboutPath} 
        class={`transition-all hover:text-hero-accent ${activePage === 'about' ? 'text-hero-accent' : 'text-text-main/70'}`}
      >
        {isAr ? "من أنا" : "About"}
      </a>
      <a 
        href={servicesPath} 
        class={`transition-all hover:text-hero-accent ${activePage === 'services' ? 'text-hero-accent' : 'text-text-main/70'}`}
      >
        {isAr ? "الخدمات" : "Services"}
      </a>
      <a 
        href={projectsPath} 
        class="transition-all hover:text-hero-accent text-text-main/70"
      >
        {isAr ? "المشاريع" : "Portfolio"}
      </a>
      <a 
        href={contactPath} 
        class="transition-all hover:text-hero-accent text-text-main/70"
      >
        {isAr ? "اتصل بي" : "Contact"}
      </a>
    </nav>

    <!-- Right Column: Language Switcher pill & Drawer Menu Icon -->
    <div class="flex items-center justify-end gap-3.5">
      {actionUrl && (
        <a 
          href={actionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-text-main/10 bg-white/80 hover:bg-white text-text-main/75 hover:text-text-main text-[9px] font-extrabold uppercase tracking-wider shadow-sm transition-all duration-300"
          aria-label={actionText}
        >
          {actionIcon && <i class={`${actionIcon} text-[11px]`}></i>}
          <span class="hidden sm:inline">{actionText}</span>
        </a>
      )}

      <!-- EN / AR rounded border switcher pill -->
      <a 
        id="language-toggle"
        href={langTogglePath} 
        class="px-4 py-1.5 rounded-full border border-text-main/10 bg-hero-card text-[9px] font-extrabold uppercase tracking-[0.15em] shadow-sm flex items-center gap-1.5 focus-visible:ring-2"
        aria-label={isAr ? "EN / AR - Switch to English" : "EN / AR - تغيير للغة العربية"}
      >
        {isAr ? (
          <>
            <span class="text-text-main/60 hover:text-hero-accent transition-all">EN</span>
            <span class="text-text-main/10">/</span>
            <span class="text-hero-accent">AR</span>
          </>
        ) : (
          <>
            <span class="text-hero-accent">EN</span>
            <span class="text-text-main/10">/</span>
            <span class="text-text-main/60 hover:text-hero-accent transition-all">AR</span>
          </>
        )}
      </a>

      <!-- Mobile Controls (Drawer Menu Icon) -->
      <label for="menu-toggle" class="md:hidden cursor-pointer p-1.5 text-text-main/70 hover:text-hero-accent select-none z-50 focus-visible:ring-2" aria-label="Toggle Menu">
        <i class="fa-solid fa-bars text-base"></i>
      </label>
    </div>

  </div>
</header>

<input type="checkbox" id="menu-toggle" class="peer hidden" />

<!-- Side Drawer Overlay -->
<label for="menu-toggle" class="fixed inset-0 bg-text-main/40 backdrop-blur-sm z-40 hidden peer-checked:block md:hidden! transition-all duration-300"></label>

<!-- Mobile Side Drawer (Bottom Sheet Redesign) -->
<div class="fixed bottom-0 inset-x-0 bg-primary-bg border-t border-text-main/10 pt-4 px-6 pb-8 z-50 transform translate-y-full transition-transform duration-300 ease-out peer-checked:translate-y-0 md:hidden! flex flex-col gap-5 rounded-t-[32px] shadow-[0_-10px_40px_rgba(0,0,0,0.12)] max-h-[85vh] overflow-y-auto">
  
  <!-- Sleek Grabber/Drag Handle -->
  <div class="w-12 h-1 bg-text-main/10 rounded-full mx-auto mb-1 shrink-0" aria-hidden="true"></div>

  <div class="flex flex-col gap-5">
    <!-- Header with Title and Close Button -->
    <div class="flex items-center justify-between pb-3 border-b border-text-main/5">
      <span class="font-serif text-base font-bold text-text-main">
        {isAr ? "القائمة الإرشادية" : "Navigation"}
      </span>
      <label for="menu-toggle" class="w-8 h-8 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/70 hover:bg-text-main/10 hover:text-text-main transition-all cursor-pointer select-none">
        <i class="fa-solid fa-xmark text-sm"></i>
      </label>
    </div>

    <!-- Menu Navigation Items -->
    <nav class="flex flex-col font-sans">
      <!-- Home Link -->
      <a href={homePath} class="mobile-drawer-link flex items-center justify-between py-3.5 border-b border-text-main/5 text-text-main/80 hover:text-hero-accent transition-all duration-300 font-semibold text-[14px]">
        <span>{isAr ? "الرئيسية" : "Home"}</span>
        <i class="fa-solid fa-house text-text-main/25 text-xs"></i>
      </a>

      <!-- About Link -->
      <a href={aboutPath} class="mobile-drawer-link flex items-center justify-between py-3.5 border-b border-text-main/5 text-text-main/80 hover:text-hero-accent transition-all duration-300 font-semibold text-[14px]">
        <span>{isAr ? "من أنا" : "Who I Am"}</span>
        <i class="fa-solid fa-user text-text-main/25 text-xs"></i>
      </a>

      <!-- Services Link -->
      <a href={servicesPath} class="mobile-drawer-link flex items-center justify-between py-3.5 border-b border-text-main/5 text-text-main/80 hover:text-hero-accent transition-all duration-300 font-semibold text-[14px]">
        <span>{isAr ? "الخدمات" : "Services"}</span>
        <i class="fa-solid fa-gears text-text-main/25 text-xs"></i>
      </a>

      <!-- Portfolio Link -->
      <a href={projectsPath} class="mobile-drawer-link flex items-center justify-between py-3.5 border-b border-text-main/5 text-text-main/80 hover:text-hero-accent transition-all duration-300 font-semibold text-[14px]">
        <span>{isAr ? "المشاريع" : "Projects"}</span>
        <i class="fa-solid fa-briefcase text-text-main/25 text-xs"></i>
      </a>

      <!-- Contact Link -->
      <a href={contactPath} class="mobile-drawer-link flex items-center justify-between py-3.5 border-b border-text-main/5 text-text-main/80 hover:text-hero-accent transition-all duration-300 font-semibold text-[14px]">
        <span>{isAr ? "اتصل بي" : "Contact"}</span>
        <i class="fa-solid fa-envelope text-text-main/25 text-xs"></i>
      </a>
    </nav>
  </div>

  <!-- Bottom Drawer Actions -->
  <div class="flex flex-col gap-4 mt-2 pt-4 border-t border-text-main/5">
    <div class="flex items-center justify-between w-full">
      <!-- Active Avatar / Online Indicator -->
      <div class="relative flex items-center gap-3">
        <div class="relative w-11 h-11 rounded-full bg-text-main flex items-center justify-center text-white p-2.5 shadow-md shadow-text-main/10 select-none shrink-0 border border-white/5">
          <svg viewBox="0 0 24 24" class="w-full h-full text-white" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <defs>
              <linearGradient id="logo-grad-drawer" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFFFFF" />
                <stop offset="60%" stop-color="#93C5FD" />
                <stop offset="100%" stop-color="#2563EB" />
              </linearGradient>
            </defs>
            <path d="M4 18V6L11 12L18 6V18" stroke="url(#logo-grad-drawer)" stroke-width="2" />
            <path d="M6 16V4L13 10L20 4V16" stroke="#2563EB" class="opacity-45" stroke-width="1.2" />
            <path d="M4 6L6 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M11 12L13 10" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M18 6L20 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M4 18L6 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M18 18L20 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
          </svg>
        </div>
        <span class="absolute bottom-0 start-8 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white" aria-hidden="true"></span>
        <div class="flex flex-col">
          <span class="font-serif text-xs font-bold text-text-main leading-tight">{isAr ? "عمرو موسى" : "Amr Mousa"}</span>
          <span class="font-sans text-[10px] text-text-main/50 leading-none">{isAr ? "نشط الآن" : "Active Now"}</span>
        </div>
      </div>
    </div>

    <!-- Primary CTA Call to Action -->
    <a 
      href={contactPath} 
      class="mobile-drawer-link w-full py-3 px-6 rounded-xl bg-text-main hover:bg-hero-accent text-white text-center font-bold text-[13px] tracking-wider transition-all duration-300 shadow-md shadow-text-main/10 active:scale-95"
    >
      {isAr ? "ناقش استراتيجيتك" : "Discuss Your Strategy"}
    </a>
  </div>
</div>

<!-- Mobile Bottom Navigation Bar -->
<nav id="mobile-bottom-nav" class="fixed bottom-0 inset-x-0 h-[56px] bg-white/85 backdrop-blur-lg border-t border-text-main/5 md:hidden z-50 flex items-center justify-around px-4 pb-safe-bottom shadow-[0_-4px_24px_rgba(10,25,47,0.04)] transition-all duration-300">
  <!-- Home Tab -->
  <a 
    href={homePath} 
    class={`flex flex-col items-center justify-center flex-1 h-full transition-colors group focus-visible:outline-none ${activePage === 'home' ? 'text-hero-accent' : 'text-text-main/60 hover:text-hero-accent'}`}
  >
    <i class="fa-solid fa-house text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "الرئيسية" : "Home"}</span>
  </a>

  <!-- Services Tab -->
  <a 
    href={servicesPath} 
    class={`flex flex-col items-center justify-center flex-1 h-full transition-colors group focus-visible:outline-none ${activePage === 'services' ? 'text-hero-accent' : 'text-text-main/60 hover:text-hero-accent'}`}
  >
    <i class="fa-solid fa-gears text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "الخدمات" : "Services"}</span>
  </a>

  <!-- Center Tab (Contact) Placeholder & Elevated Button -->
  <div class="flex-grow flex-1 flex flex-col items-center justify-end pb-1 h-full relative">
    <a 
      href={contactPath} 
      class="absolute -top-4 flex flex-col items-center justify-center group focus-visible:outline-none"
    >
      <div class="w-[48px] h-[48px] rounded-full bg-white shadow-[0_4px_16px_rgba(10,25,47,0.12)] border border-text-main/5 flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-active:scale-95 group-focus-visible:ring-2 group-focus-visible:ring-offset-2 group-focus-visible:ring-hero-accent">
        <span class="w-[32px] h-[32px] rounded-full bg-text-main flex items-center justify-center text-white p-1.5 shadow-md shadow-text-main/10 border border-white/5 select-none shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="w-full h-full text-white" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <defs>
              <linearGradient id="logo-grad-tab" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFFFFF" />
                <stop offset="60%" stop-color="#93C5FD" />
                <stop offset="100%" stop-color="#2563EB" />
              </linearGradient>
            </defs>
            <path d="M4 18V6L11 12L18 6V18" stroke="url(#logo-grad-tab)" stroke-width="2" />
            <path d="M6 16V4L13 10L20 4V16" stroke="#2563EB" class="opacity-45" stroke-width="1.2" />
            <path d="M4 6L6 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M11 12L13 10" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M18 6L20 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M4 18L6 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            <path d="M18 18L20 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
          </svg>
        </span>
      </div>
      <span class="text-[8px] font-extrabold text-text-main/60 mt-0.5 uppercase tracking-wider font-sans transition-colors group-hover:text-hero-accent">{isAr ? "اتصل بي" : "Contact"}</span>
    </a>
  </div>

  <!-- Portfolio Tab -->
  <a 
    href={projectsPath} 
    class="flex flex-col items-center justify-center flex-1 h-full text-text-main/60 hover:text-hero-accent transition-colors group focus-visible:outline-none"
  >
    <i class="fa-solid fa-briefcase text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "المشاريع" : "Portfolio"}</span>
  </a>

  <!-- About Tab -->
  <a 
    href={aboutPath} 
    class={`flex flex-col items-center justify-center flex-1 h-full transition-colors group focus-visible:outline-none ${activePage === 'about' ? 'text-hero-accent' : 'text-text-main/60 hover:text-hero-accent'}`}
  >
    <i class="fa-solid fa-user text-base transition-transform group-active:scale-90 group-focus-visible:ring-1"></i>
    <span class="text-[8px] font-bold mt-0.5 uppercase tracking-wider font-sans">{isAr ? "من أنا" : "About"}</span>
  </a>
</nav>

<!-- App Install Banner Container (Floating Card) -->
<div 
  id="app-install-banner" 
  class="fixed bottom-[72px] inset-x-4 bg-white/95 backdrop-blur-md border border-text-main/5 rounded-2xl shadow-[0_8px_32px_rgba(10,25,47,0.08)] z-40 p-4 transform translate-y-[150%] opacity-0 pointer-events-none transition-all duration-500 ease-out md:hidden flex items-start gap-3"
>
  <!-- Close Button -->
  <button 
    id="close-app-banner" 
    class="absolute top-2.5 end-2.5 w-6 h-6 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/60 hover:bg-text-main/10 hover:text-text-main transition-colors"
    aria-label={isAr ? "إغلاق" : "Close"}
  >
    <i class="fa-solid fa-xmark text-xs"></i>
  </button>

  <!-- Brand Logo Icon -->
  <div class="w-11 h-11 rounded-xl bg-text-main flex items-center justify-center text-white p-2.5 shadow-md shadow-text-main/10 border border-white/5 select-none shrink-0">
    <svg viewBox="0 0 24 24" class="w-full h-full text-white" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <defs>
        <linearGradient id="logo-grad-install" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="60%" stop-color="#93C5FD" />
          <stop offset="100%" stop-color="#2563EB" />
        </linearGradient>
      </defs>
      <path d="M4 18V6L11 12L18 6V18" stroke="url(#logo-grad-install)" stroke-width="2" />
      <path d="M6 16V4L13 10L20 4V16" stroke="#2563EB" class="opacity-45" stroke-width="1.2" />
      <path d="M4 6L6 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
      <path d="M11 12L13 10" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
      <path d="M18 6L20 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
      <path d="M4 18L6 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
      <path d="M18 18L20 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
    </svg>
  </div>

  <!-- Content -->
  <div class="flex-grow font-sans pe-6">
    <h4 class="text-[13px] font-bold text-text-main leading-tight">
      {isAr ? "ثبّت تطبيق موسى للتحليلات" : "Install Mousa Analytics App"}
    </h4>
    <p class="text-[10px] text-text-main/60 mt-0.5 leading-snug">
      {isAr ? "احصل على تجربة أسرع وأجمل على جهازك." : "Get a faster and more beautiful experience on your device."}
    </p>

    <!-- Action Button -->
    <button 
      id="install-app-btn" 
      class="mt-2.5 px-3.5 py-1.5 rounded-lg bg-text-main text-white hover:bg-hero-accent transition-colors text-[10px] font-bold flex items-center gap-1.5 shadow-sm active:scale-95 duration-200"
    >
      <i class="fa-solid fa-download text-[9px]"></i>
      <span>{isAr ? "تثبيت التطبيق الآن" : "Install App Now"}</span>
    </button>
  </div>
</div>

<!-- Instructions Modal / Bottom Sheet -->
<div 
  id="install-instructions" 
  class="fixed inset-0 bg-text-main/40 backdrop-blur-sm z-50 hidden items-end justify-center md:hidden"
>
  <!-- Bottom Sheet Card -->
  <div class="w-full bg-white rounded-t-3xl p-6 shadow-2xl space-y-4 max-w-md transform translate-y-full transition-transform duration-300">
    <div class="flex justify-between items-center pb-2 border-b border-text-main/5">
      <h3 class="text-sm font-bold text-text-main font-sans">
        {isAr ? "خطوات التثبيت على الهاتف" : "How to Install on Mobile"}
      </h3>
      <button 
        id="close-instructions-btn" 
        class="w-8 h-8 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/70 hover:bg-text-main/10"
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Steps content based on OS -->
    <div class="space-y-4 text-xs text-text-main/80 font-sans leading-relaxed">
      <!-- iOS Section -->
      <div id="ios-instructions" class="hidden space-y-3">
        <p>{isAr ? "بسبب قيود نظام iOS، يرجى اتباع الآتي للتثبيت:" : "Due to iOS constraints, please follow these steps to install:"}</p>
        <ol class="list-decimal list-inside space-y-2">
          <li>{isAr ? "اضغط على زر المشاركة في شريط المتصفح السفلي" : "Tap the Share button in the browser's bottom bar"} <i class="fa-solid fa-share-from-square text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "اسحب لأسفل واختر 'إضافة إلى الشاشة الرئيسية'" : "Scroll down and select 'Add to Home Screen'"} <i class="fa-solid fa-plus-square text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "اضغط على 'إضافة' في أعلى اليمين لتأكيد التثبيت" : "Tap 'Add' in the top right corner to confirm"}.</li>
        </ol>
      </div>

      <!-- Android Section -->
      <div id="android-instructions" class="hidden space-y-3">
        <p>{isAr ? "لتثبيت التطبيق على جهاز الأندرويد الخاص بك:" : "To install the app on your Android device:"}</p>
        <ol class="list-decimal list-inside space-y-2">
          <li>{isAr ? "اضغط على زر خيارات المتصفح (الثلاث نقاط)" : "Tap the browser options button (three dots)"} <i class="fa-solid fa-ellipsis-vertical text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "اختر 'إضافة إلى الشاشة الرئيسية' أو 'تثبيت التطبيق'" : "Select 'Add to Home Screen' or 'Install App'"} <i class="fa-solid fa-plus-square text-hero-accent mx-1 text-[13px]"></i>.</li>
          <li>{isAr ? "أكد التثبيت لتظهر الأيقونة على جهازك" : "Confirm the installation to place the icon on your device"}.</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Contact Form Modal (Bottom Sheet GPU-Accelerated) -->
<div id="contact-modal" class="fixed inset-0 z-[60] flex items-end justify-center pointer-events-none" aria-modal="true" role="dialog" aria-labelledby="contact-modal-title">
  <!-- Frosted Glass Backdrop Overlay -->
  <div id="contact-modal-backdrop" class="fixed inset-0 bg-text-main/60 backdrop-blur-md opacity-0 transition-opacity duration-300 ease-out cursor-pointer pointer-events-none"></div>
  
  <!-- Content Sheet Modal Container -->
  <div id="contact-modal-sheet" class="w-full max-w-[460px] bg-white rounded-t-[32px] p-6 pb-28 shadow-[0_-15px_40px_rgba(10,25,47,0.15)] transition-transform duration-300 ease-out z-[61] border-t border-text-main/5 pointer-events-auto flex flex-col gap-4 max-h-[85vh] overflow-y-auto overscroll-contain" style="will-change: transform; backface-visibility: hidden; transform: translate3d(0, 100%, 0); -webkit-overflow-scrolling: touch;">
    <!-- Grabber/Drag Handle -->
    <div class="w-12 h-1 bg-text-main/10 rounded-full mx-auto shrink-0" aria-hidden="true"></div>

    <!-- Header -->
    <div class="flex items-center justify-between pb-3 border-b border-text-main/5">
      <div class="flex flex-col text-start">
        <h3 id="contact-modal-title" class="font-serif text-base font-bold text-text-main">
          {isAr ? "ابدأ خدمتك الآن" : "Start Your Service"}
        </h3>
        <p class="text-[10px] md:text-xs text-text-main/50 font-sans leading-none mt-1">
          {isAr ? "أرسل تفاصيل الخدمة المطلوبة وسنتواصل معك فوراً." : "Send service details to connect instantly on WhatsApp."}
        </p>
      </div>
      <button 
        id="close-contact-modal" 
        class="w-8 h-8 rounded-full bg-text-main/5 flex items-center justify-center text-text-main/70 hover:bg-text-main/10 transition-colors"
        aria-label={isAr ? "إغلاق" : "Close"}
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Interactive Form -->
    <form id="whatsapp-lead-form" class="flex flex-col gap-4 font-sans text-start">
      <!-- 1. Type of Service (Pills) -->
      <div class="flex flex-col gap-2">
        <label class="text-[11px] font-bold text-text-main/60 uppercase tracking-wider">
          {isAr ? "ما هي الخدمة المطلوبة؟" : "What service do you need?"}
        </label>
        <div class="flex flex-wrap gap-2">
          <div class="service-pill cursor-pointer border border-hero-accent bg-hero-accent/5 text-hero-accent rounded-xl p-2.5 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none" data-value={isAr ? "تحليلات البيانات" : "Data Analytics"}>
            {isAr ? "تحليلات البيانات" : "Data Analytics"}
          </div>
          <div class="service-pill cursor-pointer border border-text-main/10 bg-slate-50 text-text-main/70 rounded-xl p-2.5 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none hover:bg-slate-100" data-value={isAr ? "استراتيجية التسويق" : "Marketing Strategy"}>
            {isAr ? "استراتيجية التسويق" : "Marketing Strategy"}
          </div>
          <div class="service-pill cursor-pointer border border-text-main/10 bg-slate-50 text-text-main/70 rounded-xl p-2.5 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none hover:bg-slate-100" data-value={isAr ? "لوحات معلومات و CRM" : "Dashboards & CRM"}>
            {isAr ? "لوحات معلومات" : "Dashboards & CRM"}
          </div>
          <div class="service-pill cursor-pointer border border-text-main/10 bg-slate-50 text-text-main/70 rounded-xl p-2.5 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none hover:bg-slate-100" data-value={isAr ? "إكسل متقدم" : "Advanced Excel"}>
            {isAr ? "إكسل متقدم" : "Advanced Excel"}
          </div>
          <div class="service-pill cursor-pointer border border-text-main/10 bg-slate-50 text-text-main/70 rounded-xl p-2.5 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none hover:bg-slate-100" data-value={isAr ? "مواقع ويب" : "Web & Portfolio"}>
            {isAr ? "مواقع ويب" : "Web & Portfolio"}
          </div>
        </div>
      </div>

      <!-- 2. Brief Domain / Industry / Idea -->
      <div class="flex flex-col gap-2">
        <label for="idea-input" class="text-[11px] font-bold text-text-main/60 uppercase tracking-wider">
          {isAr ? "مجالك أو فكرتك باختصار؟" : "Your industry or idea in brief?"}
        </label>
        <input 
          type="text" 
          id="idea-input" 
          required 
          placeholder={isAr ? "مثال: متجر الكتروني ملابس، عيادة أسنان، إلخ..." : "e.g., E-commerce fashion, Dental clinic, etc..."}
          class="w-full px-4 py-2.5 rounded-xl border border-text-main/10 bg-slate-50 text-xs font-sans focus:bg-white focus:border-hero-accent focus:ring-1 focus:ring-hero-accent transition-all duration-300 outline-none"
        />
      </div>

      <!-- 3. Message / Inquiry Details -->
      <div class="flex flex-col gap-2">
        <label for="inquiry-textarea" class="text-[11px] font-bold text-text-main/60 uppercase tracking-wider">
          {isAr ? "تفاصيل استفسارك أو مشروعك؟" : "Your inquiry or project details?"}
        </label>
        <textarea 
          id="inquiry-textarea" 
          required 
          placeholder={isAr ? "اكتب تفاصيل مشروعك أو الأسئلة التي تود مناقشتها مع عمرو..." : "Describe your project or questions you want to discuss..."}
          class="w-full px-4 py-2.5 rounded-xl border border-text-main/10 bg-slate-50 text-xs font-sans focus:bg-white focus:border-hero-accent focus:ring-1 focus:ring-hero-accent transition-all duration-300 resize-none min-h-[80px] outline-none"
        ></textarea>
      </div>

      <!-- 4. Proposed Timeline (Pills) -->
      <div class="flex flex-col gap-2">
        <label class="text-[11px] font-bold text-text-main/60 uppercase tracking-wider">
          {isAr ? "الإطار الزمني المطلوب؟" : "Desired timeline?"}
        </label>
        <div class="flex gap-2">
          <div class="timeline-pill cursor-pointer border border-hero-accent bg-hero-accent/5 text-hero-accent rounded-xl p-2.5 flex-1 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none" data-value={isAr ? "عاجل جداً (خلال أسبوع)" : "Urgent (Within 1 Week)"}>
            {isAr ? "عاجل جداً (أسبوع)" : "Urgent"}
          </div>
          <div class="timeline-pill cursor-pointer border border-text-main/10 bg-slate-50 text-text-main/70 rounded-xl p-2.5 flex-1 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none hover:bg-slate-100" data-value={isAr ? "خلال شهر" : "Within 1 Month"}>
            {isAr ? "خلال شهر" : "1 Month"}
          </div>
          <div class="timeline-pill cursor-pointer border border-text-main/10 bg-slate-50 text-text-main/70 rounded-xl p-2.5 flex-1 text-center text-xs font-bold transition-all duration-200 active:scale-95 select-none hover:bg-slate-100" data-value={isAr ? "غير محدد / مرن" : "Flexible / Undefined"}>
            {isAr ? "مرن / غير محدد" : "Flexible"}
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <button 
        type="submit" 
        class="w-full py-3.5 px-6 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-center font-bold text-xs flex items-center justify-center gap-2 transition-all duration-300 shadow-md shadow-[#16A34A]/10 active:scale-95 cursor-pointer mt-1"
      >
        <i class="fa-brands fa-whatsapp text-base"></i>
        <span>{isAr ? "إرسال الاستفسار للواتس اب" : "Send Inquiry via WhatsApp"}</span>
      </button>
    </form>
  </div>
</div>

<script>
  import { lifecycle } from '../../scripts/lifecycle';
  import { trackEvent } from '../../scripts/analytics';

  // Language switcher tracking
  const setupLanguageTracking = () => {
    const langToggle = document.getElementById('language-toggle');
    if (langToggle) {
      if (langToggle.hasAttribute('data-tracking-bound')) return;
      langToggle.setAttribute('data-tracking-bound', 'true');

      lifecycle.addListener(langToggle, 'click', () => {
        const sourceLang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
        const targetLang = sourceLang === 'ar' ? 'en' : 'ar';
        trackEvent({
          event: 'language_switch',
          source_lang: sourceLang,
          target_lang: targetLang
        });
      });
    }
  };

  setupLanguageTracking();
  document.addEventListener('astro:after-swap', setupLanguageTracking);

  // Mobile drawer scroll lock
  const menuToggle = document.getElementById('menu-toggle') as HTMLInputElement | null;
  const drawerLinks = document.querySelectorAll('.mobile-drawer-link');

  if (menuToggle) {
    const updateBodyScroll = () => {
      if (menuToggle.checked) {
        document.body.classList.add('overflow-hidden');
      } else {
        document.body.classList.remove('overflow-hidden');
      }
    };

    lifecycle.addListener(menuToggle, 'change', updateBodyScroll);

    if (drawerLinks.length > 0) {
      drawerLinks.forEach((link) => {
        lifecycle.addListener(link, 'click', () => {
          const href = link.getAttribute('href');
          if (href && href.includes('#')) {
            if (menuToggle) {
              menuToggle.checked = false;
              updateBodyScroll();
            }
          }
        });
      });
    }

    lifecycle.onCleanup(() => {
      document.body.classList.remove('overflow-hidden');
    });
  }

  // App Install Banner Logic
  let deferredPrompt: any = null;

  if (typeof window !== 'undefined') {
    window.addEventListener('beforeinstallprompt', (e: any) => {
      e.preventDefault();
      deferredPrompt = e;
    });
  }

  const initAppBanner = () => {
    const banner = document.getElementById('app-install-banner');
    const closeBtn = document.getElementById('close-app-banner');
    const installBtn = document.getElementById('install-app-btn');
    const instructionsModal = document.getElementById('install-instructions');
    const instructionsCard = instructionsModal?.querySelector('div');
    const closeInstructionsBtn = document.getElementById('close-instructions-btn');
    
    const iosInstructions = document.getElementById('ios-instructions');
    const androidInstructions = document.getElementById('android-instructions');

    if (!banner || !closeBtn || !installBtn) return;

    if (localStorage.getItem('mousa_app_banner_dismissed') === 'true') {
      return;
    }

    // Show after 4 seconds (Optimized for SEO/Performance and prevents CLS)
    const showTimeout = setTimeout(() => {
      banner.classList.remove('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }, 4000);

    lifecycle.onCleanup(() => clearTimeout(showTimeout));

    const dismissBanner = () => {
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
      localStorage.setItem('mousa_app_banner_dismissed', 'true');
    };

    lifecycle.addListener(closeBtn, 'click', dismissBanner);

    lifecycle.addListener(installBtn, 'click', () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then((choiceResult: any) => {
          if (choiceResult.outcome === 'accepted') {
            dismissBanner();
          }
          deferredPrompt = null;
        });
      } else {
        if (instructionsModal && instructionsCard) {
          const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (/\bMac\b/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
          if (isIOS) {
            iosInstructions?.classList.remove('hidden');
            androidInstructions?.classList.add('hidden');
          } else {
            androidInstructions?.classList.remove('hidden');
            iosInstructions?.classList.add('hidden');
          }

          instructionsModal.classList.remove('hidden');
          instructionsModal.classList.add('flex');
          setTimeout(() => {
            instructionsCard.classList.remove('translate-y-full');
            instructionsCard.classList.add('translate-y-0');
          }, 10);
        }
      }
    });

    const closeInstructions = () => {
      if (instructionsModal && instructionsCard) {
        instructionsCard.classList.remove('translate-y-0');
        instructionsCard.classList.add('translate-y-full');
        setTimeout(() => {
          instructionsModal.classList.remove('flex');
          instructionsModal.classList.add('hidden');
        }, 300);
      }
    };

    if (closeInstructionsBtn) {
      lifecycle.addListener(closeInstructionsBtn, 'click', closeInstructions);
    }
    if (instructionsModal) {
      lifecycle.addListener(instructionsModal, 'click', (e: Event) => {
        if (e.target === instructionsModal) {
          closeInstructions();
        }
      });
    }
  };

  // GPU-Accelerated Interactive Bottom Sheet Modal Logic
  const initContactModal = () => {
    const contactLinks = document.querySelectorAll('a[href*="#contact"]');
    const modal = document.getElementById('contact-modal');
    const backdrop = document.getElementById('contact-modal-backdrop');
    const sheet = document.getElementById('contact-modal-sheet');
    const closeBtn = document.getElementById('close-contact-modal');
    const form = document.getElementById('whatsapp-lead-form') as HTMLFormElement | null;
    
    if (!modal || !backdrop || !sheet || !closeBtn) return;

    // Mobile navigation side drawer checkbox toggler
    const menuToggle = document.getElementById('menu-toggle') as HTMLInputElement | null;
    const bottomNav = document.getElementById('mobile-bottom-nav');

    const openModal = (e: Event) => {
      e.preventDefault();
      
      // Auto close the side drawer if it was open on mobile
      if (menuToggle && menuToggle.checked) {
        menuToggle.checked = false;
        document.body.classList.remove('overflow-hidden');
      }

      // Hide mobile bottom nav so it doesn't block modal content
      if (bottomNav) {
        bottomNav.style.transform = 'translate3d(0, 100%, 0)';
        bottomNav.style.pointerEvents = 'none';
      }

      modal.classList.remove('pointer-events-none');
      modal.classList.add('pointer-events-auto');
      
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      
      // Perform butter-smooth translate3d transform handled entirely on the GPU
      sheet.style.transform = 'translate3d(0, 0, 0)';
      document.body.classList.add('overflow-hidden');
    };

    const closeModal = () => {
      // Revert translate3d down
      sheet.style.transform = 'translate3d(0, 100%, 0)';
      
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      
      // Restore mobile bottom nav
      if (bottomNav) {
        bottomNav.style.transform = '';
        bottomNav.style.pointerEvents = '';
      }
      
      setTimeout(() => {
        modal.classList.remove('pointer-events-auto');
        modal.classList.add('pointer-events-none');
        document.body.classList.remove('overflow-hidden');
      }, 350);
    };

    // Bind contact links to open modal
    contactLinks.forEach(link => {
      if (link.hasAttribute('data-modal-bound')) return;
      link.setAttribute('data-modal-bound', 'true');
      link.addEventListener('click', openModal);
    });

    // Close button
    if (!closeBtn.hasAttribute('data-modal-bound')) {
      closeBtn.setAttribute('data-modal-bound', 'true');
      closeBtn.addEventListener('click', closeModal);
    }

    // Click backdrop to close
    if (!backdrop.hasAttribute('data-modal-bound')) {
      backdrop.setAttribute('data-modal-bound', 'true');
      backdrop.addEventListener('click', closeModal);
    }

    // Escape key to close
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal.classList.contains('pointer-events-auto')) {
        closeModal();
      }
    });

    // Service pills interactive toggle
    const servicePills = sheet.querySelectorAll('.service-pill');
    servicePills.forEach(pill => {
      if (pill.hasAttribute('data-pill-bound')) return;
      pill.setAttribute('data-pill-bound', 'true');
      pill.addEventListener('click', () => {
        servicePills.forEach(p => {
          p.classList.remove('border-hero-accent', 'bg-hero-accent/5', 'text-hero-accent');
          p.classList.add('border-text-main/10', 'bg-slate-50', 'text-text-main/70');
        });
        pill.classList.remove('border-text-main/10', 'bg-slate-50', 'text-text-main/70');
        pill.classList.add('border-hero-accent', 'bg-hero-accent/5', 'text-hero-accent');
      });
    });

    // Timeline pills interactive toggle
    const timelinePills = sheet.querySelectorAll('.timeline-pill');
    timelinePills.forEach(pill => {
      if (pill.hasAttribute('data-pill-bound')) return;
      pill.setAttribute('data-pill-bound', 'true');
      pill.addEventListener('click', () => {
        timelinePills.forEach(p => {
          p.classList.remove('border-hero-accent', 'bg-hero-accent/5', 'text-hero-accent');
          p.classList.add('border-text-main/10', 'bg-slate-50', 'text-text-main/70');
        });
        pill.classList.remove('border-text-main/10', 'bg-slate-50', 'text-text-main/70');
        pill.classList.add('border-hero-accent', 'bg-hero-accent/5', 'text-hero-accent');
      });
    });

    // WhatsApp form submission
    if (form && !form.hasAttribute('data-form-bound')) {
      form.setAttribute('data-form-bound', 'true');
      form.addEventListener('submit', (e: Event) => {
        e.preventDefault();

        const selectedService = sheet.querySelector('.service-pill.border-hero-accent');
        const ideaInput = document.getElementById('idea-input') as HTMLInputElement | null;
        const inquiryTextarea = document.getElementById('inquiry-textarea') as HTMLTextAreaElement | null;
        const selectedTimeline = sheet.querySelector('.timeline-pill.border-hero-accent');

        const service = selectedService?.getAttribute('data-value') || '';
        const idea = ideaInput?.value?.trim() || '';
        const inquiry = inquiryTextarea?.value?.trim() || '';
        const timeline = selectedTimeline?.getAttribute('data-value') || '';

        const lang = document.documentElement.lang;
        const isAr = lang === 'ar';
        
        let message = '';
        if (isAr) {
          message = `\u0645\u0631\u062d\u0628\u0627\u064b \u0639\u0645\u0631\u0648\u060c \u0623\u0648\u062f \u0627\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631 \u0639\u0646 \u062a\u0641\u0627\u0635\u064a\u0644 \u0645\u0634\u0631\u0648\u0639 \u062c\u062f\u064a\u062f:\n\n` +
                    `⚙️ الخدمة المطلوبة:\n← ${service}\n\n` +
                    `💡 المجال / الفكرة:\n← ${idea}\n\n` +
                    `📝 تفاصيل الاستفسار:\n← ${inquiry}\n\n` +
                    `⏱️ الإطار الزمني المطلوب:\n← ${timeline}`;
        } else {
          message = `Hi Amr, I would like to inquire about a new project:\n\n` +
                    `⚙️ Requested Service:\n← ${service}\n\n` +
                    `💡 Industry / Idea:\n← ${idea}\n\n` +
                    `📝 Inquiry Details:\n← ${inquiry}\n\n` +
                    `⏱️ Desired Timeline:\n← ${timeline}`;
        }

        const encodedMessage = encodeURIComponent(message);
        const whatsappUrl = `https://wa.me/201017749925?text=${encodedMessage}`;
        
        // Track analytics conversion
        trackEvent({
          event: 'contact_submit_whatsapp',
          service_type: service,
          timeline: timeline
        });

        // Redirect to WhatsApp chat safely
        window.open(whatsappUrl, '_blank');
        closeModal();
      });
    }
  };

  // Run all navigation features globally under Astro View Transitions
  const runNavigationFeatures = () => {
    initAppBanner();
    initContactModal();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runNavigationFeatures);
  } else {
    runNavigationFeatures();
  }

  document.addEventListener('astro:page-load', runNavigationFeatures);
</script>
