---
import Navbar from '../layout/Navbar.astro';
import BrandMark from '../brand/BrandMark.astro';

interface Props {
  lang: string;
  activePage?: string;
  backUrl?: string;
  backText?: string;
  actionUrl?: string;
  actionText?: string;
  actionIcon?: string;
}

const { lang, activePage, backUrl, backText } = Astro.props;
const currentLang = (lang === 'en' ? 'en' : 'ar') as 'en' | 'ar';
---

<Navbar lang={currentLang} activePage={activePage} backUrl={backUrl} backText={backText} />

