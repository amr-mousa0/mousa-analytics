---
import { useTranslations } from '../../lib/locales/index';
import { siteConfig } from '../../lib/config/site.config';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappNumber = siteConfig.public.whatsappNumber;

// Dynamic datasets from centralized dictionary
const services = t.nav.contactModal.services || [];
const timelines = t.nav.contactModal.timelines || [];
---

<!-- Mobile-Only Interactive Contact Modal Sheet (md:hidden) -->
<div
  id="contact-modal-container"
  class="fixed inset-0 z-50 md:hidden hidden transition-opacity duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
  aria-describedby="contact-modal-subtitle"
>
  <!-- Backdrop Overlay -->
  <div
    id="contact-modal-backdrop"
    class="fixed inset-0 bg-text-main/60 backdrop-blur-xs transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- Sheet Container -->
  <div
    id="contact-modal-sheet"
    class="fixed bottom-0 inset-x-0 bg-bg-card rounded-t-[32px] border-t border-border-subtle shadow-xl max-h-[92vh] flex flex-col transform translate-y-full transition-transform duration-300 ease-out z-10 overflow-hidden"
  >
    <!-- Header with Drag Indicator Bar and Close Button -->
    <div class="px-6 pt-3 pb-4 border-b border-border-subtle shrink-0 relative bg-bg-card">
      <!-- Drag Handle Bar -->
      <div class="w-12 h-1.5 bg-border-strong/40 rounded-full mx-auto mb-3" aria-hidden="true"></div>

      <div class="flex items-start justify-between gap-4">
        <!-- Close Button (Top-Left in RTL / Top-Right in LTR via order) -->
        <button
          id="contact-modal-close-btn"
          type="button"
          class="w-9 h-9 rounded-full bg-bg-secondary hover:bg-border-subtle text-text-secondary flex items-center justify-center transition-colors cursor-pointer shrink-0 focus-visible:ring-2 focus-visible:ring-primary"
          aria-label={t.nav.close}
        >
          <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <!-- Title & Subtitle -->
        <div class="flex-1 text-right rtl:text-right ltr:text-left">
          <h2 id="contact-modal-title" class="text-xl font-bold text-text-primary tracking-tight">
            {t.nav.contactModal.title}
          </h2>
          <p id="contact-modal-subtitle" class="text-xs text-text-muted mt-1 leading-relaxed">
            {t.nav.contactModal.subtitle}
          </p>
        </div>
      </div>
    </div>

    <!-- Scrollable Form Body -->
    <div class="p-6 space-y-5 overflow-y-auto flex-1 text-right rtl:text-right ltr:text-left">
      <!-- 1. Service Selection -->
      <div class="space-y-2.5">
        <label class="block text-sm font-semibold text-text-secondary">
          {t.nav.contactModal.selectServicePrompt}
        </label>
        <div id="service-pills-container" class="flex flex-wrap gap-2.5 justify-start">
          {services.map((service, index) => (
            <button
              type="button"
              data-service-id={service.id}
              data-service-label={service.label}
              class={`service-pill px-4 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 cursor-pointer border select-none ${
                index === 0
                  ? 'bg-bg-card border-2 border-primary text-primary font-semibold shadow-xs'
                  : 'bg-bg-secondary border-border-subtle text-text-primary hover:border-border-strong'
              }`}
            >
              {service.label}
            </button>
          ))}
        </div>
      </div>

      <!-- 2. Industry / Idea Input -->
      <div class="space-y-2">
        <label for="contact-industry-input" class="block text-sm font-semibold text-text-secondary">
          {t.nav.contactModal.industryPrompt}
        </label>
        <input
          id="contact-industry-input"
          type="text"
          placeholder={t.nav.contactModal.industryPlaceholder}
          class="w-full px-4 py-3 rounded-2xl bg-bg-secondary border border-border-subtle text-sm text-text-primary placeholder:text-text-muted focus:bg-bg-card focus:border-border-accent focus:outline-none transition-colors"
        />
      </div>

      <!-- 3. Inquiry / Project Details Textarea -->
      <div class="space-y-2">
        <label for="contact-details-input" class="block text-sm font-semibold text-text-secondary">
          {t.nav.contactModal.inquiryPrompt}
        </label>
        <textarea
          id="contact-details-input"
          rows="3"
          placeholder={t.nav.contactModal.inquiryPlaceholder}
          class="w-full px-4 py-3 rounded-2xl bg-bg-secondary border border-border-subtle text-sm text-text-primary placeholder:text-text-muted focus:bg-bg-card focus:border-border-accent focus:outline-none transition-colors resize-none"
        ></textarea>
      </div>

      <!-- 4. Timeline Selection -->
      <div class="space-y-2.5">
        <label class="block text-sm font-semibold text-text-secondary">
          {t.nav.contactModal.timelinePrompt}
        </label>
        <div id="timeline-pills-container" class="flex flex-wrap gap-2.5 justify-start">
          {timelines.map((timeline, index) => (
            <button
              type="button"
              data-timeline-id={timeline.id}
              data-timeline-label={timeline.label}
              class={`timeline-pill px-4 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 cursor-pointer border select-none ${
                index === 0
                  ? 'bg-bg-card border-2 border-primary text-primary font-semibold shadow-xs'
                  : 'bg-bg-secondary border-border-subtle text-text-primary hover:border-border-strong'
              }`}
            >
              {timeline.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer with WhatsApp Action Button -->
    <div class="p-6 pt-3 pb-8 border-t border-border-subtle bg-bg-card shrink-0">
      <button
        id="contact-modal-submit-btn"
        type="button"
        class="w-full py-4 px-6 rounded-2xl bg-success-primary hover:bg-success-hover text-white font-bold text-base flex items-center justify-center gap-3 shadow-md transition-all active:scale-[0.99] cursor-pointer focus-visible:ring-2 focus-visible:ring-success-primary"
      >
        <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>{t.nav.contactModal.submitWhatsApp}</span>
      </button>
    </div>
  </div>
</div>

<!-- Client-Side Controller Script -->
<script is:inline define:vars={{ whatsappNumber, tMsg: t.nav.contactModal }}>
  (() => {
    let container = null;
    let backdrop = null;
    let sheet = null;
    let closeBtn = null;
    let submitBtn = null;
    let industryInput = null;
    let detailsInput = null;

    let selectedService = tMsg.services && tMsg.services[0] ? tMsg.services[0].label : '';
    let selectedTimeline = tMsg.timelines && tMsg.timelines[0] ? tMsg.timelines[0].label : '';
    let previousOverflow = '';
    let previousFocusedElement = null;

    const initModal = () => {
      container = document.getElementById('contact-modal-container');
      backdrop = document.getElementById('contact-modal-backdrop');
      sheet = document.getElementById('contact-modal-sheet');
      closeBtn = document.getElementById('contact-modal-close-btn');
      submitBtn = document.getElementById('contact-modal-submit-btn');
      industryInput = document.getElementById('contact-industry-input');
      detailsInput = document.getElementById('contact-details-input');

      if (!container || !sheet) return;

      // Ensure initial closed state on load
      container.classList.add('hidden', 'opacity-0', 'pointer-events-none');
      sheet.classList.add('translate-y-full');

      // Pill click delegation - Service
      const servicePills = document.querySelectorAll('.service-pill');
      servicePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          servicePills.forEach((p) => {
            p.className = 'service-pill px-4 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 cursor-pointer border select-none bg-bg-secondary border-border-subtle text-text-primary hover:border-border-strong';
          });
          pill.className = 'service-pill px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all duration-200 cursor-pointer border-2 border-primary text-primary bg-bg-card shadow-xs select-none';
          selectedService = pill.getAttribute('data-service-label') || pill.textContent.trim();
        });
      });

      // Pill click delegation - Timeline
      const timelinePills = document.querySelectorAll('.timeline-pill');
      timelinePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          timelinePills.forEach((p) => {
            p.className = 'timeline-pill px-4 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 cursor-pointer border select-none bg-bg-secondary border-border-subtle text-text-primary hover:border-border-strong';
          });
          pill.className = 'timeline-pill px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all duration-200 cursor-pointer border-2 border-primary text-primary bg-bg-card shadow-xs select-none';
          selectedTimeline = pill.getAttribute('data-timeline-label') || pill.textContent.trim();
        });
      });

      // Close events
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);

      // Submit WhatsApp event
      if (submitBtn) submitBtn.addEventListener('click', handleSubmit);

      // Key handlers (Escape & Focus trap)
      document.addEventListener('keydown', (e) => {
        if (container && !container.classList.contains('hidden')) {
          if (e.key === 'Escape') {
            closeModal();
          } else if (e.key === 'Tab') {
            handleFocusTrap(e);
          }
        }
      });

      // Global open triggers (mobile viewports only)
      document.querySelectorAll('[data-open-contact-modal]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          if (!window.matchMedia('(min-width: 768px)').matches) {
            e.preventDefault();
            openModal(trigger);
          }
        });
      });

      // Global event listener
      window.addEventListener('open-contact-modal', () => {
        if (!window.matchMedia('(min-width: 768px)').matches) {
          openModal(null);
        }
      });
    };

    const openModal = (triggerElement) => {
      if (!container || !sheet) return;
      previousFocusedElement = triggerElement || document.activeElement;

      // Lock body scroll safely
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';

      container.classList.remove('hidden');
      requestAnimationFrame(() => {
        container.classList.remove('opacity-0', 'pointer-events-none');
        sheet.classList.remove('translate-y-full');
      });

      // Focus close button initially for accessibility
      setTimeout(() => {
        if (closeBtn) closeBtn.focus();
      }, 100);
    };

    const closeModal = () => {
      if (!container || !sheet) return;

      sheet.classList.add('translate-y-full');
      container.classList.add('opacity-0', 'pointer-events-none');

      setTimeout(() => {
        container.classList.add('hidden');
        // Restore previous overflow safely
        document.body.style.overflow = previousOverflow;

        // Restore focus to trigger element
        if (previousFocusedElement && typeof previousFocusedElement.focus === 'function') {
          previousFocusedElement.focus();
        }
      }, 300);
    };

    const handleFocusTrap = (e) => {
      if (!container) return;
      const focusables = container.querySelectorAll('button, input, textarea, a, [tabindex]:not([tabindex="-1"])');
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const handleSubmit = () => {
      const industryVal = industryInput ? industryInput.value.trim() : '';
      const detailsVal = detailsInput ? detailsInput.value.trim() : '';

      const greeting = tMsg.greeting || 'السلام عليكم،';
      const sLabel = tMsg.msgServiceLabel || 'الخدمة:';
      const iLabel = tMsg.msgIndustryLabel || 'المجال:';
      const dLabel = tMsg.msgDetailsLabel || 'وصف المشروع:';
      const tLabel = tMsg.msgTimelineLabel || 'المدة المطلوبة:';
      const thanks = tMsg.msgThanks || 'شكراً.';

      const formattedMsg = `${greeting}\n\n${sLabel} ${selectedService}\n${iLabel} ${industryVal || '-'}\n${dLabel}\n${detailsVal || '-'}\n\n${tLabel} ${selectedTimeline}\n\n${thanks}`;

      const encodedText = encodeURIComponent(formattedMsg);
      const url = `https://wa.me/${whatsappNumber}?text=${encodedText}`;

      window.open(url, '_blank', 'noopener,noreferrer');

      // Reset form fields
      if (industryInput) industryInput.value = '';
      if (detailsInput) detailsInput.value = '';

      closeModal();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initModal);
    } else {
      initModal();
    }

    document.addEventListener('astro:after-swap', initModal);
  })();
</script>
