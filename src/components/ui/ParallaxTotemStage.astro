---
import BrandMark from '../brand/BrandMark.astro';
import Icon from './Icon.astro';
import { useTranslations } from '../../i18n/index.ts';

interface Props {
  lang: 'en' | 'ar';
}

const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const t = useTranslations(lang);

// 7 Minimalist High-End Agency Totem Cards (Lowered further for optimal section framing)
const totemCards = [
  {
    id: 1,
    kind: 'graphic' as const,
    alt: 'Verified Growth Metric',
    label: t.hero.stat1Val || '+182%',
    subLabel: t.hero.totem.verifiedGrowth,
    depth: 0.4,
    aspect: 'aspect-[16/10]',
    rotation: -14,
    leftPct: 9,
    topPct: 46,
    widthClamp: 'clamp(170px, 17vw, 280px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/12 shadow-2xl',
    bg: 'bg-[#0d0e14] text-white',
    zIndex: 35,
  },
  {
    id: 2,
    kind: 'image' as const,
    src: '/images/gallery/pic1.png',
    alt: 'Café & Bar Sales Performance',
    label: t.hero.totem.salesAnalytics,
    tag: 'Sales Performance',
    depth: 0.6,
    aspect: 'aspect-[16/10]',
    rotation: -9,
    leftPct: 21,
    topPct: 56,
    widthClamp: 'clamp(195px, 19vw, 320px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/10 shadow-2xl',
    bg: 'bg-[#0d0e12]',
    zIndex: 25,
  },
  {
    id: 3,
    kind: 'image' as const,
    src: '/images/gallery/pic2.png',
    alt: 'Net Profit Breakdown',
    label: t.hero.totem.netProfit,
    tag: 'Profit Analytics',
    depth: 0.85,
    aspect: 'aspect-[16/10]',
    rotation: -4,
    leftPct: 34,
    topPct: 42,
    widthClamp: 'clamp(215px, 21vw, 360px)',
    borderRadius: 'rounded-[22px]',
    borderStyle: 'border border-white/12 shadow-2xl',
    bg: 'bg-[#0e0f14]',
    zIndex: 35,
  },
  {
    id: 4,
    kind: 'image' as const,
    src: '/images/gallery/pic4.png',
    alt: 'Marketing ROI Overview',
    label: t.hero.totem.marketingOverview,
    tag: 'Marketing ROI',
    depth: 1.1,
    aspect: 'aspect-[16/10]',
    rotation: 0,
    leftPct: 48,
    topPct: 34,
    widthClamp: 'clamp(240px, 24vw, 410px)',
    borderRadius: 'rounded-[24px]',
    borderStyle: 'border border-white/20 shadow-[0_25px_60px_rgba(0,0,0,0.95)]',
    bg: 'bg-[#0a0b0f]',
    zIndex: 45,
    isCenterAnchor: true,
  },
  {
    id: 5,
    kind: 'image' as const,
    src: '/images/gallery/pic5.png',
    alt: 'Conversion Rate Funnel',
    label: t.hero.totem.conversionFunnel,
    tag: 'Funnel Analytics',
    depth: 0.85,
    aspect: 'aspect-[16/10]',
    rotation: 4,
    leftPct: 61,
    topPct: 44,
    widthClamp: 'clamp(215px, 21vw, 360px)',
    borderRadius: 'rounded-[22px]',
    borderStyle: 'border border-white/12 shadow-2xl',
    bg: 'bg-[#0e0f14]',
    zIndex: 35,
  },
  {
    id: 6,
    kind: 'image' as const,
    src: '/images/gallery/pic3.png',
    alt: 'Customer Acquisition Matrix',
    label: t.hero.totem.acquisitionMatrix,
    tag: 'Customer Growth',
    depth: 0.6,
    aspect: 'aspect-[16/10]',
    rotation: 9,
    leftPct: 73,
    topPct: 54,
    widthClamp: 'clamp(195px, 19vw, 320px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/10 shadow-2xl',
    bg: 'bg-[#0d0e12]',
    zIndex: 25,
  },
  {
    id: 7,
    kind: 'image' as const,
    src: '/images/gallery/pic1.png',
    alt: 'Executive BI Dashboard',
    label: t.hero.totem.executiveBi,
    tag: 'Executive Dashboard',
    depth: 0.4,
    aspect: 'aspect-[16/10]',
    rotation: 14,
    leftPct: 85,
    topPct: 60,
    widthClamp: 'clamp(170px, 17vw, 280px)',
    borderRadius: 'rounded-[20px]',
    borderStyle: 'border border-white/10 shadow-2xl',
    bg: 'bg-[#0c0d10]',
    zIndex: 20,
