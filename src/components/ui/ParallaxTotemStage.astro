---

<div class="totem-stage-wrapper relative w-full overflow-hidden py-20 md:py-32 select-none min-h-[660px] sm:min-h-[780px] md:min-h-[960px] flex items-center justify-center">

  <!-- Minimal Ambient Background Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.03)_0%,rgba(8,8,7,0)_75%)] pointer-events-none" aria-hidden="true"></div>

  <!-- Stage Title Overline -->
  <div class="absolute top-6 left-1/2 -translate-x-1/2 z-20 pointer-events-none text-center">
    <span class="font-mono text-[9px] sm:text-[11px] uppercase tracking-[0.32em] text-white/40 font-medium block mb-1">
      {t.hero.totem.overlappingStacks}
    </span>
    <div class="w-12 h-px bg-white/15 mx-auto"></div>
  </div>

  <!-- Horizontal Canvas Grid (Lowered vertical frame with ample space) -->
  <div class="totem-canvas relative z-10 w-full max-w-[1650px] mx-auto min-h-[600px] sm:min-h-[720px] md:min-h-[880px] px-2 sm:px-4 pt-20">

    {totemCards.map((card) => (
      <div
        class={`totem-card absolute ${card.aspect} p-1 sm:p-1.5 bg-white/[0.04] backdrop-blur-xl border border-white/12 shadow-[0_25px_60px_rgba(0,0,0,0.85)] ${card.borderRadius} transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:!z-50 hover:scale-[1.03] hover:-translate-y-3 hover:border-white/35 hover:shadow-[0_40px_90px_rgba(0,0,0,0.95)] cursor-pointer group`}
        data-depth={card.depth}
        data-rotation={card.rotation}
        data-left={card.leftPct}
        data-top={card.topPct}
        data-center={card.isCenterAnchor ? 'true' : 'false'}
        style={`left: ${card.leftPct}%; top: ${card.topPct}%; width: ${card.widthClamp}; transform: translate(-50%, 0) rotate(${card.rotation}deg); z-index: ${card.zIndex};`}
      >
        <div class="totem-card__inner relative w-full h-full rounded-[calc(20px-0.375rem)] overflow-hidden bg-[#06070a] ring-1 ring-white/10 shadow-inner">
          {card.kind === 'graphic' ? (
            <div class="w-full h-full p-5 sm:p-6 flex flex-col items-center justify-center text-center gap-3 relative bg-[#0c0d12] text-white">
              <div class="w-8 h-8 sm:w-9 sm:h-9 text-white/80 mb-1">
                <BrandMark size={36} class="w-full h-full text-white/90" />
              </div>
              <span class="font-serif text-3xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-white leading-none">
                {card.label}
              </span>
              <span class="font-mono text-[8px] sm:text-[10px] font-medium uppercase tracking-[0.2em] text-white/60 mt-1">
                {card.subLabel}
              </span>
              <div class="absolute bottom-3 inset-x-3 bg-white/[0.06] border border-white/10 rounded-full py-1 text-[8px] sm:text-[9px] font-medium text-white/70 uppercase tracking-widest text-center">
                {t.hero.totem.verifiedGrowthLabel}
              </div>
            </div>
          ) : (
            <div class="relative w-full h-full overflow-hidden bg-[#06070a]">
              <img
                src={card.src}
                alt={card.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center opacity-95 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]"
              />
            </div>
          )}
        </div>
      </div>
    ))}

  </div>

  <!-- Bottom Stage Fade Out -->
  <div class="absolute bottom-0 inset-x-0 h-28 bg-gradient-to-t from-[#080807] to-transparent pointer-events-none z-30"></div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTotemEntrance() {
    const stage = document.querySelector('.totem-stage-wrapper');
    if (!stage) return;

    const cards = stage.querySelectorAll<HTMLElement>('.totem-card');
    if (!cards.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    // 1. Initial State: Stacked together at lowered center totem stack
    cards.forEach((card) => {
      const isCenter = card.dataset.center === 'true';
      gsap.set(card, {
        left: '50%',
        top: '65%',
        xPercent: -50,
        yPercent: -50,
        scale: isCenter ? 0.85 : 0.65,
        rotation: 0,
        opacity: 0,
        filter: 'blur(6px)',
      });
    });

    // 2. Entrance Animation on ScrollTrigger reveal
    ScrollTrigger.create({
      trigger: stage,
      start: 'top 85%',
      end: 'top 20%',
      onEnter: () => animateTotemEntrance(),
      once: true,
    });

    function animateTotemEntrance() {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 1.2 } });

      cards.forEach((card, index) => {
        const targetLeft = parseFloat(card.dataset.left || '50');
        const targetTop = parseFloat(card.dataset.top || '40');
        const targetRotation = parseFloat(card.dataset.rotation || '0');
        const depth = parseFloat(card.dataset.depth || '0.5');

        tl.to(
          card,
          {
            left: `${targetLeft}%`,
            top: `${targetTop}%`,
            rotation: targetRotation,
            scale: 1,
            opacity: 1,
            filter: 'blur(0px)',
            duration: 1.1 + depth * 0.3,
          },
          index * 0.07
        );
      });

      // 3. Parallax Scrub during vertical scroll
      cards.forEach((card) => {
        const depth = parseFloat(card.dataset.depth || '0.5');
        gsap.to(card, {
          y: `${(1 - depth) * -80}px`,
          ease: 'none',
          scrollTrigger: {
            trigger: stage,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });
      });
    }
  }

  initTotemEntrance();
  document.addEventListener('astro:after-swap', initTotemEntrance);
</script>

<style>
  .totem-card {
    will-change: transform, opacity, left, top;
    transform-origin: center center;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (max-width: 767px) {
    .totem-canvas {
      min-height: 580px;
    }
    .totem-card {
      width: clamp(120px, 34vw, 175px) !important;
    }
  }
</style>
