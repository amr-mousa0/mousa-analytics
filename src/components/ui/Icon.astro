const icon = icons[cleanName] || icons['laptop-code'];
---

<svg 
  viewBox={icon.viewBox}
  class={className}
  aria-hidden={ariaHidden}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icon.svg}
/>
