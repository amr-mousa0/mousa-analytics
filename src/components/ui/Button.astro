---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  disabled = false,
  class: className = '',
  id,
  ...rest
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-md transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none cursor-pointer";

const variants = {
  primary: "bg-primary text-white hover:bg-accent-highlight focus:ring-primary",
  secondary: "bg-bg-secondary text-text-primary hover:bg-bg-tertiary focus:ring-text-muted",
  outline: "border border-border-strong text-text-primary hover:bg-bg-secondary focus:ring-border-accent",
  ghost: "text-text-primary hover:bg-bg-secondary focus:ring-border-subtle",
};

const sizes = {
  sm: "px-3 py-1.5 text-xs",
  md: "px-4 py-2 text-sm",
  lg: "px-6 py-3 text-base",
};

const classes = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      target={target}
      rel={rel || (target === '_blank' ? 'noopener noreferrer' : undefined)}
      class={classes}
      id={id}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      class={classes}
      id={id}
      {...rest}
    >
      <slot />
    </button>
  )
}
