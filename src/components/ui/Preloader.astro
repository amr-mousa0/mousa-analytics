---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
---

<!-- Premium preloader overlay -->
<div 
  id="global-preloader" 
  class="fixed inset-0 bg-[#0A192F] z-[99999] flex flex-col items-center justify-center select-none" 
  aria-hidden="true"
>
  <!-- Fine background mesh/grid to fit the "Precision Infrastructure" design principle -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.08),transparent)] pointer-events-none"></div>
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px); background-size: 4rem 4rem;"></div>

  <div class="flex flex-col items-center text-center px-6 max-w-xl relative z-10">
    <!-- Main Branding Title with premium typography -->
    <div class="overflow-hidden mb-4 py-1">
      <h1 
        id="preloader-title"
        class="font-logo text-3xl sm:text-5xl md:text-6xl font-bold text-white tracking-[0.2em] transform translate-y-full opacity-0 will-change-transform"
      >
        {isAr ? "موسى للتحليلات" : "MOUSA ANALYTICS"}
      </h1>
    </div>
    
    <!-- Subtitle with wider tracking and premium branding color -->
    <div class="overflow-hidden mb-10 py-1">
      <p 
        id="preloader-subtitle"
        class="font-sans text-[10px] sm:text-xs md:text-sm font-bold tracking-[0.3em] uppercase text-[#2563EB] transform translate-y-full opacity-0 will-change-transform"
      >
        {isAr ? "حلول تحليل البيانات وتحقيق العائد من الاستثمار" : "DATA ANALYTICS & MARKETING ROI SOLUTIONS"}
      </p>
    </div>
    
    <!-- Premium glowing loading bar exactly like the reference -->
    <div 
      id="preloader-bar-container"
      class="w-56 sm:w-64 h-[2px] bg-white/10 rounded-full overflow-hidden relative opacity-0"
    >
      <div 
        id="preloader-bar"
        class="absolute inset-y-0 left-0 bg-gradient-to-r from-[#2563EB] via-[#93C5FD] to-[#2563EB] w-full h-full transform -translate-x-full"
      ></div>
    </div>
  </div>
</div>

<style is:global>
  /* Base state: preloader overlay styling */
  #global-preloader {
    display: none;
    opacity: 0;
    will-change: opacity, transform;
  }

  /* Slide up curtain transition on exit */
  .preloader-exit {
    opacity: 0 !important;
    transform: translateY(-100%) !important;
    pointer-events: none !important;
  }

  /* Progress bar animation keyframes */
  .preloader-progress-active {
    animation: preloader-progress-bar 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes preloader-progress-bar {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(-25%); }
    100% { transform: translateX(0); }
  }
</style>

<script is:inline>
  (function() {
    // 1. Guard against search crawlers and performance tools only (NOT standard developer preview modes)
    const isBot = /bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse/i.test(navigator.userAgent);
    if (isBot) {
      return;
    }

    const preloader = document.getElementById('global-preloader');
    const title = document.getElementById('preloader-title');
    const subtitle = document.getElementById('preloader-subtitle');
    const barContainer = document.getElementById('preloader-bar-container');
    const bar = document.getElementById('preloader-bar');

    if (!preloader) return;

    let showStartTime = 0;
    const MIN_INITIAL_DURATION = 1500; // Hold initial preloader for 1.5s to display the premium animation
    const MIN_TRANSITION_DURATION = 800; // Hold page transitions for 0.8s for smooth client-side loading visual

    function showPreloader(isTransition = false) {
      showStartTime = Date.now();
      preloader.classList.remove('preloader-exit');
      preloader.style.display = 'flex';
      
      // Reset element styles to hidden before animating in
      if (title) {
        title.style.transform = 'translateY(100%)';
        title.style.opacity = '0';
      }
      if (subtitle) {
        subtitle.style.transform = 'translateY(100%)';
        subtitle.style.opacity = '0';
      }
      if (barContainer) {
        barContainer.style.opacity = '0';
      }
      if (bar) {
        bar.classList.remove('preloader-progress-active');
      }

      // Force layout reflow
      preloader.offsetHeight;

      // Fade-in preloader panel
      preloader.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
      preloader.style.opacity = '1';
      preloader.style.transform = 'translateY(0)';

      // Trigger beautiful coordinated entrance animations
      requestAnimationFrame(() => {
        if (title) {
          title.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease';
          title.style.transform = 'translateY(0)';
          title.style.opacity = '1';
        }
        if (subtitle) {
          subtitle.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, opacity 0.8s ease 0.15s';
          subtitle.style.transform = 'translateY(0)';
          subtitle.style.opacity = '1';
        }
        if (barContainer) {
          barContainer.style.transition = 'opacity 0.5s ease 0.3s';
          barContainer.style.opacity = '1';
        }
        if (bar) {
          bar.offsetWidth; // force reflow
          bar.classList.add('preloader-progress-active');
        }
      });
    }

    function hidePreloader(isTransition = false) {
      const minDuration = isTransition ? MIN_TRANSITION_DURATION : MIN_INITIAL_DURATION;
      const elapsed = Date.now() - showStartTime;
      const remaining = Math.max(0, minDuration - elapsed);

      setTimeout(() => {
        // Luxury slide up exit animation
        preloader.style.transition = 'opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1)';
        preloader.classList.add('preloader-exit');

        setTimeout(() => {
          preloader.style.display = 'none';
        }, 850);
      }, remaining);
    }

    // Run initial preloader instantly
    showPreloader(false);
    
    if (document.readyState === 'complete') {
      hidePreloader(false);
    } else {
      window.addEventListener('load', () => {
        hidePreloader(false);
      });
      // Safe fallback timeout
      setTimeout(() => hidePreloader(false), 3500);
    }

    // 2. Setup Astro transitions handling if not already initialized
    if (!window.__mousa_preloader_initialized) {
      window.__mousa_preloader_initialized = true;

      // When a new page is clicked (transition starts)
      document.addEventListener('astro:before-preparation', () => {
        showPreloader(true);
      });

      // When the new page is fully loaded and swapped (transition ends)
      document.addEventListener('astro:page-load', () => {
        hidePreloader(true);
      });
    }
  })();
</script>
