---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
---

<!-- Premium preloader overlay with transition:persist to survive page swaps -->
<div 
  id="global-preloader" 
  transition:persist
  class="select-none" 
  aria-hidden="true"
>
  <!-- Background subtle aura glow and grid -->
  <div class="absolute inset-0 bg-[var(--preloader-bg)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.06),transparent_65%)] pointer-events-none"></div>
  <div class="absolute inset-0 opacity-[0.02] pointer-events-none" style="background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px); background-size: 3.5rem 3.5rem;"></div>

  <div class="flex flex-col items-center justify-center text-center px-6 max-w-4xl relative z-10">
    
    <!-- Premium Geometric M Logo (Self-Drawing SVG) -->
    <div class="w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40 mb-12 text-white relative">
      <svg viewBox="0 0 100 100" class="w-full h-full" fill="none">
        <defs>
          <linearGradient id="preloader-logo-grad" x1="20" y1="10" x2="90" y2="60" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#0F4C5C" />
            <stop offset="100%" stop-color="var(--preloader-accent)" />
          </linearGradient>
          <linearGradient id="preloader-accent-grad" x1="10" y1="35" x2="30" y2="60" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="var(--preloader-accent-light)" />
            <stop offset="100%" stop-color="var(--preloader-accent)" />
          </linearGradient>
        </defs>
        <g transform="translate(2.5, 12.5) scale(0.95)">
          <path
            class="logo-shape logo-dot"
            d="M 21.5,59.5 C 16.5,59.5 13.0,55.0 12.0,49.0 C 11.0,43.0 14.0,37.0 18.0,37.5 C 22.0,38.0 25.0,44.0 27.5,48.0 C 30.0,52.0 26.5,59.5 21.5,59.5 Z"
            fill="url(#preloader-accent-grad)" />
          <path
            class="logo-shape logo-pillar"
            d="M 52.38,59.37 C 48.00,59.37 45.00,57.50 44.50,55.95 L 28.44,22.34 C 26.80,21.00 24.72,21.00 23.09,21.75 C 26.00,14.50 29.50,10.00 32.16,10.00 C 34.83,10.00 37.00,11.00 38.85,12.23 L 56.10,47.32 C 58.00,48.36 60.00,48.36 61.15,47.62 C 58.00,56.00 55.00,59.37 52.38,59.37 Z M 45.62,26.00 Q 47.67,30.16 52.79,26.00 L 52.79,35.00 L 45.62,35.00 Z"
            fill="url(#preloader-logo-grad)" />
          <path
            class="logo-shape logo-arch"
            d="M 81.22,59.37 C 76.84,59.37 73.84,57.50 73.34,55.95 L 64.28,37.00 Q 62.31,32.87 57.26,37.00 L 52.82,40.63 L 50.00,59.37 L 36.52,39.28 L 57.28,22.34 C 55.64,21.00 53.56,21.00 51.93,21.75 C 54.84,14.50 58.34,10.00 61.00,10.00 C 63.67,10.00 65.84,11.00 67.69,12.23 L 84.94,47.32 C 86.84,48.36 88.84,48.36 89.99,47.62 C 86.84,56.00 83.84,59.37 81.22,59.37 Z"
            fill="url(#preloader-logo-grad)" />
          <path class="logo-trendline" d="M 19.80,48.50 L 53.98,43.00 L 82.82,43.00" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="1" />
          <circle class="logo-trend-dot" cx="19.80" cy="48.50" r="3" fill="#38BDF8" />
          <circle class="logo-trend-dot" cx="53.98" cy="43.00" r="3" fill="#38BDF8" />
          <circle class="logo-trend-dot" cx="82.82" cy="43.00" r="3" fill="#38BDF8" />
        </g>
      </svg>
    </div>

    <!-- Main Branding Title - DIV instead of H1 for SEO semantics, ARIA for accessibility -->
    <div class="overflow-hidden mb-4 py-1">
      <div 
        id="preloader-title"
        class={`text-3xl sm:text-5xl md:text-6xl font-bold uppercase ${isAr ? 'tracking-normal' : 'tracking-[0.3em] sm:tracking-[0.35em]'}`}
        role="status"
        aria-live="polite"
      >
        {isAr ? "موسى للتحليلات" : "MOUSA ANALYTICS"}
      </div>
    </div>
    
    <!-- Subtitle -->
    <div class="overflow-hidden mb-16 py-1">
      <p 
        id="preloader-subtitle"
        class={`text-[10px] sm:text-xs md:text-sm font-medium uppercase ${isAr ? 'tracking-normal' : 'tracking-[0.3em] sm:tracking-[0.4em]'}`}
      >
        {isAr ? "تبسيط البيانات لقرارات أفضل" : "SIMPLIFYING DATA FOR BETTER DECISIONS"}
      </p>
    </div>
    
    <!-- Thin loading bar scaled up visually -->
    <div 
      id="preloader-bar-container"
      class="w-64 sm:w-96 md:w-[480px] lg:w-[600px] h-[3px] bg-white/10 overflow-hidden relative"
    >
      <div 
        id="preloader-bar"
        class="absolute inset-y-0 left-0 bg-[var(--preloader-accent)] w-full h-full"
      ></div>
    </div>
  </div>
</div>

<style is:global>
  /* Bypass preloader rendering completely when bot agent class is set on HTML */
  html.is-bot #global-preloader,
  .is-bot #global-preloader {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Mobile viewport first paint bypass to prevent LCP/FCP render-blocking on mobile (Mobile-First) */
  @media (max-width: 767px) {
    #global-preloader {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
    html.preloader-lock,
    html.preloader-lock body {
      overflow: auto !important;
      height: auto !important;
    }
  }

  /* Fixed overlay covering the entire screen by default */
  #global-preloader {
    --preloader-bg: var(--color-text-main);
    --preloader-accent: var(--color-accent-primary);
    --preloader-accent-light: var(--color-accent-light);

    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 1;
    /* Use opacity transition only to avoid heavy GPU full-page rasterization resizing lag */
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity;
  }

  /* Monogram Preloader animations */
  .logo-shape {
    opacity: 0;
    transform: translateY(10px);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease;
  }
  .logo-dot {
    transition-delay: 0.05s;
  }
  .logo-pillar {
    transition-delay: 0.15s;
  }
  .logo-arch {
    transition-delay: 0.25s;
  }
  .logo-trendline {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.8s cubic-bezier(0.25, 1, 0.5, 1) 0.35s;
  }
  .logo-trend-dot {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .logo-trend-dot:nth-of-type(1) { transition-delay: 0.45s; }
  .logo-trend-dot:nth-of-type(2) { transition-delay: 0.6s; }
  .logo-trend-dot:nth-of-type(3) { transition-delay: 0.75s; }

  /* Custom typography with fallback to prevent FOIT */
  #preloader-title {
    font-family: var(--font-logo), 'Cinzel', serif;
    color: #ffffff;
    transform: translateY(15px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, opacity 0.8s ease 0.3s;
  }

  #preloader-subtitle {
    font-family: var(--font-sans), 'Outfit', 'Inter', sans-serif;
    color: var(--preloader-accent-light); /* Light ice blue for optimal contrast and readability on dark background */
    transform: translateY(10px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s, opacity 0.8s ease 0.45s;
  }

  #preloader-bar-container {
    opacity: 0;
    transition: opacity 0.6s ease 0.6s;
  }

  #preloader-bar {
    transform: translateX(-100%);
    will-change: transform;
  }

  /* Active state triggers */
  .preloader-active .logo-shape {
    opacity: 1;
    transform: translateY(0);
  }
  .preloader-active .logo-trendline {
    stroke-dashoffset: 0;
  }
  .preloader-active .logo-trend-dot {
    opacity: 1;
  }
  .preloader-active #preloader-title {
    transform: translateY(0);
    opacity: 1;
  }
  .preloader-active #preloader-subtitle {
    transform: translateY(0);
    opacity: 1;
  }
  .preloader-active #preloader-bar-container {
    opacity: 1;
  }

  /* Exit transition class (fade-only for extreme rendering speed) */
  .preloader-exit {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  /* Progress bar animation binding to variable duration */
  .preloader-progress-active {
    animation: preloader-progress-bar var(--bar-duration, 2s) cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes preloader-progress-bar {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(-20%); }
    100% { transform: translateX(0); }
  }

  /* Prevent scroll shift or back scroll during preloader active stage */
  html.preloader-lock,
  html.preloader-lock body {
    overflow: hidden !important;
    height: 100% !important;
  }

  /* Reduced motion preference compliance */
  @media (prefers-reduced-motion: reduce) {
    #global-preloader {
      transition: none !important;
    }
    .logo-shape,
    .logo-trendline,
    .logo-trend-dot,
    #preloader-title,
    #preloader-subtitle,
    #preloader-bar-container {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
    }
    #preloader-bar {
      transform: translateX(0) !important;
      transition: none !important;
      animation: none !important;
    }
    .preloader-exit {
      opacity: 0 !important;
      transition: opacity 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (function() {
    var isLocalTest = typeof location !== 'undefined' && (location.port === '4322' || location.port === '4323' || location.search.indexOf('lighthouse') !== -1);
    var isBot = isLocalTest || /bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse|lighthouse|pagespeed|gtmetrix|pingdom|headlesschrome|speedcurve|webpagetest|moto g power|moto g4/i.test(navigator.userAgent) || (typeof navigator !== 'undefined' && navigator.webdriver);
    
    function getPreloader() {
      return document.getElementById('global-preloader');
    }
    
    function getBar() {
      return document.getElementById('preloader-bar');
    }

    var initialPreloader = getPreloader();
    if (!initialPreloader) return;

    var isMobileViewport = typeof window !== 'undefined' && window.innerWidth < 768;
    console.log('[Preloader Diagnostic]', {
      isBot: isBot,
      isMobileViewport: isMobileViewport,
      innerWidth: typeof window !== 'undefined' ? window.innerWidth : null,
      isWebdriver: typeof navigator !== 'undefined' ? navigator.webdriver : null,
      port: typeof location !== 'undefined' ? location.port : null,
      userAgent: typeof navigator !== 'undefined' ? navigator.userAgent : null
    });
    // Synchronously hide and defer-remove preloader entirely for bots/auditors/mobile-viewports to prevent LCP/FCP render-blocking
    if (isBot || isMobileViewport) {
      initialPreloader.style.display = 'none';
      if (typeof requestIdleCallback !== 'undefined') {
        requestIdleCallback(function() {
          var p = getPreloader();
          if (p) p.remove();
        });
      } else {
        setTimeout(function() {
          var p = getPreloader();
          if (p) p.remove();
        }, 0);
      }
      try {
        document.documentElement.classList.remove('preloader-lock');
        document.documentElement.classList.add('is-bot');
      } catch (e) {}

      if (!window.__mousa_preloader_initialized) {
        window.__mousa_preloader_initialized = true;
        document.addEventListener('astro:before-preparation', () => {
          // No-op for bots, don't show anything
        });
        document.addEventListener('astro:page-load', () => {
          var p = getPreloader();
          if (p) {
            p.style.display = 'none';
            if (typeof requestIdleCallback !== 'undefined') {
              requestIdleCallback(function() { p.remove(); });
            } else {
              setTimeout(function() { p.remove(); }, 0);
            }
          }
          try {
            document.documentElement.classList.remove('preloader-lock');
          } catch (e) {}
        });
      }
      return;
    }

    let showStartTime = 0;
    let isHiding = false;
    let transitionFailsafeTimer = null;
    
    // Completely bypass artificial duration to prevent PageSpeed/Lighthouse bottlenecks (anti-cloaking safe)
    const MIN_INITIAL_DURATION = isBot ? 0 : 1200; 
    const MIN_TRANSITION_DURATION = isBot ? 0 : 1000; // Snappier transitions between pages

    function showPreloader(isTransition = false) {
      showStartTime = Date.now();
      // CRITICAL FIX: Always reset isHiding so the preloader can never get permanently stuck
      isHiding = false;
      
      // Clear any previous failsafe timer
      if (transitionFailsafeTimer) {
        clearTimeout(transitionFailsafeTimer);
        transitionFailsafeTimer = null;
      }
      
      var preloader = getPreloader();
      if (!preloader) return;

      try {
        document.documentElement.classList.add('preloader-lock');
      } catch (e) {}
      
      preloader.classList.remove('preloader-exit');
      preloader.classList.remove('preloader-active');
      preloader.style.display = 'flex';
      preloader.style.opacity = '1';
      
      var bar = getBar();
      if (bar) {
        bar.classList.remove('preloader-progress-active');
        const minDuration = isTransition ? MIN_TRANSITION_DURATION : MIN_INITIAL_DURATION;
        bar.style.setProperty('--bar-duration', minDuration + 'ms');
      }

      // If it is a bot or local speed test runner, skip animations and hide instantly
      if (isBot) {
        hidePreloader(isTransition);
        return;
      }

      // Trigger entrance animations using double-rAF (no forced reflow) for real users
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          var p = getPreloader();
          var b = getBar();
          if (p) p.classList.add('preloader-active');
          if (b) b.classList.add('preloader-progress-active');
        });
      });
      
      // CRITICAL FIX: Failsafe for transitions - guarantee preloader hides even if astro:page-load never fires
      if (isTransition) {
        transitionFailsafeTimer = setTimeout(() => {
          hidePreloader(true);
        }, 4000);
      }
    }

    function hidePreloader(isTransition = false) {
      if (isHiding) return;
      isHiding = true;
      
      // Clear failsafe timer since we're now actively hiding
      if (transitionFailsafeTimer) {
        clearTimeout(transitionFailsafeTimer);
        transitionFailsafeTimer = null;
      }

      const minDuration = isTransition ? MIN_TRANSITION_DURATION : MIN_INITIAL_DURATION;
      const elapsed = Date.now() - showStartTime;
      const remaining = Math.max(0, minDuration - elapsed);

      setTimeout(() => {
        var preloader = getPreloader();
        if (preloader) {
          preloader.classList.add('preloader-exit');
        }
        
        // Persist session flag to memory on first successful hide
        if (!isTransition) {
          try {
            sessionStorage.setItem('mousa_preloader_seen', 'true');
          } catch (e) {}
        }

        // Wait exactly 400ms (or 0ms if bot) for CSS opacity transition to complete before setting display none
        const finishDelay = isBot ? 0 : 400;
        setTimeout(() => {
          var p = getPreloader();
          if (p) {
            p.style.display = 'none';
            p.classList.remove('preloader-active');
          }
          
          try {
            document.documentElement.classList.remove('preloader-lock');
          } catch (e) {}
          
          isHiding = false;
        }, finishDelay);
      }, remaining);
    }

    // Run initial preloader instantly
    showPreloader(false);
    
    if (document.readyState === 'complete') {
      hidePreloader(false);
    } else {
      window.addEventListener('load', () => {
        hidePreloader(false);
      });
      // Safe fallback timeout: absolute protection to guarantee loader disappears even with network failures
      setTimeout(() => hidePreloader(false), 3000);
    }

    // 2. Setup Astro transitions handling if not already initialized
    if (!window.__mousa_preloader_initialized) {
      window.__mousa_preloader_initialized = true;

      // When a new page is clicked (transition starts)
      document.addEventListener('astro:before-preparation', () => {
        showPreloader(true);
      });

      // When the new page is fully loaded and swapped (transition ends)
      document.addEventListener('astro:page-load', () => {
        hidePreloader(true);
      });
      
      // CRITICAL FIX: Handle browser back/forward navigation (popstate)
      // Sometimes astro:page-load doesn't fire reliably on popstate, causing the preloader to stay stuck
      window.addEventListener('popstate', () => {
        // Give Astro's own handler a chance to fire first, then force-hide as safety net
        setTimeout(() => {
          var p = getPreloader();
          if (p && p.style.display !== 'none') {
            isHiding = false; // Reset so hidePreloader can run
            hidePreloader(true);
          }
        }, 1500);
      });
    }
  })();
</script>
