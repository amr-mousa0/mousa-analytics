---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
---

<!-- Premium preloader overlay with transition:persist to survive page swaps -->
<div 
  id="global-preloader" 
  transition:persist
  class="select-none" 
  aria-hidden="true"
>
  <!-- Background subtle aura glow and grid -->
  <div class="absolute inset-0 bg-[#070F1E] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.06),transparent_65%)] pointer-events-none"></div>
  <div class="absolute inset-0 opacity-[0.02] pointer-events-none" style="background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px); background-size: 3.5rem 3.5rem;"></div>

  <div class="flex flex-col items-center justify-center text-center px-6 max-w-xl relative z-10">
    
    <!-- Premium Geometric M Logo (Self-Drawing SVG) -->
    <div class="w-16 h-16 mb-8 text-white relative">
      <svg viewBox="0 0 24 24" class="w-full h-full" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <defs>
          <linearGradient id="preloader-logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="60%" stop-color="#93C5FD" />
            <stop offset="100%" stop-color="#2563EB" />
          </linearGradient>
        </defs>
        <!-- The main M path, animated with CSS stroke-dash -->
        <path 
          class="logo-path-main" 
          d="M4 18V6L11 12L18 6V18" 
          stroke="url(#preloader-logo-grad)" 
          stroke-width="2" 
        />
        <!-- Inner shadow M path -->
        <path 
          class="logo-path-shadow" 
          d="M6 16V4L13 10L20 4V16" 
          stroke="#2563EB" 
          stroke-width="1.2" 
        />
      </svg>
    </div>

    <!-- Main Branding Title with premium typography -->
    <div class="overflow-hidden mb-3">
      <h1 
        id="preloader-title"
        class="text-xl sm:text-2xl font-bold tracking-[0.35em] uppercase"
      >
        {isAr ? "موسى للتحليلات" : "MOUSA ANALYTICS"}
      </h1>
    </div>
    
    <!-- Subtitle -->
    <div class="overflow-hidden mb-8">
      <p 
        id="preloader-subtitle"
        class="text-[8px] sm:text-[9px] font-bold tracking-[0.4em] uppercase"
      >
        {isAr ? "تحليل البيانات واستراتيجيات النمو" : "DATA PIPELINES & CONVERSION INFRASTRUCTURE"}
      </p>
    </div>
    
    <!-- Thin loading bar -->
    <div 
      id="preloader-bar-container"
      class="w-40 h-[1px] bg-white/10 overflow-hidden relative"
    >
      <div 
        id="preloader-bar"
        class="absolute inset-y-0 left-0 bg-[#2563EB] w-full h-full transform -translate-x-full"
      ></div>
    </div>
  </div>
</div>

<style is:global>
  /* Fixed overlay covering the entire screen by default */
  #global-preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 1;
    /* Use opacity transition only to avoid heavy GPU full-page rasterization resizing lag */
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity;
  }

  /* SVG Path drawing animations */
  .logo-path-main {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .logo-path-shadow {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    opacity: 0;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.25, 1, 0.5, 1) 0.15s, opacity 0.8s ease 0.15s;
  }

  /* Custom typography with fallback to prevent FOIT */
  #preloader-title {
    font-family: 'Cinzel', 'Cormorant Garamond', 'Georgia', serif;
    color: #ffffff;
    transform: translateY(15px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, opacity 0.8s ease 0.3s;
  }

  #preloader-subtitle {
    font-family: 'Outfit', 'Inter', sans-serif;
    color: #2563EB; /* Premium branding blue matching key highlights */
    transform: translateY(10px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s, opacity 0.8s ease 0.45s;
  }

  #preloader-bar-container {
    opacity: 0;
    transition: opacity 0.6s ease 0.6s;
  }

  /* Active state triggers */
  .preloader-active .logo-path-main {
    stroke-dashoffset: 0;
  }
  .preloader-active .logo-path-shadow {
    stroke-dashoffset: 0;
    opacity: 0.45;
  }
  .preloader-active #preloader-title {
    transform: translateY(0);
    opacity: 1;
  }
  .preloader-active #preloader-subtitle {
    transform: translateY(0);
    opacity: 1;
  }
  .preloader-active #preloader-bar-container {
    opacity: 1;
  }

  /* Exit transition class (fade-only for extreme rendering speed) */
  .preloader-exit {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  /* Progress bar animation keyframes */
  .preloader-progress-active {
    animation: preloader-progress-bar 2.0s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes preloader-progress-bar {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(-20%); }
    100% { transform: translateX(0); }
  }
</style>

<script is:inline>
  (function() {
    // 1. Guard against search crawlers and performance tools only (NOT standard developer preview modes)
    const isBot = /bot|google|baidu|bing|msn|duckduckbot|teoma|slurp|yandex|chrome-lighthouse/i.test(navigator.userAgent);
    const preloader = document.getElementById('global-preloader');
    
    if (isBot) {
      if (preloader) preloader.style.display = 'none';
      return;
    }

    const title = document.getElementById('preloader-title');
    const subtitle = document.getElementById('preloader-subtitle');
    const barContainer = document.getElementById('preloader-bar-container');
    const bar = document.getElementById('preloader-bar');

    if (!preloader) return;

    let showStartTime = 0;
    const MIN_INITIAL_DURATION = 2400; // Hold initial preloader for 2.4s to display the premium animation and typography
    const MIN_TRANSITION_DURATION = 1300; // Hold page transitions for 1.3s for satisfyingly smooth visual pacing

    function showPreloader(isTransition = false) {
      showStartTime = Date.now();
      preloader.classList.remove('preloader-exit');
      preloader.classList.remove('preloader-active');
      preloader.style.display = 'flex';
      preloader.style.opacity = '1';
      
      if (bar) {
        bar.classList.remove('preloader-progress-active');
      }

      // Force layout reflow
      preloader.offsetHeight;

      // Trigger entrance animations by adding active class
      requestAnimationFrame(() => {
        preloader.classList.add('preloader-active');
        if (bar) {
          bar.classList.add('preloader-progress-active');
        }
      });
    }

    function hidePreloader(isTransition = false) {
      const minDuration = isTransition ? MIN_TRANSITION_DURATION : MIN_INITIAL_DURATION;
      const elapsed = Date.now() - showStartTime;
      const remaining = Math.max(0, minDuration - elapsed);

      setTimeout(() => {
        preloader.classList.add('preloader-exit');

        setTimeout(() => {
          preloader.style.display = 'none';
          preloader.classList.remove('preloader-active');
        }, 550);
      }, remaining);
    }

    // Run initial preloader instantly
    showPreloader(false);
    
    if (document.readyState === 'complete') {
      hidePreloader(false);
    } else {
      window.addEventListener('load', () => {
        hidePreloader(false);
      });
      // Safe fallback timeout: absolute protection to guarantee loader disappears even with network failures
      setTimeout(() => hidePreloader(false), 3000);
    }

    // 2. Setup Astro transitions handling if not already initialized
    if (!window.__mousa_preloader_initialized) {
      window.__mousa_preloader_initialized = true;

      // When a new page is clicked (transition starts)
      document.addEventListener('astro:before-preparation', () => {
        showPreloader(true);
      });

      // When the new page is fully loaded and swapped (transition ends)
      document.addEventListener('astro:page-load', () => {
        hidePreloader(true);
      });
    }
  })();
</script>
