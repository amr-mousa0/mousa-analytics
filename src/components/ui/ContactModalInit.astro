---
import { useTranslations } from '../../lib/locales/index';
import { siteConfig } from '../../lib/config/site.config';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const whatsappNumber = siteConfig.public.whatsappNumber;
---

<script is:inline define:vars={{ whatsappNumber, tMsg: t.nav.contactModal }}>
  (() => {
    let container = null;
    let backdrop = null;
    let sheet = null;
    let closeBtn = null;
    let submitBtn = null;
    let industryInput = null;
    let detailsInput = null;

    let selectedService = tMsg.services && tMsg.services[0] ? tMsg.services[0].label : '';
    let selectedTimeline = tMsg.timelines && tMsg.timelines[0] ? tMsg.timelines[0].label : '';
    let previousOverflow = '';
    let previousFocusedElement = null;

    const initModal = () => {
      container = document.getElementById('contact-modal-container');
      backdrop = document.getElementById('contact-modal-backdrop');
      sheet = document.getElementById('contact-modal-sheet');
      closeBtn = document.getElementById('contact-modal-close-btn');
      submitBtn = document.getElementById('contact-modal-submit-btn');
      industryInput = document.getElementById('contact-industry-input');
      detailsInput = document.getElementById('contact-details-input');

      if (!container || !sheet) return;

      // Ensure initial closed state on load
      container.classList.add('hidden', 'opacity-0', 'pointer-events-none');
      sheet.classList.add('translate-y-full');

      // Pill click delegation - Service
      const servicePills = document.querySelectorAll('.service-pill');
      servicePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          servicePills.forEach((p) => {
            p.className = 'service-pill px-4 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 cursor-pointer border select-none bg-bg-secondary border-border-subtle text-text-primary hover:border-border-strong';
          });
          pill.className = 'service-pill px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all duration-200 cursor-pointer border-2 border-primary text-primary bg-bg-card shadow-xs select-none';
          selectedService = pill.getAttribute('data-service-label') || pill.textContent.trim();
        });
      });

      // Pill click delegation - Timeline
      const timelinePills = document.querySelectorAll('.timeline-pill');
      timelinePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          timelinePills.forEach((p) => {
            p.className = 'timeline-pill px-4 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 cursor-pointer border select-none bg-bg-secondary border-border-subtle text-text-primary hover:border-border-strong';
          });
          pill.className = 'timeline-pill px-4 py-2.5 rounded-2xl text-sm font-semibold transition-all duration-200 cursor-pointer border-2 border-primary text-primary bg-bg-primary shadow-xs select-none';
          selectedTimeline = pill.getAttribute('data-timeline-label') || pill.textContent.trim();
        });
      });

      // Close events
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);

      // Submit WhatsApp event
      if (submitBtn) submitBtn.addEventListener('click', handleSubmit);

      // Key handlers (Escape & Focus trap)
      document.addEventListener('keydown', (e) => {
        if (container && !container.classList.contains('hidden')) {
          if (e.key === 'Escape') {
            closeModal();
          } else if (e.key === 'Tab') {
            handleFocusTrap(e);
          }
        }
      });

      // Global open triggers (mobile viewports only)
      document.querySelectorAll('[data-open-contact-modal]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          if (!window.matchMedia('(min-width: 768px)').matches) {
            e.preventDefault();
            openModal(trigger);
          }
        });
      });

      // Global event listener
      window.addEventListener('open-contact-modal', () => {
        if (!window.matchMedia('(min-width: 768px)').matches) {
          openModal(null);
        }
      });
    };

    const openModal = (triggerElement) => {
      if (!container || !sheet) return;
      previousFocusedElement = triggerElement || document.activeElement;

      // Lock body scroll safely
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';

      container.classList.remove('hidden');
      requestAnimationFrame(() => {
        container.classList.remove('opacity-0', 'pointer-events-none');
        sheet.classList.remove('translate-y-full');
      });

      // Focus close button initially for accessibility
      setTimeout(() => {
        if (closeBtn) closeBtn.focus();
      }, 100);
    };

    const closeModal = () => {
      if (!container || !sheet) return;

      sheet.classList.add('translate-y-full');
      container.classList.add('opacity-0', 'pointer-events-none');

      setTimeout(() => {
        container.classList.add('hidden');
        // Restore previous overflow safely
        document.body.style.overflow = previousOverflow;

        // Restore focus to trigger element
        if (previousFocusedElement && typeof previousFocusedElement.focus === 'function') {
          previousFocusedElement.focus();
        }
      }, 300);
    };

    const handleFocusTrap = (e) => {
      if (!container) return;
      const focusables = container.querySelectorAll('button, input, textarea, a, [tabindex]:not([tabindex="-1"])');
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const handleSubmit = () => {
      const industryVal = industryInput ? industryInput.value.trim() : '';
      const detailsVal = detailsInput ? detailsInput.value.trim() : '';

      const greeting = tMsg.greeting || 'السلام عليكم،';
      const sLabel = tMsg.msgServiceLabel || 'الخدمة:';
      const iLabel = tMsg.msgIndustryLabel || 'المجال:';
      const dLabel = tMsg.msgDetailsLabel || 'وصف المشروع:';
      const tLabel = tMsg.msgTimelineLabel || 'المدة المطلوبة:';
      const thanks = tMsg.msgThanks || 'شكراً.';

      const formattedMsg = `${greeting}\n\n${sLabel} ${selectedService}\n${iLabel} ${industryVal || '-'}\n${dLabel}\n${detailsVal || '-'}\n\n${tLabel} ${selectedTimeline}\n\n${thanks}`;

      const encodedText = encodeURIComponent(formattedMsg);
      const url = `https://wa.me/${whatsappNumber}?text=${encodedText}`;

      window.open(url, '_blank', 'noopener,noreferrer');

      // Reset form fields
      if (industryInput) industryInput.value = '';
      if (detailsInput) detailsInput.value = '';

      closeModal();
    };

    // Defer binding until the page has finished loading so this hidden modal
    // never competes with the critical rendering path. Idle-time init keeps
    // behavior identical: the modal is closed by default and the preloader
    // overlays the page until the load event, so no user interaction is lost.
    const scheduleInit = () => {
      const run = () => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(initModal, { timeout: 2500 });
        } else {
          setTimeout(initModal, 2500);
        }
      };
      if (document.readyState === 'complete') {
        run();
      } else {
        window.addEventListener('load', run, { once: true });
      }
    };
    scheduleInit();

    document.addEventListener('astro:after-swap', initModal);
  })();
</script>