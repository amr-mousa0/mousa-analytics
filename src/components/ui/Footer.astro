---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

// Links
const aboutPath = `/${lang}/about/`;
const privacyPath = `/${lang}/privacy/`;
const termsPath = `/${lang}/terms/`;
---

<footer id="footer" class="footer-luxury text-start text-white relative z-10" role="contentinfo">
  
  <!-- Subtle ambient glow matching premium theme -->
  <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-accent-primary/20 to-transparent pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-4xl mx-auto px-6 py-8 flex flex-col gap-6">
    
    <!-- Main Distributed Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- Brand & Bio Column (Spans 8 columns on desktop, aligned to start side) -->
      <div class="md:col-span-8 flex flex-col items-start gap-4">
        <!-- Elegant Emblem -->
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white p-2.5 shadow-md shadow-black/10 select-none border border-white/15 shrink-0" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-full h-full text-white" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <defs>
                <linearGradient id="logo-grad-footer" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FFFFFF" />
                  <stop offset="60%" stop-color="#93C5FD" />
                  <stop offset="100%" stop-color="#2563EB" />
                </linearGradient>
              </defs>
              <path d="M4 18V6L11 12L18 6V18" stroke="url(#logo-grad-footer)" stroke-width="2" />
              <path d="M6 16V4L13 10L20 4V16" stroke="#2563EB" class="opacity-45" stroke-width="1.2" />
              <path d="M4 6L6 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M11 12L13 10" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M18 6L20 4" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M4 18L6 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
              <path d="M18 18L20 16" stroke="currentColor" class="opacity-30" stroke-dasharray="1 1.5" stroke-width="1" />
            </svg>
          </span>
          <span class="font-serif text-base font-bold text-white tracking-tight">
            {isAr ? "موسى" : "Mousa"} <span class="text-hero-accent italic font-medium">{isAr ? "للتحليلات" : "Analytics"}</span>
          </span>
        </div>

        <!-- Specialized Bio Statement -->
        <p class="text-white/70 text-xs font-sans leading-relaxed max-w-lg font-light text-start">
          {isAr 
            ? "محلل بيانات ومسوق رقمي متخصص في تحويل الأرقام إلى استراتيجيات نمو قابلة للقياس." 
            : "Data Analyst & Digital Marketer turning numbers into measurable growth strategies."}
        </p>
      </div>

      <!-- Quick Contact Column (Spans 4 columns on desktop, aligned to end side) -->
      <div class="md:col-span-4 flex flex-col items-start md:items-end gap-3.5 w-full">
        <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/60 font-sans">
          {isAr ? "قنوات الاتصال المباشر" : "Direct Connect"}
        </h4>
        
        <!-- Circular Call & WhatsApp Primary CTAs -->
        <div class="flex items-center gap-3">
          <!-- Call Button -->
          <a 
            href="tel:+201017749925" 
            class="flex items-center justify-center w-10 h-10 rounded-full bg-white/5 border border-white/10 text-white hover:bg-white/10 hover:border-white/20 transition-all duration-300 active:scale-90 shrink-0"
            aria-label={isAr ? "اتصال هاتفي" : "Call now"}
            title={isAr ? "اتصل بي" : "Call me"}
          >
            <i class="fa-solid fa-phone text-xs"></i>
          </a>

          <!-- WhatsApp Button -->
          <a 
            href="https://wa.me/201017749925" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-center w-10 h-10 rounded-full bg-[#16A34A]/10 border border-[#16A34A]/30 text-[#16A34A] hover:bg-[#16A34A]/20 hover:border-[#16A34A]/40 transition-all duration-300 active:scale-90 shrink-0"
            aria-label={isAr ? "محادثة واتس اب" : "WhatsApp now"}
            title={isAr ? "محادثة واتس اب" : "WhatsApp me"}
          >
            <i class="fa-brands fa-whatsapp text-base"></i>
          </a>
        </div>

        <!-- Sleek About Me Action Button (Underneath the circular buttons) -->
        <a 
          href={aboutPath} 
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-white/10 bg-white/5 hover:bg-white/10 text-white/90 hover:text-white text-[11px] font-semibold shadow-sm transition-all duration-300 active:scale-95 cursor-pointer hover:border-white/25 shrink-0 mt-1"
        >
          <i class="fa-solid fa-user text-[9px]"></i>
          <span>{isAr ? "من أنا؟" : "About Me"}</span>
        </a>
      </div>

    </div>

    <!-- Divider -->
    <hr class="border-white/5 mt-2" />

    <!-- BOTTOM SECTION: Copyright & Navigation links aligned cleanly -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-3 py-1 text-[10px] text-white/60 font-sans font-light">
      <!-- Copyright right aligned -->
      <div class="text-center md:text-start order-2 md:order-1">
        © {new Date().getFullYear()} {isAr ? "عمرو موسى للتحليلات. جميع الحقوق محفوظة." : "Mousa Analytics. All rights reserved."}
      </div>

      <!-- Standard links left aligned -->
      <div class="flex items-center justify-center gap-5 order-1 md:order-2">
        <a href={privacyPath} class="hover:text-white transition-colors duration-200">{isAr ? "سياسة الخصوصية" : "Privacy Policy"}</a>
        <a href={termsPath} class="hover:text-white transition-colors duration-200">{isAr ? "الشروط والأحكام" : "Terms of Service"}</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-luxury {
    background-color: #0A192F; /* Premium navy brand background */
    margin-block-start: auto;
    position: relative;
    overflow: hidden;
  }
</style>
