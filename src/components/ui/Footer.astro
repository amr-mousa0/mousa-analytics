---
import { getSafeSocials } from '../../scripts/socialsHelper';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

const socials = await getSafeSocials(lang);
---

<footer class="w-full bg-primary-bg border-t border-text-main/8 py-12 mt-auto">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Left Copyright -->
    <div class="text-text-main/50 text-sm text-center md:text-start font-sans">
      © {new Date().getFullYear()} {isAr ? "عمرو موسى. جميع الحقوق محفوظة." : "Amr Mousa. All rights reserved."}
    </div>

    <!-- Right Socials links -->
    {socials.length > 0 && (
      <div class="flex items-center gap-6">
        {socials.map(social => (
          <a href={social.data.url} target="_blank" rel="noopener noreferrer" class="text-text-main/60 hover:text-accent-primary transition-colors text-lg focus-visible:ring-2" aria-label={social.data.name}>
            <i class={social.data.icon}></i>
          </a>
        ))}
      </div>
    )}

  </div>
</footer>
